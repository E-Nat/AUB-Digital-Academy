# ========================================================
# AUB Digital Academy — Docker Environment Variables Template
# Copy this file to .env and configure your local credentials
# ========================================================

# Microsoft SQL Server 2022 SA Password (Minimum 8 chars, uppercase, lowercase, numbers/symbols)
MSSQL_SA_PASSWORD=YourStrongPasswordHere!

# Telegram Bot API Configuration (@AUBLinkBot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_MESSAGE_THREAD_ID=

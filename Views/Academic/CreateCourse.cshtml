@model AUBDigitalAcademy.Models.ViewModels.CourseCreateViewModel
@{
    ViewData["Title"] = "Add New Course";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="admin-page-header">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/Admin/Courses" class="text-decoration-none">Course Management</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Add New Course</li>
                </ol>
            </nav>
            <h1 class="admin-page-title">Add New Course</h1>
            <p class="admin-page-subtitle">Configure curriculum metadata, assigned teacher, academic placement, and visibility.</p>
        </div>
        <div>
            <a href="/Admin/Courses" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Courses</span>
            </a>
        </div>
    </div>

    <!-- Main Creation Form Card -->
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="course-table-card p-4 shadow-sm">
                <form asp-controller="Academic" asp-action="CreateCourse" method="post" id="createCourseForm" novalidate>
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-4" role="alert"></div>

                    <!-- 1. Basic Information -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>1. Basic Information</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Title" class="form-label small fw-bold text-secondary mb-1">
                                    Course Title <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Full-Stack Web Development" required />
                                <span asp-validation-for="Title" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Code" class="form-label small fw-bold text-secondary mb-1">
                                    Course Code <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Code" class="form-control text-uppercase font-monospace" placeholder="e.g. CS-WD101" maxlength="20" required />
                                <span asp-validation-for="Code" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label small fw-bold text-secondary mb-1">
                                    Description <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief summary of topics covered in this course..."></textarea>
                                <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Academic Placement -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-building text-primary"></i>
                            <span>2. Academic Placement</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label small fw-bold text-secondary mb-1">
                                    Category <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="form-select">
                                    <option value="">Select Category...</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MajorId" class="form-label small fw-bold text-secondary mb-1">
                                    Major <span class="text-danger">*</span>
                                </label>
                                <select asp-for="MajorId" asp-items="Model.MajorOptions" class="form-select" required>
                                    <option value="" disabled selected>Select Major...</option>
                                </select>
                                <span asp-validation-for="MajorId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SemesterId" class="form-label small fw-bold text-secondary mb-1">
                                    Semester <span class="text-danger">*</span>
                                </label>
                                <select asp-for="SemesterId" asp-items="Model.SemesterOptions" class="form-select" required>
                                    <option value="" disabled selected>Select Semester...</option>
                                </select>
                                <span asp-validation-for="SemesterId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TeacherId" class="form-label small fw-bold text-secondary mb-1">
                                    Assigned Instructor (Teacher) <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TeacherId" asp-items="Model.TeacherOptions" class="form-select" required>
                                    <option value="" disabled selected>Select Assigned Instructor...</option>
                                </select>
                                <span asp-validation-for="TeacherId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Cover Image & Status -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-image text-primary"></i>
                            <span>3. Media & Initial Visibility</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="Thumbnail" class="form-label small fw-bold text-secondary mb-1">
                                    Cover Image URL / Path <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <input asp-for="Thumbnail" class="form-control" placeholder="assets/images/course_webdev.jpg or /uploads/..." />
                                <small class="text-muted">Leave empty to use automatic subject gradient.</small>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Status" class="form-label small fw-bold text-secondary mb-1">
                                    Status
                                </label>
                                <select asp-for="Status" asp-items="Html.GetEnumSelectList<AUBDigitalAcademy.Models.Enums.CourseStatus>()" class="form-select"></select>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <input type="hidden" name="submitAction" id="createCourseSubmitAction" value="publish" />
                        <a href="/Admin/Courses" class="btn btn-outline-secondary px-3 py-2 fw-medium">
                            Cancel
                        </a>
                        <button type="submit" class="btn btn-outline-primary px-3 py-2 fw-medium" onclick="document.getElementById('createCourseSubmitAction').value='draft';">
                            <i class="bi bi-file-earmark me-1"></i> Save as Draft
                        </button>
                        <button type="submit" class="btn btn-primary-aub px-4 py-2 fw-medium" onclick="document.getElementById('createCourseSubmitAction').value='publish';">
                            <i class="bi bi-check2-circle me-1"></i> Publish Course
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

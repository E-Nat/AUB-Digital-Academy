@{
    ViewData["Title"] = "Academic Structure";
    ViewData["ActivePage"] = "Academic";
}

<div class="container-fluid py-4 px-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb" class="mb-1">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none">Dashboard</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Academic Structure</li>
                </ol>
            </nav>
            <h1 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-mortarboard-fill text-primary me-2"></i>Academic Structure
            </h1>
            <p class="text-muted text-sm mb-0">Institutional curricula, academic terms, faculties, and course catalog.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/Academic/Course" class="btn btn-primary rounded-pill px-3 py-2 text-sm">
                <i class="bi bi-journal-text me-1"></i> Course Management
            </a>
        </div>
    </div>

    <!-- Quick Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 48px; height: 48px; font-size: 20px;">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs text-uppercase fw-semibold">Total Courses</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalCourses</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-indigo bg-opacity-10 text-indigo" style="width: 48px; height: 48px; font-size: 20px; background-color: #EEF2FF; color: #4F46E5;">
                        <i class="bi bi-layers-half"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs text-uppercase fw-semibold">Sections &amp; Chapters</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalChapters</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success" style="width: 48px; height: 48px; font-size: 20px;">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs text-uppercase fw-semibold">Active Term</div>
                        <div class="fs-6 fw-bold text-dark text-truncate" style="max-width: 140px;" title="@ViewBag.CurrentSemesterName">@ViewBag.CurrentSemesterName</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning-emphasis" style="width: 48px; height: 48px; font-size: 20px;">
                        <i class="bi bi-diagram-2"></i>
                    </div>
                    <div>
                        <div class="text-muted text-xs text-uppercase fw-semibold">Programs / Majors</div>
                        <div class="fs-4 fw-bold text-dark">@ViewBag.TotalMajors</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4 Pillars of Academic Structure -->
    <div class="row g-4">
        <!-- Pillar 1: Course Management (Active) -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 44px; height: 44px; font-size: 20px;">
                        <i class="bi bi-journal-text"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1 text-xs">
                        <i class="bi bi-check-circle-fill me-1"></i>Active &amp; Operational
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Course Management</h5>
                <p class="text-muted text-sm flex-grow-1">
                    Create, edit, archive, and publish university courses. Manage course codes, assigned lead faculty, major affiliations, credit allocations, and enrolled students.
                </p>
                <div class="pt-3 border-top mt-auto">
                    <a href="/Academic/Course" class="btn btn-primary rounded-pill px-4">
                        Open Course Catalog <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Pillar 2: Sections & Chapters (Curriculum Context Active) -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-indigo bg-opacity-10 text-indigo" style="width: 44px; height: 44px; font-size: 20px; background-color: #EEF2FF; color: #4F46E5;">
                        <i class="bi bi-layers-half"></i>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1 text-xs">
                        <i class="bi bi-diagram-3 me-1"></i>Per-Course Builder
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Sections &amp; Chapters</h5>
                <p class="text-muted text-sm flex-grow-1">
                    Interactive curriculum builder managing weekly modules, instructional units, and learning materials. Author chapters, assign lessons, attach lecture slides, and configure quizzes within course contexts.
                </p>
                <div class="pt-3 border-top mt-auto">
                    <a href="/Academic/Course" class="btn btn-outline-primary rounded-pill px-4">
                        Manage via Courses <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Pillar 3: Categories & Majors (Pending Step 4) -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column opacity-75">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning-emphasis" style="width: 44px; height: 44px; font-size: 20px;">
                        <i class="bi bi-diagram-2"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 text-xs">
                        <i class="bi bi-clock me-1"></i>Pending Implementation
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Categories &amp; Majors</h5>
                <p class="text-muted text-sm flex-grow-1">
                    Master academic program hierarchy, department classifications, degree tracks, and faculty specializations. Standalone administrative CRUD interface is scheduled for Step 4.
                </p>
                <div class="pt-3 border-top mt-auto">
                    <button type="button" class="btn btn-light border rounded-pill px-4 text-muted" disabled title="Scheduled for Step 4">
                        <i class="bi bi-lock me-1"></i>Configuration Module Pending
                    </button>
                </div>
            </div>
        </div>

        <!-- Pillar 4: Academic Semesters (Pending Step 4) -->
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column opacity-75">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-secondary bg-opacity-10 text-secondary" style="width: 44px; height: 44px; font-size: 20px;">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-3 py-1 text-xs">
                        <i class="bi bi-clock me-1"></i>Pending Implementation
                    </span>
                </div>
                <h5 class="fw-bold text-dark mb-2">Academic Semesters</h5>
                <p class="text-muted text-sm flex-grow-1">
                    Institutional term calendar, registration periods, start/end dates, and active semester switching. Standalone semester configuration interface is scheduled for Step 4.
                </p>
                <div class="pt-3 border-top mt-auto">
                    <button type="button" class="btn btn-light border rounded-pill px-4 text-muted" disabled title="Scheduled for Step 4">
                        <i class="bi bi-lock me-1"></i>Configuration Module Pending
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

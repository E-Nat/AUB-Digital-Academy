@model AUBDigitalAcademy.Models.ViewModels.CourseManagementViewModel
@inject AUBDigitalAcademy.Services.Interfaces.IHtmlSanitizationService HtmlSanitizer
@{
    ViewData["Title"] = "Course Management";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Page Header -->
    <div class="admin-page-header">
        <div>
            <h1 class="admin-page-title">Course Management</h1>
            <p class="admin-page-subtitle">Manage specialized courses, curriculum, syllabus modules, and course catalogs.</p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a href="/Academic/Category" class="btn btn-outline-secondary btn-sm">Categories</a>
                <a href="/Academic/Major" class="btn btn-outline-secondary btn-sm">Majors</a>
                <a href="/Academic/Semester" class="btn btn-outline-secondary btn-sm">Semesters</a>
            }
            <button class="btn btn-primary-aub d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#createCourseModal" type="button" id="openAddCourseModalBtn">
                <i class="bi bi-plus-lg"></i>
                <span>Add New Course</span>
            </button>
        </div>
    </div>

    <!-- KPI Summary Cards -->
    <div class="admin-kpi-grid mb-4">
        <div class="kpi-card">
            <div class="kpi-icon-wrap" style="background:#EFF6FF;color:#2563EB;">
                <i class="bi bi-journal-bookmark-fill"></i>
            </div>
            <div class="kpi-info">
                <span class="kpi-label">Total Courses</span>
                <div class="kpi-value">@Model.TotalCourses</div>
                <span class="kpi-subtext">Active academic catalog</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap" style="background:#ECFDF5;color:#059669;">
                <i class="bi bi-check-circle-fill"></i>
            </div>
            <div class="kpi-info">
                <span class="kpi-label">Published Courses</span>
                <div class="kpi-value">@Model.PublishedCourses</div>
                <span class="kpi-subtext">Available for enrollment</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap" style="background:#F5F3FF;color:#7C3AED;">
                <i class="bi bi-collection-fill"></i>
            </div>
            <div class="kpi-info">
                <span class="kpi-label">Curriculum Modules</span>
                <div class="kpi-value">@Model.TotalModules</div>
                <span class="kpi-subtext">Structured syllabus units</span>
            </div>
        </div>

        <div class="kpi-card">
            <div class="kpi-icon-wrap" style="background:#FFFBEB;color:#D97706;">
                <i class="bi bi-play-btn-fill"></i>
            </div>
            <div class="kpi-info">
                <span class="kpi-label">Total Lessons</span>
                <div class="kpi-value">@Model.TotalLessons</div>
                <span class="kpi-subtext">Videos, articles & labs</span>
            </div>
        </div>
    </div>

    <!-- Main Course Table Card -->
    <div class="course-table-card">
        <!-- Segment Tabs -->
        <div class="course-segment-tabs">
            <button class="course-segment-tab active" data-filter="all" type="button">
                All Courses <span class="tab-count">@Model.TotalCourses</span>
            </button>
            <button class="course-segment-tab" data-filter="published" type="button">
                Published <span class="tab-count">@Model.PublishedCourses</span>
            </button>
            <button class="course-segment-tab" data-filter="draft" type="button">
                Drafts <span class="tab-count">@Model.DraftCourses</span>
            </button>
            <button class="course-segment-tab" data-filter="archived" type="button">
                Archived <span class="tab-count">@Model.ArchivedCourses</span>
            </button>
        </div>

        <!-- Filter Bar -->
        <div class="course-filter-bar">
            <div class="course-search-box">
                <i class="bi bi-search"></i>
                <input type="text" class="form-control course-search-input" id="courseSearchInput" placeholder="Search courses by title, code, major, instructor...">
            </div>
            <select class="form-select course-filter-select" id="courseCategoryFilter" aria-label="Filter by Category">
                <option value="">All Categories</option>
                @foreach (var cat in Model.CreateModel.CategoryOptions)
                {
                    <option value="@cat.Text">@cat.Text</option>
                }
            </select>
        </div>

        <!-- Course Table -->
        <div class="table-responsive">
            <table class="table align-middle mb-0" id="coursesTable">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3" style="width: 28%;">Course</th>
                        <th style="width: 18%;">Major / Category</th>
                        <th style="width: 14%;">Semester</th>
                        <th style="width: 18%;">Instructor</th>
                        <th class="text-center" style="width: 10%;">Curriculum</th>
                        <th style="width: 8%;">Status</th>
                        <th class="text-end pe-3" style="width: 4%;">Actions</th>
                    </tr>
                </thead>
                <tbody id="courseTableBody">
                    @if (Model.Courses != null && Model.Courses.Any())
                    {
                        @foreach (var course in Model.Courses)
                        {
                            var statusClass = course.Status.ToString().ToLowerInvariant();
                            <tr class="course-row" data-status="@statusClass" data-title="@(course.Title ?? "").ToLowerInvariant()" data-code="@(course.Code ?? "").ToLowerInvariant()" data-major="@(course.Major?.Name?.ToLowerInvariant() ?? "")" data-category="@(course.Major?.Category?.Name?.ToLowerInvariant() ?? "")">
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @{
                                            var safeThumbnail = HtmlSanitizer.SanitizeResourceUrl(course.Thumbnail);
                                        }
                                        @if (!string.IsNullOrEmpty(safeThumbnail))
                                        {
                                            <img src="@safeThumbnail" alt="@course.Title" class="course-thumb-preview" onerror="this.style.display='none';if(this.nextElementSibling)this.nextElementSibling.style.display='flex';" />
                                            <div class="course-thumb-placeholder" style="display:none;">
                                                <i class="bi bi-book-half"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="course-thumb-placeholder">
                                                <i class="bi bi-book-half"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-bold text-dark mb-0.5">@course.Title</div>
                                            <span class="course-code-badge">@course.Code</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark small">@(course.Major?.Name ?? "General")</div>
                                    <small class="text-muted">@(course.Major?.Category?.Name ?? "Academic")</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark small">@(course.Semester?.Name ?? "N/A")</div>
                                    <small class="text-muted">@(course.Semester?.Code ?? "")</small>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white bg-primary fw-bold" style="width:28px;height:28px;font-size:0.75rem;">
                                            @((!string.IsNullOrEmpty(course.Teacher?.FullName) ? course.Teacher.FullName.Substring(0, 1) : "T"))
                                        </div>
                                        <div>
                                            <div class="fw-medium text-dark small">@(course.Teacher?.FullName ?? "Unassigned")</div>
                                            <small class="text-muted">@(course.Teacher?.UniversityId ?? course.Teacher?.Email ?? "")</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <a href="@Url.Action("Curriculum", "Academic", new { id = course.Id })" class="badge bg-light text-dark border text-decoration-none shadow-sm" title="Manage Curriculum">
                                        <i class="bi bi-diagram-3 me-1 text-primary"></i>@(course.Chapters?.Count ?? 0) Modules
                                    </a>
                                </td>
                                <td>
                                    <span class="badge-course-status @statusClass">
                                        <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i>
                                        @course.Status
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        <a href="@Url.Action("CourseStudents", "Enrollment", new { courseId = course.Id })" class="btn btn-sm btn-outline-info p-1" title="View Enrolled Students (@(course.Enrollments?.Count ?? 0))">
                                            <i class="bi bi-people"></i>
                                        </a>
                                        <a href="@Url.Action("Curriculum", "Academic", new { id = course.Id })" class="btn btn-sm btn-outline-primary p-1" title="Manage Curriculum">
                                            <i class="bi bi-diagram-3"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-warning p-1 manage-ta-btn"
                                                data-id="@course.Id"
                                                data-title="@course.Title"
                                                data-code="@course.Code"
                                                data-teacher="@(course.Teacher?.FullName ?? "Instructor")"
                                                title="Manage Teaching Assistants">
                                            <i class="bi bi-person-gear"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary p-1 edit-course-btn"
                                                data-id="@course.Id"
                                                data-title="@course.Title"
                                                data-code="@course.Code"
                                                data-desc="@course.Description"
                                                data-category="@(course.Major?.CategoryId ?? 0)"
                                                data-major="@course.MajorId"
                                                data-semester="@course.SemesterId"
                                                data-teacher="@course.TeacherId"
                                                data-thumbnail="@course.Thumbnail"
                                                data-status="@((int)course.Status)"
                                                title="Edit Course">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger p-1 delete-course-btn"
                                                data-id="@course.Id"
                                                data-title="@course.Title"
                                                data-code="@course.Code"
                                                title="Delete Course">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }

                        <tr id="noMatchingCoursesRow" style="display:none;">
                            <td colspan="7" class="p-5 text-center text-muted">
                                <i class="bi bi-search fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                <h6 class="fw-bold text-dark mb-1">No courses found</h6>
                                <p class="text-muted small mb-0">No courses match your search or filter criteria.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="p-5 text-center text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-3 text-secondary opacity-50"></i>
                                <h5 class="fw-bold text-dark mb-1">No courses found</h5>
                                <p class="text-muted small mb-3">Create your first academic course to start building your catalog.</p>
                                <button class="btn btn-primary-aub btn-sm" data-bs-toggle="modal" data-bs-target="#createCourseModal" type="button">
                                    <i class="bi bi-plus-lg me-1"></i> Add New Course
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- 1. ADD NEW COURSE MODAL                                      -->
<!-- ============================================================ -->
<div class="modal fade" id="createCourseModal" tabindex="-1" aria-labelledby="createCourseModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-course-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="createCourseModalTitle">Add New Course</h5>
                    <small class="text-muted">Create and configure a new course in the academic catalog.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Academic" asp-action="CreateCourse" method="post" id="createCourseForm" novalidate>
                @Html.AntiForgeryToken()

                <div class="modal-body p-4" style="max-height: calc(85vh - 140px); overflow-y: auto;">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- 1. Basic Information -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>Basic Information</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="CreateModel.Title" class="form-label small fw-bold text-secondary mb-1">
                                    Course Title <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CreateModel.Title" class="form-control" placeholder="e.g. Full-Stack Web Development" required />
                                <span asp-validation-for="CreateModel.Title" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CreateModel.Code" class="form-label small fw-bold text-secondary mb-1">
                                    Course Code <span class="text-danger">*</span>
                                </label>
                                <input asp-for="CreateModel.Code" class="form-control text-uppercase font-monospace" placeholder="e.g. CS-WD101" maxlength="20" required />
                                <span asp-validation-for="CreateModel.Code" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="CreateModel.Description" class="form-label small fw-bold text-secondary mb-1">
                                    Description <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <textarea asp-for="CreateModel.Description" class="form-control" rows="2" placeholder="Brief summary of topics covered in this course..."></textarea>
                                <span asp-validation-for="CreateModel.Description" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Academic Placement -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-building text-primary"></i>
                            <span>Academic Placement</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CreateModel.CategoryId" class="form-label small fw-bold text-secondary mb-1">
                                    Category <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <select asp-for="CreateModel.CategoryId" asp-items="Model.CreateModel.CategoryOptions" class="form-select" id="createCourseCategoryId">
                                    <option value="">Select Category...</option>
                                </select>
                                <span asp-validation-for="CreateModel.CategoryId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreateModel.MajorId" class="form-label small fw-bold text-secondary mb-1">
                                    Major <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CreateModel.MajorId" asp-items="Model.CreateModel.MajorOptions" class="form-select" required>
                                    <option value="" disabled>Select Major...</option>
                                </select>
                                <span asp-validation-for="CreateModel.MajorId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreateModel.SemesterId" class="form-label small fw-bold text-secondary mb-1">
                                    Semester <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CreateModel.SemesterId" asp-items="Model.CreateModel.SemesterOptions" class="form-select" required>
                                    <option value="" disabled>Select Semester...</option>
                                </select>
                                <span asp-validation-for="CreateModel.SemesterId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CreateModel.TeacherId" class="form-label small fw-bold text-secondary mb-1">
                                    Assigned Instructor (Teacher) <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CreateModel.TeacherId" asp-items="Model.CreateModel.TeacherOptions" class="form-select" required>
                                    <option value="" disabled>Select Assigned Instructor...</option>
                                </select>
                                <span asp-validation-for="CreateModel.TeacherId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Cover Image & Status -->
                    <div class="mb-2">
                        <div class="modal-section-title">
                            <i class="bi bi-image text-primary"></i>
                            <span>Media & Initial Visibility</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="CreateModel.Thumbnail" class="form-label small fw-bold text-secondary mb-1">
                                    Cover Image URL / Path <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <input asp-for="CreateModel.Thumbnail" class="form-control" placeholder="assets/images/course_webdev.jpg or /uploads/..." />
                                <small class="text-muted">Leave empty to use automatic subject gradient.</small>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="CreateModel.Status" class="form-label small fw-bold text-secondary mb-1">
                                    Status
                                </label>
                                <select asp-for="CreateModel.Status" asp-items="Html.GetEnumSelectList<AUBDigitalAcademy.Models.Enums.CourseStatus>()" class="form-select"></select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <input type="hidden" name="submitAction" id="createCourseSubmitAction" value="publish" />
                    <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-medium" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-outline-primary px-3 py-2 fw-medium" onclick="document.getElementById('createCourseSubmitAction').value='draft';">
                        <i class="bi bi-file-earmark me-1"></i> Save as Draft
                    </button>
                    <button type="submit" class="btn btn-primary-aub px-4 py-2 fw-medium" onclick="document.getElementById('createCourseSubmitAction').value='publish';">
                        <i class="bi bi-check2-circle me-1"></i> Publish Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- 2. EDIT COURSE MODAL                                         -->
<!-- ============================================================ -->
<div class="modal fade" id="editCourseModal" tabindex="-1" aria-labelledby="editCourseModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-course-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="editCourseModalTitle">Edit Course</h5>
                    <small class="text-muted">Update course curriculum details, academic placement, or status.</small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Academic" asp-action="EditCourse" method="post" id="editCourseForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EditModel.Id" id="editCourseId" />

                <div class="modal-body p-4" style="max-height: calc(85vh - 140px); overflow-y: auto;">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- 1. Basic Information -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-info-circle text-primary"></i>
                            <span>Basic Information</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="EditModel.Title" class="form-label small fw-bold text-secondary mb-1">
                                    Course Title <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EditModel.Title" id="editCourseTitle" class="form-control" placeholder="e.g. Full-Stack Web Development" required />
                                <span asp-validation-for="EditModel.Title" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="EditModel.Code" class="form-label small fw-bold text-secondary mb-1">
                                    Course Code <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EditModel.Code" id="editCourseCode" class="form-control text-uppercase font-monospace" placeholder="e.g. CS-WD101" maxlength="20" required />
                                <span asp-validation-for="EditModel.Code" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="EditModel.Description" class="form-label small fw-bold text-secondary mb-1">
                                    Description <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <textarea asp-for="EditModel.Description" id="editCourseDescription" class="form-control" rows="2" placeholder="Brief summary of topics covered in this course..."></textarea>
                                <span asp-validation-for="EditModel.Description" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Academic Placement -->
                    <div class="mb-4">
                        <div class="modal-section-title">
                            <i class="bi bi-building text-primary"></i>
                            <span>Academic Placement</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="EditModel.CategoryId" class="form-label small fw-bold text-secondary mb-1">
                                    Category <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <select asp-for="EditModel.CategoryId" id="editCourseCategoryId" asp-items="Model.EditModel.CategoryOptions" class="form-select">
                                    <option value="">Select Category...</option>
                                </select>
                                <span asp-validation-for="EditModel.CategoryId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EditModel.MajorId" class="form-label small fw-bold text-secondary mb-1">
                                    Major <span class="text-danger">*</span>
                                </label>
                                <select asp-for="EditModel.MajorId" id="editCourseMajorId" asp-items="Model.EditModel.MajorOptions" class="form-select" required>
                                    <option value="" disabled>Select Major...</option>
                                </select>
                                <span asp-validation-for="EditModel.MajorId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EditModel.SemesterId" class="form-label small fw-bold text-secondary mb-1">
                                    Semester <span class="text-danger">*</span>
                                </label>
                                <select asp-for="EditModel.SemesterId" id="editCourseSemesterId" asp-items="Model.EditModel.SemesterOptions" class="form-select" required>
                                    <option value="" disabled>Select Semester...</option>
                                </select>
                                <span asp-validation-for="EditModel.SemesterId" class="text-danger small d-block mt-1"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EditModel.TeacherId" class="form-label small fw-bold text-secondary mb-1">
                                    Assigned Instructor (Teacher) <span class="text-danger">*</span>
                                </label>
                                <select asp-for="EditModel.TeacherId" id="editCourseTeacherId" asp-items="Model.EditModel.TeacherOptions" class="form-select" required>
                                    <option value="" disabled>Select Assigned Instructor...</option>
                                </select>
                                <span asp-validation-for="EditModel.TeacherId" class="text-danger small d-block mt-1"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Cover Image & Status -->
                    <div class="mb-2">
                        <div class="modal-section-title">
                            <i class="bi bi-image text-primary"></i>
                            <span>Media & Visibility Status</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-8">
                                <label asp-for="EditModel.Thumbnail" class="form-label small fw-bold text-secondary mb-1">
                                    Cover Image URL / Path <span class="text-muted fw-normal">(Optional)</span>
                                </label>
                                <input asp-for="EditModel.Thumbnail" id="editCourseThumbnail" class="form-control" placeholder="assets/images/course_webdev.jpg or /uploads/..." />
                                <small class="text-muted">Leave empty to use automatic subject gradient.</small>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="EditModel.Status" class="form-label small fw-bold text-secondary mb-1">
                                    Status
                                </label>
                                <select asp-for="EditModel.Status" id="editCourseStatus" asp-items="Html.GetEnumSelectList<AUBDigitalAcademy.Models.Enums.CourseStatus>()" class="form-select"></select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-medium" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary-aub px-4 py-2 fw-medium" id="btnSaveCourseChanges">
                        <i class="bi bi-check2-circle me-1"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- 3. DELETE COURSE CONFIRMATION MODAL                          -->
<!-- ============================================================ -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-labelledby="deleteCourseModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-course-header d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-danger-subtle p-2 text-danger d-flex align-items-center justify-content-center" style="width:38px;height:38px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="deleteCourseModalTitle">Delete Course?</h5>
                        <small class="text-muted">Permanent deletion confirmation</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Academic" asp-action="DeleteCourse" method="post" id="deleteCourseForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="deleteCourseId" value="" />

                <div class="modal-body p-4">
                    <p class="mb-2 text-secondary">
                        Are you sure you want to delete:
                    </p>
                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="fw-bold text-dark fs-6" id="deleteCourseTitleDisplay">Course Title</div>
                        <span class="course-code-badge mt-1" id="deleteCourseCodeDisplay">CODE</span>
                    </div>

                    <div class="alert alert-warning py-2 px-3 small d-flex align-items-start gap-2 mb-0" role="alert">
                        <i class="bi bi-info-circle-fill text-warning fs-5 flex-shrink-0"></i>
                        <span>This action may remove course curriculum data. Courses with enrolled students or submitted learning activity cannot be deleted.</span>
                    </div>

                    <div id="deleteModalError" class="alert alert-danger py-2 px-3 small mt-3 d-none" role="alert">
                        <i class="bi bi-x-circle-fill me-1"></i>
                        <span id="deleteModalErrorText"></span>
                    </div>
                </div>

                <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-end gap-2 border-top">
                    <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-medium" data-bs-dismiss="modal" id="cancelDeleteCourseBtn">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-medium d-inline-flex align-items-center gap-1" id="confirmDeleteCourseBtn">
                        <i class="bi bi-trash me-1"></i>
                        <span>Delete Course</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 4. MANAGE TEACHING ASSISTANTS MODAL (MODULE F)     -->
<div class="modal fade" id="manageAssistantsModal" tabindex="-1" aria-labelledby="manageAssistantsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-course-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="modal-title fw-bold text-dark mb-0" id="manageAssistantsModalTitle">Teaching Assistants</h5>
                    <p class="modal-course-subtitle mb-0" id="manageAssistantsSubtitle">Manage assistants for course</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Course Primary Teacher Context -->
                <div class="d-flex align-items-center justify-content-between p-3 rounded-3 bg-light border mb-4">
                    <div>
                        <span class="text-xs text-uppercase fw-bold text-muted d-block">Primary Instructor</span>
                        <span class="fw-bold text-dark" id="taModalTeacherName">Instructor</span>
                    </div>
                    <span class="badge bg-primary rounded-pill px-3 py-1 text-xs">Course Owner</span>
                </div>

                <!-- Alert Message Box -->
                <div id="taModalAlert" class="alert py-2 px-3 small d-none mb-3" role="alert">
                    <span id="taModalAlertText"></span>
                </div>

                <!-- Currently Assigned Assistants Table -->
                <h6 class="fw-bold text-dark mb-2 d-flex align-items-center justify-content-between">
                    <span>Assigned Teaching Assistants</span>
                    <span class="badge bg-secondary rounded-pill px-2" id="taCountBadge">0</span>
                </h6>
                <div class="table-responsive border rounded-3 mb-4">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Assistant</th>
                                <th>University ID</th>
                                <th>Can Grade?</th>
                                <th class="pe-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody id="assignedAssistantsTableBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">Loading assistants...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Assign New Assistant Form -->
                <div class="card border rounded-3 bg-light p-3">
                    <h6 class="fw-bold text-dark mb-1">Assign New Teaching Assistant</h6>
                    <p class="text-xs text-muted mb-3">Newly assigned assistants default to <strong>CanGrade = false</strong> per institutional policy.</p>
                    <div class="row g-2 align-items-end">
                        <div class="col-md-8">
                            <label for="newAssistantSelect" class="form-label text-xs fw-semibold text-muted mb-1">SELECT ASSISTANT</label>
                            <select id="newAssistantSelect" class="form-select form-select-sm">
                                <option value="">Select an available assistant...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="button" class="btn btn-primary-aub btn-sm w-100 d-inline-flex align-items-center justify-content-center gap-1" id="btnConfirmAssignTA">
                                <i class="bi bi-person-plus-fill"></i>
                                <span>Assign Assistant</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-end border-top">
                <button type="button" class="btn btn-outline-secondary px-3 py-2 fw-medium" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Auto open Create modal if create validation failed
            @if (ViewBag.OpenCreateModal == true)
            {
                <text>
                var createModalEl = document.getElementById('createCourseModal');
                if (createModalEl) {
                    var modal = new bootstrap.Modal(createModalEl);
                    modal.show();
                }
                </text>
            }

            // Auto open Edit modal if edit validation failed
            @if (ViewBag.OpenEditModal == true)
            {
                <text>
                var editModalEl = document.getElementById('editCourseModal');
                if (editModalEl) {
                    var modal = new bootstrap.Modal(editModalEl);
                    modal.show();
                }
                </text>
            }

            // Edit button click handlers - load Course by ID from server & populate Edit Modal
            var editButtons = document.querySelectorAll('.edit-course-btn');
            editButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    if (!id) return;

                    // Fetch fresh course data by ID from SQL Server via AcademicController.GetCourseJson
                    fetch('/Academic/GetCourseJson?id=' + encodeURIComponent(id), {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function (response) {
                        if (!response.ok) throw new Error('Network response was not ok');
                        return response.json();
                    })
                    .then(function (data) {
                        if (data && data.success && data.course) {
                            var c = data.course;
                            document.getElementById('editCourseId').value = c.id;
                            document.getElementById('editCourseTitle').value = c.title || '';
                            document.getElementById('editCourseCode').value = c.code || '';
                            document.getElementById('editCourseDescription').value = c.description || '';
                            document.getElementById('editCourseThumbnail').value = c.thumbnail || '';

                            var catEl = document.getElementById('editCourseCategoryId');
                            if (catEl) catEl.value = (c.categoryId && c.categoryId > 0) ? String(c.categoryId) : '';

                            var majorEl = document.getElementById('editCourseMajorId');
                            if (majorEl && c.majorId) majorEl.value = String(c.majorId);

                            var semEl = document.getElementById('editCourseSemesterId');
                            if (semEl && c.semesterId) semEl.value = String(c.semesterId);

                            var teacherEl = document.getElementById('editCourseTeacherId');
                            if (teacherEl && c.teacherId) teacherEl.value = String(c.teacherId);

                            var statusEl = document.getElementById('editCourseStatus');
                            if (statusEl) statusEl.value = String(c.status);

                            var editModalEl = document.getElementById('editCourseModal');
                            if (editModalEl) {
                                var modal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
                                modal.show();
                            }
                        }
                    })
                    .catch(function (err) {
                        console.warn('Could not fetch course by ID, falling back to data attributes:', err);
                        // Fallback to data attributes if fetch fails
                        var fallbackId = btn.getAttribute('data-id');
                        document.getElementById('editCourseId').value = fallbackId;
                        document.getElementById('editCourseTitle').value = btn.getAttribute('data-title') || '';
                        document.getElementById('editCourseCode').value = btn.getAttribute('data-code') || '';
                        document.getElementById('editCourseDescription').value = btn.getAttribute('data-desc') || '';
                        document.getElementById('editCourseThumbnail').value = btn.getAttribute('data-thumbnail') || '';

                        var catId = btn.getAttribute('data-category');
                        var majorId = btn.getAttribute('data-major');
                        var semesterId = btn.getAttribute('data-semester');
                        var teacherId = btn.getAttribute('data-teacher');
                        var status = btn.getAttribute('data-status') || '0';

                        var catEl = document.getElementById('editCourseCategoryId');
                        if (catEl) catEl.value = (catId && catId !== '0') ? catId : '';

                        if (majorId) document.getElementById('editCourseMajorId').value = majorId;
                        if (semesterId) document.getElementById('editCourseSemesterId').value = semesterId;
                        if (teacherId) document.getElementById('editCourseTeacherId').value = teacherId;
                        if (status) document.getElementById('editCourseStatus').value = status;

                        var editModalEl = document.getElementById('editCourseModal');
                        if (editModalEl) {
                            var modal = bootstrap.Modal.getInstance(editModalEl) || new bootstrap.Modal(editModalEl);
                            modal.show();
                        }
                    });
                });
            });

            // Delete Course Modal & Form Handler
            var deleteButtons = document.querySelectorAll('.delete-course-btn');
            var deleteModalEl = document.getElementById('deleteCourseModal');
            var deleteModal = deleteModalEl ? new bootstrap.Modal(deleteModalEl) : null;

            deleteButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.getAttribute('data-id');
                    var title = this.getAttribute('data-title') || 'Selected Course';
                    var code = this.getAttribute('data-code') || '';

                    var idInput = document.getElementById('deleteCourseId');
                    var titleDisplay = document.getElementById('deleteCourseTitleDisplay');
                    var codeDisplay = document.getElementById('deleteCourseCodeDisplay');

                    if (idInput) idInput.value = id;
                    if (titleDisplay) titleDisplay.textContent = title;
                    if (codeDisplay) codeDisplay.textContent = code;

                    var errBox = document.getElementById('deleteModalError');
                    if (errBox) errBox.classList.add('d-none');

                    if (deleteModal) {
                        deleteModal.show();
                    }
                });
            });

            var deleteForm = document.getElementById('deleteCourseForm');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    var submitBtn = document.getElementById('confirmDeleteCourseBtn');
                    var originalBtnHtml = submitBtn ? submitBtn.innerHTML : '';
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Deleting...';
                    }

                    var errBox = document.getElementById('deleteModalError');
                    var errText = document.getElementById('deleteModalErrorText');
                    if (errBox) errBox.classList.add('d-none');

                    var formData = new FormData(deleteForm);

                    fetch(deleteForm.action || '/Academic/DeleteCourse', {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(function (response) {
                        return response.json().catch(function () {
                            throw new Error('Server returned an unexpected response.');
                        });
                    })
                    .then(function (data) {
                        if (data.success) {
                            if (deleteModal) deleteModal.hide();
                            window.location.reload();
                        } else {
                            if (submitBtn) {
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalBtnHtml;
                            }
                            if (errBox && errText) {
                                errText.textContent = data.message || 'This course cannot be deleted.';
                                errBox.classList.remove('d-none');
                            }
                        }
                    })
                    .catch(function (error) {
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML = originalBtnHtml;
                        }
                        if (errBox && errText) {
                            errText.textContent = error.message || 'An error occurred while deleting the course.';
                            errBox.classList.remove('d-none');
                        }
                    });
                });
            }

            // Real-time table search & filtering
            const searchInput = document.getElementById('courseSearchInput');
            const categoryFilter = document.getElementById('courseCategoryFilter');
            const segmentTabs = document.querySelectorAll('.course-segment-tab');
            const rows = document.querySelectorAll('#courseTableBody .course-row');
            const noMatchRow = document.getElementById('noMatchingCoursesRow');

            let currentFilter = 'all';

            function filterTable() {
                const searchVal = (searchInput ? searchInput.value : '').toLowerCase().trim();
                const catVal = (categoryFilter ? categoryFilter.value : '').toLowerCase().trim();
                let visibleCount = 0;

                rows.forEach(row => {
                    const rowStatus = row.getAttribute('data-status') || '';
                    const rowTitle = row.getAttribute('data-title') || '';
                    const rowCode = row.getAttribute('data-code') || '';
                    const rowMajor = row.getAttribute('data-major') || '';
                    const rowCategory = row.getAttribute('data-category') || '';

                    const matchesStatus = (currentFilter === 'all' || rowStatus === currentFilter);
                    const matchesCategory = (!catVal || rowCategory.includes(catVal) || rowMajor.includes(catVal));
                    const matchesSearch = (!searchVal || rowTitle.includes(searchVal) || rowCode.includes(searchVal) || rowMajor.includes(searchVal) || rowCategory.includes(searchVal));

                    if (matchesStatus && matchesCategory && matchesSearch) {
                        row.style.display = '';
                        visibleCount++;
                    } else {
                        row.style.display = 'none';
                    }
                });

                if (noMatchRow) {
                    noMatchRow.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
                }
            }

            if (searchInput) {
                searchInput.addEventListener('input', filterTable);
            }

            if (categoryFilter) {
                categoryFilter.addEventListener('change', filterTable);
            }

            segmentTabs.forEach(tab => {
                tab.addEventListener('click', function () {
                    segmentTabs.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    currentFilter = this.getAttribute('data-filter') || 'all';
                    filterTable();
                });
            });

            // =========================================================================
            // TEACHING ASSISTANTS MANAGEMENT (MODULE F)
            // =========================================================================
            var taModalEl = document.getElementById('manageAssistantsModal');
            var taModal = taModalEl ? new bootstrap.Modal(taModalEl) : null;
            var currentTaCourseId = 0;

            function showTaAlert(msg, isSuccess) {
                var alertBox = document.getElementById('taModalAlert');
                var alertText = document.getElementById('taModalAlertText');
                if (alertBox && alertText) {
                    alertBox.className = 'alert py-2 px-3 small mb-3 ' + (isSuccess ? 'alert-success' : 'alert-danger');
                    alertText.textContent = msg;
                    alertBox.classList.remove('d-none');
                }
            }

            function hideTaAlert() {
                var alertBox = document.getElementById('taModalAlert');
                if (alertBox) alertBox.classList.add('d-none');
            }

            function renderTaStatusRow(tableBody, text, showSpinner) {
                if (!tableBody) return;
                var tr = document.createElement('tr');
                var td = document.createElement('td');
                td.colSpan = 4;
                td.className = 'text-center text-muted py-3' + (showSpinner ? '' : ' fst-italic');
                if (showSpinner) {
                    var spinner = document.createElement('span');
                    spinner.className = 'spinner-border spinner-border-sm me-1';
                    td.appendChild(spinner);
                }
                td.appendChild(document.createTextNode(text));
                tr.appendChild(td);
                tableBody.replaceChildren(tr);
            }

            function createAssistantRow(courseId, asst) {
                var tr = document.createElement('tr');

                // Column 1: Assistant Name + Email (strictly textContent, never innerHTML)
                var tdInfo = document.createElement('td');
                tdInfo.className = 'ps-3';
                var nameDiv = document.createElement('div');
                nameDiv.className = 'fw-bold text-dark';
                nameDiv.textContent = asst.name || '';
                var emailDiv = document.createElement('div');
                emailDiv.className = 'text-muted text-xs';
                emailDiv.textContent = asst.email || '';
                tdInfo.appendChild(nameDiv);
                tdInfo.appendChild(emailDiv);
                tr.appendChild(tdInfo);

                // Column 2: University ID
                var tdUni = document.createElement('td');
                var uniBadge = document.createElement('span');
                uniBadge.className = 'badge bg-light text-dark border font-monospace';
                uniBadge.textContent = asst.universityId || 'N/A';
                tdUni.appendChild(uniBadge);
                tr.appendChild(tdUni);

                // Column 3: CanGrade switch
                var tdSwitch = document.createElement('td');
                var switchWrap = document.createElement('div');
                switchWrap.className = 'form-check form-switch m-0';

                var swInput = document.createElement('input');
                swInput.className = 'form-check-input toggle-can-grade-switch';
                swInput.type = 'checkbox';
                swInput.checked = Boolean(asst.canGrade);
                swInput.style.cursor = 'pointer';
                swInput.setAttribute('data-course-id', String(courseId));
                swInput.setAttribute('data-assistant-id', String(asst.assistantId || ''));

                var swLabel = document.createElement('label');
                swLabel.className = 'form-check-label text-xs ' + (asst.canGrade ? 'text-success fw-bold' : 'text-muted');
                swLabel.textContent = asst.canGrade ? 'Authorized' : 'Disabled';

                switchWrap.appendChild(swInput);
                switchWrap.appendChild(swLabel);
                tdSwitch.appendChild(switchWrap);
                tr.appendChild(tdSwitch);

                // Column 4: Unassign action
                var tdAction = document.createElement('td');
                tdAction.className = 'pe-3 text-end';
                var unassignBtn = document.createElement('button');
                unassignBtn.type = 'button';
                unassignBtn.className = 'btn btn-sm btn-outline-danger p-1 unassign-ta-btn';
                unassignBtn.title = 'Unassign Assistant';
                unassignBtn.setAttribute('aria-label', 'Unassign Assistant');
                unassignBtn.setAttribute('data-course-id', String(courseId));
                unassignBtn.setAttribute('data-assistant-id', String(asst.assistantId || ''));
                var icon = document.createElement('i');
                icon.className = 'bi bi-person-x';
                unassignBtn.appendChild(icon);
                tdAction.appendChild(unassignBtn);
                tr.appendChild(tdAction);

                return tr;
            }

            function loadCourseAssistants(courseId) {
                hideTaAlert();
                var tableBody = document.getElementById('assignedAssistantsTableBody');
                var selectEl = document.getElementById('newAssistantSelect');
                var countBadge = document.getElementById('taCountBadge');

                renderTaStatusRow(tableBody, 'Loading assistants...', true);

                fetch('/Academic/GetCourseAssistantsJson?id=' + encodeURIComponent(courseId), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (!data.success) {
                        showTaAlert(data.message || 'Failed to load assistants.', false);
                        return;
                    }

                    if (countBadge) countBadge.textContent = data.assistants ? data.assistants.length : 0;

                    // Populate table using safe DOM element APIs (no HTML concatenation)
                    if (tableBody) {
                        if (!data.assistants || data.assistants.length === 0) {
                            renderTaStatusRow(tableBody, 'No Teaching Assistants currently assigned to this course.', false);
                        } else {
                            var fragment = document.createDocumentFragment();
                            data.assistants.forEach(function (asst) {
                                fragment.appendChild(createAssistantRow(courseId, asst));
                            });
                            tableBody.replaceChildren(fragment);

                            // Wire switches
                            tableBody.querySelectorAll('.toggle-can-grade-switch').forEach(function (sw) {
                                sw.addEventListener('change', function () {
                                    var cid = this.getAttribute('data-course-id');
                                    var aid = this.getAttribute('data-assistant-id');
                                    var checked = this.checked;
                                    var label = this.nextElementSibling;

                                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                                    var fd = new FormData();
                                    fd.append('courseId', cid);
                                    fd.append('assistantId', aid);
                                    fd.append('canGrade', checked);
                                    fd.append('__RequestVerificationToken', token);

                                    fetch('/Academic/ToggleAssistantCanGrade', {
                                        method: 'POST',
                                        body: fd,
                                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                                    })
                                    .then(function (r) { return r.json(); })
                                    .then(function (res) {
                                        if (res.success) {
                                            if (label) {
                                                label.textContent = checked ? 'Authorized' : 'Disabled';
                                                label.className = 'form-check-label text-xs ' + (checked ? 'text-success fw-bold' : 'text-muted');
                                            }
                                            showTaAlert(res.message, true);
                                        } else {
                                            sw.checked = !checked;
                                            showTaAlert(res.message || 'Failed to update grading permission.', false);
                                        }
                                    })
                                    .catch(function () {
                                        sw.checked = !checked;
                                        showTaAlert('Network error updating grading permission.', false);
                                    });
                                });
                            });

                            // Wire unassign buttons
                            tableBody.querySelectorAll('.unassign-ta-btn').forEach(function (btn) {
                                btn.addEventListener('click', function () {
                                    if (!confirm('Are you sure you want to unassign this Teaching Assistant?')) return;
                                    var cid = this.getAttribute('data-course-id');
                                    var aid = this.getAttribute('data-assistant-id');
                                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                                    var fd = new FormData();
                                    fd.append('courseId', cid);
                                    fd.append('assistantId', aid);
                                    fd.append('__RequestVerificationToken', token);

                                    fetch('/Academic/UnassignCourseAssistant', {
                                        method: 'POST',
                                        body: fd,
                                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                                    })
                                    .then(function (r) { return r.json(); })
                                    .then(function (res) {
                                        if (res.success) {
                                            showTaAlert(res.message, true);
                                            loadCourseAssistants(cid);
                                        } else {
                                            showTaAlert(res.message || 'Failed to unassign assistant.', false);
                                        }
                                    })
                                    .catch(function () {
                                        showTaAlert('Network error unassigning assistant.', false);
                                    });
                                });
                            });
                        }
                    }

                    // Populate available candidate select
                    if (selectEl) {
                        selectEl.innerHTML = '<option value="">Select an available assistant...</option>';
                        if (data.availableCandidates && data.availableCandidates.length > 0) {
                            data.availableCandidates.forEach(function (c) {
                                var opt = document.createElement('option');
                                opt.value = c.id;
                                opt.textContent = c.name + ' (' + (c.universityId || c.email) + ')';
                                selectEl.appendChild(opt);
                            });
                        }
                    }
                })
                .catch(function (err) {
                    showTaAlert('Failed to load assistants: ' + err.message, false);
                });
            }

            // Wire manage-ta-btn clicks on table rows
            document.querySelectorAll('.manage-ta-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    currentTaCourseId = parseInt(this.getAttribute('data-id'), 10);
                    var title = this.getAttribute('data-title') || '';
                    var code = this.getAttribute('data-code') || '';
                    var teacher = this.getAttribute('data-teacher') || '';

                    var modalTitle = document.getElementById('manageAssistantsModalTitle');
                    var modalSub = document.getElementById('manageAssistantsSubtitle');
                    var teacherNameEl = document.getElementById('taModalTeacherName');

                    if (modalTitle) modalTitle.textContent = 'Teaching Assistants: ' + code;
                    if (modalSub) modalSub.textContent = title;
                    if (teacherNameEl) teacherNameEl.textContent = teacher;

                    if (taModal) taModal.show();
                    loadCourseAssistants(currentTaCourseId);
                });
            });

            // Wire assign assistant button in modal
            var btnAssignTA = document.getElementById('btnConfirmAssignTA');
            if (btnAssignTA) {
                btnAssignTA.addEventListener('click', function () {
                    var selectEl = document.getElementById('newAssistantSelect');
                    var assistantId = selectEl ? selectEl.value : '';
                    if (!assistantId || currentTaCourseId <= 0) {
                        showTaAlert('Please select an assistant from the list.', false);
                        return;
                    }

                    btnAssignTA.disabled = true;
                    var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    var fd = new FormData();
                    fd.append('courseId', currentTaCourseId);
                    fd.append('assistantId', assistantId);
                    fd.append('__RequestVerificationToken', token);

                    fetch('/Academic/AssignCourseAssistant', {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function (r) { return r.json(); })
                    .then(function (res) {
                        btnAssignTA.disabled = false;
                        if (res.success) {
                            showTaAlert(res.message, true);
                            loadCourseAssistants(currentTaCourseId);
                        } else {
                            showTaAlert(res.message || 'Failed to assign assistant.', false);
                        }
                    })
                    .catch(function (err) {
                        btnAssignTA.disabled = false;
                        showTaAlert('Network error assigning assistant: ' + err.message, false);
                    });
                });
            }
        });
    </script>
}

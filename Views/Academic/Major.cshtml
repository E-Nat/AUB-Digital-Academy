@model IEnumerable<AUBDigitalAcademy.Models.Major>
@{
    ViewData["Title"] = "Academic Majors";
    ViewData["ActivePage"] = "Academic";
    var categories = ViewBag.Categories as List<AUBDigitalAcademy.Models.Category> ?? new();
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Academic Majors</h2>
            <p class="text-muted small mb-0">Manage degree majors and their parent academic categories.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Academic/Course" class="btn btn-outline-secondary btn-sm">Courses</a>
            <a href="/Academic/Category" class="btn btn-outline-secondary btn-sm">Categories</a>
            <a href="/Academic/Semester" class="btn btn-outline-secondary btn-sm">Semesters</a>
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createMajorModal">
                <i class="bi bi-plus-lg me-1"></i> Add Major
            </button>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Code</th>
                        <th>Major Name</th>
                        <th>Category</th>
                        <th>Courses</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="ps-4"><span class="badge bg-dark font-monospace">@m.Code</span></td>
                            <td class="fw-semibold">@m.Name</td>
                            <td>@m.Category?.Name</td>
                            <td><span class="badge bg-primary-subtle text-primary rounded-pill">@m.Courses.Count</span></td>
                            <td class="text-end pe-4">
                                <button type="button" class="btn btn-sm btn-outline-primary me-1 edit-major-btn"
                                        data-id="@m.Id" data-code="@m.Code" data-name="@m.Name" data-catid="@m.CategoryId"
                                        data-bs-toggle="modal" data-bs-target="#editMajorModal">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <form asp-action="DeleteMajor" method="post" class="d-inline" onsubmit="return confirm('Delete this major?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="createMajorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="CreateMajor" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">Add Major</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Code</label>
                    <input type="text" name="code" class="form-control" maxlength="20" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" name="name" class="form-control" maxlength="100" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="categoryId" class="form-select" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Create</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editMajorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-action="EditMajor" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" id="editMajorId" name="id" />
            <div class="modal-header"><h5 class="modal-title">Edit Major</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Code</label>
                    <input type="text" id="editMajorCode" name="code" class="form-control" maxlength="20" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Name</label>
                    <input type="text" id="editMajorName" name="name" class="form-control" maxlength="100" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select id="editMajorCatId" name="categoryId" class="form-select" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.edit-major-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                document.getElementById('editMajorId').value = btn.dataset.id;
                document.getElementById('editMajorCode').value = btn.dataset.code;
                document.getElementById('editMajorName').value = btn.dataset.name;
                document.getElementById('editMajorCatId').value = btn.dataset.catid;
            });
        });
    </script>
}

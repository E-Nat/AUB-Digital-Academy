@model AUBDigitalAcademy.Models.ViewModels.QuizQuestionsViewModel
@{
    ViewData["Title"] = $"Manage Questions - {Model.QuizTitle}";
    ViewData["ActivePage"] = "Courses";
}

<div class="container-fluid py-4">
    @{
        var coursesBackUrl = User.IsInRole("Admin") ? "/Academic/Course" : "/Teacher/Courses";
    }
    <!-- Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="@coursesBackUrl" class="text-decoration-none">Courses</a></li>
            <li class="breadcrumb-item"><a href="/Academic/Curriculum/@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Quiz Questions</li>
        </ol>
    </nav>

    <!-- Quiz Header Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #002B49 0%, #004B87 100%); color: white;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                        <span class="badge bg-white text-dark font-monospace">@Model.CourseCode</span>
                        <span class="badge bg-light text-dark opacity-75">Module: @Model.ChapterTitle</span>
                        <span class="badge bg-warning text-dark"><i class="bi bi-patch-question me-1"></i>Quiz</span>
                        <span class="badge bg-light text-white bg-opacity-25"><i class="bi bi-clock me-1"></i>@Model.TimeLimitMinutes mins</span>
                        <span class="badge bg-light text-white bg-opacity-25"><i class="bi bi-award me-1"></i>Pass: @Model.PassingScore%</span>
                        @if (Model.IsPublished)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Draft</span>
                        }
                    </div>
                    <h2 class="fw-bold mb-1 text-white">@Model.QuizTitle</h2>
                    <p class="text-light opacity-75 mb-0 small">
                        Total Questions: <strong>@Model.TotalQuestions</strong> &bull; Total Points: <strong>@Model.TotalPoints</strong>
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" class="btn btn-warning text-dark fw-semibold d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                        <i class="bi bi-plus-circle-fill"></i>
                        <span>Add Question</span>
                    </button>
                    <a href="/Academic/Curriculum/@Model.CourseId" class="btn btn-light d-inline-flex align-items-center gap-2 shadow-sm text-primary fw-semibold">
                        <i class="bi bi-arrow-left"></i>
                        <span>Back to Curriculum</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Questions Container -->
    <div class="row">
        <div class="col-12">
            @if (Model.Questions.Count == 0)
            {
                <div class="card border rounded-3 p-5 bg-white shadow-sm text-center">
                    <i class="bi bi-question-diamond text-secondary opacity-50 fs-1 mb-3"></i>
                    <h4 class="fw-bold text-dark mb-2">No Questions Added Yet</h4>
                    <p class="text-muted small mb-4 mx-auto" style="max-width: 500px;">
                        This quiz currently has no multiple-choice questions. Add at least one question with answer options to enable student evaluations.
                    </p>
                    <div>
                        <button type="button" class="btn btn-primary px-4 py-2 d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#addQuestionModal">
                            <i class="bi bi-plus-lg"></i>
                            <span>Create First Question</span>
                        </button>
                    </div>
                </div>
            }
            else
            {
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="card border rounded-3 p-4 bg-white shadow-sm mb-4" id="question-card-@q.Id">
                        <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary rounded-pill px-3 py-1">
                                    Question @(i + 1)
                                </span>
                                <span class="badge bg-light text-muted border">
                                    <i class="bi bi-gem me-1 text-warning"></i>@q.Points pts
                                </span>
                                <span class="badge bg-light text-muted border">
                                    Order: @q.Order
                                </span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <button type="button" class="btn btn-sm btn-outline-danger p-1 px-2 d-inline-flex align-items-center gap-1 delete-q-btn"
                                        data-id="@q.Id"
                                        data-text="@q.Text"
                                        data-quizid="@Model.QuizId"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteQuestionModal"
                                        title="Delete Question">
                                    <i class="bi bi-trash"></i>
                                    <span>Delete</span>
                                </button>
                            </div>
                        </div>

                        <h5 class="fw-bold text-dark mb-3">@q.Text</h5>

                        <div class="row g-2">
                            @foreach (var opt in q.Options)
                            {
                                <div class="col-md-6">
                                    <div class="p-3 border rounded-3 @(opt.IsCorrect ? "bg-success bg-opacity-10 border-success" : "bg-light-subtle") d-flex align-items-center justify-content-between">
                                        <span class="fw-medium text-dark">@opt.Text</span>
                                        @if (opt.IsCorrect)
                                        {
                                            <span class="badge bg-success text-white rounded-pill px-2 py-1 small">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correct Answer
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- ==========================================
     ADD QUESTION MODAL
     ========================================== -->
<div class="modal fade" id="addQuestionModal" tabindex="-1" aria-labelledby="addQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="rounded-2 d-flex align-items-center justify-content-center text-primary" style="width:36px;height:36px;background:#EFF6FF;">
                        <i class="bi bi-question-circle-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-dark mb-0" id="addQuestionModalLabel">Add Multiple-Choice Question</h6>
                        <small class="text-muted">Target Quiz: <strong class="text-primary">@Model.QuizTitle</strong></small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Academic" asp-action="AddQuestion" method="post" id="addQuestionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="QuizId" value="@Model.QuizId" />
                <input type="hidden" name="Type" value="MultipleChoice" />

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Question Text <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Text" rows="3" placeholder="Enter your question here..." required></textarea>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Points</label>
                            <input type="number" class="form-control" name="Points" value="1.0" step="0.5" min="0.5" max="100" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-dark">Sort Order</label>
                            <input type="number" class="form-control" name="Order" value="@(Model.Questions.Count + 1)" min="1" max="1000" />
                        </div>
                    </div>

                    <h6 class="fw-bold text-dark mb-2">Answer Options <span class="text-danger">*</span></h6>
                    <p class="text-muted small mb-3">Provide answer options and select the single radio button for the correct answer.</p>

                    @for (int o = 0; o < 4; o++)
                    {
                        <div class="card border rounded-3 p-3 mb-2 bg-light-subtle">
                            <div class="d-flex align-items-center gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="correctRadioIndex" value="@o" id="radioCorrect_@o" @(o == 0 ? "checked" : "") onchange="updateCorrectFlags(this.value)" />
                                    <label class="form-check-label small fw-bold text-success" for="radioCorrect_@o">Correct</label>
                                </div>
                                <input type="hidden" name="Options[@o].IsCorrect" id="isCorrectInput_@o" value="@(o == 0 ? "true" : "false")" />
                                <div class="flex-grow-1">
                                    <input type="text" class="form-control form-control-sm" name="Options[@o].Text" placeholder="Option @(o + 1) text..." @(o < 2 ? "required" : "") />
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
                        <i class="bi bi-check-lg"></i>
                        <span>Save Question</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ==========================================
     DELETE QUESTION CONFIRMATION MODAL
     ========================================== -->
<div class="modal fade" id="deleteQuestionModal" tabindex="-1" aria-labelledby="deleteQuestionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom">
                <div class="d-flex align-items-center gap-2 text-danger">
                    <div class="rounded-2 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width:36px;height:36px;">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    </div>
                    <div>
                        <h6 class="modal-title fw-bold text-danger mb-0" id="deleteQuestionModalLabel">Delete Question</h6>
                        <small class="text-muted">Confirm deletion</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Academic" asp-action="DeleteQuestion" method="post" id="deleteQuestionForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="deleteQuestionId" name="id" value="" />
                <input type="hidden" name="quizId" value="@Model.QuizId" />

                <div class="modal-body p-4">
                    <p class="text-dark mb-2">Are you sure you want to delete this question?</p>
                    <div class="p-3 bg-light rounded-3 border mb-3">
                        <strong class="text-dark" id="deleteQuestionText"></strong>
                    </div>
                    <div class="alert alert-warning small mb-0">
                        This action will permanently remove this question and all of its answer options from the quiz.
                    </div>
                </div>

                <div class="modal-footer border-top bg-light">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                        <i class="bi bi-trash"></i>
                        <span>Delete Question</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function updateCorrectFlags(selectedIndex) {
            for (let i = 0; i < 4; i++) {
                const hiddenInput = document.getElementById('isCorrectInput_' + i);
                if (hiddenInput) {
                    hiddenInput.value = (i == selectedIndex) ? "true" : "false";
                }
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Delete Question modal setup
            document.querySelectorAll('.delete-q-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const text = this.getAttribute('data-text');
                    document.getElementById('deleteQuestionId').value = id;
                    document.getElementById('deleteQuestionText').textContent = text;
                });
            });
        });
    </script>
}

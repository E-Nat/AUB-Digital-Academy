@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add Quiz Button Click
            document.querySelectorAll('.add-quiz-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const chapterId = this.getAttribute('data-chapterid');
                    const chapterTitle = this.getAttribute('data-chaptertitle');
                    const courseId = this.getAttribute('data-courseid');
                    const nextPosition = this.getAttribute('data-nextposition');

                    document.getElementById('createQuizChapterId').value = chapterId;
                    document.getElementById('createQuizCourseId').value = courseId;
                    document.getElementById('createQuizModuleTitleBadge').textContent = chapterTitle;
                    document.getElementById('createQuizPosition').value = nextPosition;
                    document.getElementById('createQuizTitle').value = '';
                });
            });

            // Edit Quiz Button Click
            document.querySelectorAll('.edit-quiz-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const quizId = this.getAttribute('data-quizid');
                    const chapterId = this.getAttribute('data-chapterid');
                    const chapterTitle = this.getAttribute('data-chaptertitle');
                    const courseId = this.getAttribute('data-courseid');
                    const title = this.getAttribute('data-title');
                    const timeLimit = this.getAttribute('data-timelimit');
                    const passingScore = this.getAttribute('data-passingscore');
                    const isPublished = this.getAttribute('data-ispublished') === 'true';
                    const position = this.getAttribute('data-position');

                    document.getElementById('editQuizCourseItemId').value = id;
                    document.getElementById('editQuizQuizId').value = quizId;
                    document.getElementById('editQuizChapterId').value = chapterId;
                    document.getElementById('editQuizCourseId').value = courseId;
                    document.getElementById('editQuizModuleTitleBadge').textContent = chapterTitle;
                    document.getElementById('editQuizTitle').value = title;
                    document.getElementById('editQuizTimeLimit').value = timeLimit;
                    document.getElementById('editQuizPassingScore').value = passingScore;
                    document.getElementById('editQuizPosition').value = position;
                    document.getElementById('editQuizMaxAttempts').value = this.getAttribute('data-maxattempts') || 3;
                    document.getElementById('editQuizIsPublished').checked = isPublished;
                });
            });

            // Delete Quiz Button Click
            document.querySelectorAll('.delete-quiz-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const title = this.getAttribute('data-title');
                    const chapterId = this.getAttribute('data-chapterid');
                    const courseId = this.getAttribute('data-courseid');

                    document.getElementById('deleteQuizId').value = id;
                    document.getElementById('deleteQuizChapterId').value = chapterId;
                    document.getElementById('deleteQuizCourseId').value = courseId;
                    document.getElementById('deleteQuizName').textContent = title;
                });
            });

            // Add Book Button Click

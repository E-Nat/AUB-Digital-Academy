            // Helper to parse JSON or surface clear HTTP/network error without losing the modal
            async function submitLessonFormAjax(form, url, submitBtn, defaultBtnHtml, titleErrorEl, videoErrorEl, fallbackMessage) {
                const response = await fetch(url, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                const contentType = response.headers.get('content-type') || '';
                if (!response.ok) {
                    let msg = fallbackMessage;
                    if (response.status === 413) {
                        msg = 'Video file is too large (maximum 500 MB).';
                    } else if (response.status === 400 || response.status === 403) {
                        msg = 'Upload rejected (session expired or unauthorized). Please refresh the page and try again.';
                    } else if (contentType.includes('application/json')) {
                        try {
                            const errJson = await response.json();
                            if (errJson && errJson.message) msg = errJson.message;
                        } catch (_) { }
                    } else {
                        msg = `Upload failed (HTTP ${response.status}). Please try again.`;
                    }
                    (videoErrorEl || titleErrorEl).textContent = msg;
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = defaultBtnHtml;
                    return;
                }

                if (!contentType.includes('application/json')) {
                    (videoErrorEl || titleErrorEl).textContent = 'Unexpected server response. Please refresh the page and try again.';
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = defaultBtnHtml;
                    return;
                }

                const data = await response.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    const msg = data.message || fallbackMessage;
                    if (videoErrorEl && /video|mp4|webm|ogg|signature|upload|500 mb|200 mb/i.test(msg)) {
                        videoErrorEl.textContent = msg;
                    } else {
                        titleErrorEl.textContent = msg;
                    }
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = defaultBtnHtml;
                }
            }

            const MAX_VIDEO_BYTES = 500 * 1024 * 1024;

            // AJAX handling for Create Lesson Form
            const createLessonForm = document.getElementById('createLessonForm');
            if (createLessonForm) {
                createLessonForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const submitBtn = document.getElementById('submitCreateLessonBtn');
                    const titleInput = document.getElementById('createLessonTitle');
                    const titleError = document.getElementById('createLessonTitleError');
                    const videoInput = document.getElementById('createLessonVideoFile');
                    const videoError = document.getElementById('createLessonVideoUrlError');

                    titleError.textContent = '';
                    videoError.textContent = '';

                    if (!titleInput.value.trim()) {
                        titleError.textContent = 'Lesson title is required.';
                        return;
                    }

                    if (videoInput && videoInput.files && videoInput.files[0] && videoInput.files[0].size > MAX_VIDEO_BYTES) {
                        videoError.textContent = 'Video file exceeds the 500 MB maximum upload limit.';
                        return;
                    }

                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Uploading...';

                    submitLessonFormAjax(

                                document.getElementById('editLessonPosition').value = data.lesson.position;
                                document.getElementById('editLessonVideoUrl').value = data.lesson.videoUrl || '';
                                document.getElementById('editLessonContentHtml').value = data.lesson.contentHtml || '';

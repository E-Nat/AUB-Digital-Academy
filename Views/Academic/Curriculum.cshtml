@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Add Quiz Button Click
            document.querySelectorAll('.add-quiz-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const chapterId = this.getAttribute('data-chapterid');
                    const chapterTitle = this.getAttribute('data-chaptertitle');
                    const courseId = this.getAttribute('data-courseid');
                    const nextPosition = this.getAttribute('data-nextposition');

                    document.getElementById('createQuizChapterId').value = chapterId;
                    document.getElementById('createQuizCourseId').value = courseId;
                    document.getElementById('createQuizModuleTitleBadge').textContent = chapterTitle;
                    document.getElementById('createQuizPosition').value = nextPosition;
                    document.getElementById('createQuizTitle').value = '';
                });
            });

            // Edit Quiz Button Click
            document.querySelectorAll('.edit-quiz-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const quizId = this.getAttribute('data-quizid');
                    const chapterId = this.getAttribute('data-chapterid');
                    const chapterTitle = this.getAttribute('data-chaptertitle');
                    const courseId = this.getAttribute('data-courseid');
                    const title = this.getAttribute('data-title');
                    const timeLimit = this.getAttribute('data-timelimit');
                    const passingScore = this.getAttribute('data-passingscore');
                    const isPublished = this.getAttribute('data-ispublished') === 'true';
                    const position = this.getAttribute('data-position');


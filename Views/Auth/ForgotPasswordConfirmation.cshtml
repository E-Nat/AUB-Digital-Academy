@{
    ViewData["Title"] = "Password Reset Sent";
    Layout = "_AuthLayout";
}

<div class="auth-form-section text-center">
    <div class="mb-4">
        <i class="bi bi-envelope-check-fill" style="font-size: 4rem; color: var(--aub-gold);"></i>
    </div>
    <h2 class="auth-form-title">Check Your Email</h2>
    <p class="auth-form-subtitle">If an account exists with that email address, we've sent a password reset link. Please check your inbox.</p>

    <a href="@Url.Action("Login", "Auth")" class="btn btn-primary-aub mt-3">
        <i class="bi bi-arrow-left me-2"></i>Back to Login
    </a>
</div>

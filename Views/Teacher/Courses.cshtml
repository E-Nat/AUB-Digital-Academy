@model IEnumerable<AUBDigitalAcademy.Models.ViewModels.TeacherCourseItemViewModel>
@{
    ViewData["Title"] = "My Courses";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="teacher-title">My Courses</h1>
            <p class="teacher-subtitle">Courses assigned to your instruction portfolio.</p>
        </div>
    </div>

    <div class="row g-4">
        @if (Model != null && Model.Any())
        {
            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 font-semibold text-xs">
                                    @course.Code
                                </span>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 text-xs">
                                    @course.StatusDisplay
                                </span>
                            </div>
                            <h3 class="fw-bold text-dark fs-5 mb-2">@course.Title</h3>
                            <div class="text-muted text-xs mb-4">
                                <span><i class="bi bi-bookmark me-1"></i>@course.MajorName</span> • 
                                <span><i class="bi bi-calendar3 me-1"></i>@course.SemesterName</span>
                            </div>
                            <div class="row g-2 mb-4 mt-auto pt-3 border-top border-secondary border-opacity-10 text-muted text-xs">
                                <div class="col-6"><i class="bi bi-people me-1 text-primary"></i> @course.StudentCount Students</div>
                                <div class="col-6"><i class="bi bi-layers me-1 text-info"></i> @course.ModuleCount Chapters</div>
                            </div>
                            <a href="/Teacher/CourseDetails/@course.Id" class="btn btn-outline-primary w-100 rounded-pill font-semibold py-2">
                                View Details & Roster <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center p-5 bg-white rounded-4 shadow-sm border border-secondary border-opacity-10">
                <i class="bi bi-journal-x fs-1 text-muted d-block mb-3"></i>
                <h4 class="fw-bold text-dark">No Assigned Courses</h4>
                <p class="text-muted text-sm mb-0">You currently do not have any courses assigned under your teaching account.</p>
            </div>
        }
    </div>
</div>

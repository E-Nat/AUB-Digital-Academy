@model IEnumerable<AUBDigitalAcademy.Models.ViewModels.TeacherBookItemViewModel>
@{
    ViewData["Title"] = "Books & Resources";
    ViewData["ActivePage"] = "Books";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="teacher-title">Books & Learning Resources</h1>
            <p class="teacher-subtitle">Reference books and digital resource files attached to your assigned courses.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Resource Title</th>
                                <th>Course</th>
                                <th>File Format</th>
                                <th>Size</th>
                                <th class="pe-4 text-end">Resource Link</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@book.ItemTitle</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-primary">@book.CourseTitle</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-25 py-1 text-xs">@book.FileType.ToUpper()</span>
                                    </td>
                                    <td>
                                        <span class="text-muted text-xs">@(book.FileSize.HasValue ? $"{Math.Round((double)book.FileSize.Value / 1024 / 1024, 1)} MB" : "N/A")</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="@book.FileUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill px-3 font-semibold">
                                            <i class="bi bi-download me-1"></i> Access File
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-book fs-1 d-block mb-3 text-secondary"></i>
                    <h4 class="fw-bold text-dark">No Resources Found</h4>
                    <p class="text-secondary text-sm mb-0">No book or reference files attached to your courses yet.</p>
                </div>
            }
        </div>
    </div>
</div>

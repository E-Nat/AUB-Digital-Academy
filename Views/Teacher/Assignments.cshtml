@model IEnumerable<AUBDigitalAcademy.Models.ViewModels.TeacherAssignmentItemViewModel>
@{
    ViewData["Title"] = "Course Assignments";
    ViewData["ActivePage"] = "Assignments";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="teacher-title">Course Assignments</h1>
            <p class="teacher-subtitle">Assignments created across your assigned teaching courses.</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Assignment Title</th>
                                <th>Course</th>
                                <th>Due Date</th>
                                <th>Max Score</th>
                                <th>Submissions</th>
                                <th>Status</th>
                                <th class="pe-4 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@item.Title</div>
                                        <small class="text-muted text-xs">@item.Instruction</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-25 py-1 text-xs">@item.CourseCode</span>
                                        <div class="text-muted text-xs mt-1">@item.CourseTitle</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@item.DueDate.ToString("MMM dd, yyyy · HH:mm")</div>
                                        @if (item.IsPastDue)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger text-xs">Past Due</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success text-xs">Active</span>
                                        }
                                    </td>
                                    <td><span class="fw-semibold text-dark">@item.MaxScore</span> pts</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-bold text-dark">@item.TotalSubmissions</span> total
                                            @if (item.PendingSubmissions > 0)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">@item.PendingSubmissions Pending</span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <small class="text-muted">@item.GradedSubmissions / @item.TotalSubmissions Graded</small>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="/Teacher/Submissions?assignmentId=@item.Id" class="btn btn-sm btn-primary rounded-pill px-3 font-semibold">
                                            <i class="bi bi-pencil-square me-1"></i> Review Submissions
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-file-earmark-x fs-1 d-block mb-3 text-secondary"></i>
                    <h4 class="fw-bold text-dark">No Assignments Found</h4>
                    <p class="text-secondary text-sm mb-0">No course assignments have been created for your courses yet.</p>
                </div>
            }
        </div>
    </div>
</div>

@model AUBDigitalAcademy.Models.ViewModels.TeacherCourseDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Code} - Details";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <div class="mb-4">
        <a href="/Teacher/Courses" class="text-decoration-none text-muted text-xs mb-2 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i> Back to My Courses
        </a>
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div>
                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 font-semibold text-xs mb-2 me-2">@Model.Code</span>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 text-xs mb-2">@Model.Status</span>
                <h1 class="teacher-title fs-3 mb-1">@Model.Title</h1>
                <p class="teacher-subtitle">@Model.MajorName • @Model.SemesterName</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                {
                    <a href="/Academic/Curriculum/@Model.Id" class="btn btn-outline-secondary rounded-pill px-3 py-2 text-xs font-semibold">
                        <i class="bi bi-diagram-3 me-1"></i> Manage Curriculum
                    </a>
                }
                <a href="/Teacher/Assignments?courseId=@Model.Id" class="btn btn-outline-primary rounded-pill px-3 py-2 text-xs font-semibold">
                    <i class="bi bi-file-earmark-text me-1"></i> Course Assignments
                </a>
                <a href="/Teacher/Grades?courseId=@Model.Id" class="btn btn-primary rounded-pill px-3 py-2 text-xs font-semibold">
                    <i class="bi bi-clipboard-data me-1"></i> Course Grades
                </a>
            </div>
        </div>
    </div>

    <!-- Quick Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 border border-secondary border-opacity-10 text-center shadow-sm">
                <div class="fs-4 fw-bold text-primary">@Model.StudentCount</div>
                <div class="text-muted text-xs">Enrolled Students</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 border border-secondary border-opacity-10 text-center shadow-sm">
                <div class="fs-4 fw-bold text-info">@Model.ChapterCount</div>
                <div class="text-muted text-xs">Curriculum Chapters</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 border border-secondary border-opacity-10 text-center shadow-sm">
                <div class="fs-4 fw-bold text-warning">@Model.AssignmentCount</div>
                <div class="text-muted text-xs">Assignments</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-3 bg-white rounded-3 border border-secondary border-opacity-10 text-center shadow-sm">
                <div class="fs-4 fw-bold text-success">@Model.QuizCount</div>
                <div class="text-muted text-xs">Quizzes</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Curriculum Overview -->
        <div class="col-12 col-lg-6">
            <div class="bg-white rounded-4 p-4 shadow-sm border border-secondary border-opacity-10 h-100">
                <h3 class="fw-bold fs-5 text-dark mb-3">Curriculum Structure</h3>
                @if (Model.Chapters != null && Model.Chapters.Any())
                {
                    <div class="accordion" id="curriculumAccordion">
                        @foreach (var ch in Model.Chapters)
                        {
                            <div class="accordion-item mb-2 border rounded-3 overflow-hidden">
                                <h2 class="accordion-header" id="heading_@ch.Id">
                                    <button class="accordion-button collapsed py-3 text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapse_@ch.Id">
                                        <i class="bi bi-folder-fill me-2 text-primary"></i> Chapter @ch.Position: @ch.Title (@ch.ItemCount items)
                                    </button>
                                </h2>
                                <div id="collapse_@ch.Id" class="accordion-collapse collapse" data-bs-parent="#curriculumAccordion">
                                    <div class="accordion-body p-3 bg-light">
                                        @if (ch.Items != null && ch.Items.Any())
                                        {
                                            <ul class="list-group list-group-flush rounded-3">
                                                @foreach (var item in ch.Items)
                                                {
                                                    <li class="list-group-item d-flex justify-content-between align-items-center py-2 px-3 text-xs">
                                                        <span>
                                                            <i class="bi @(item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Lesson ? "bi-play-circle text-primary" : item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Quiz ? "bi-patch-question text-info" : item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Assignment ? "bi-pencil-square text-warning" : "bi-book text-secondary") me-2"></i>
                                                            @item.Title
                                                        </span>
                                                        <span class="badge bg-secondary bg-opacity-10 text-secondary text-xs">@item.TypeDisplay</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                        else
                                        {
                                            <small class="text-muted">No items in this chapter.</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted text-sm">No chapters created for this course yet.</p>
                }
            </div>
        </div>

        <!-- Student Roster -->
        <div class="col-12 col-lg-6">
            <div class="bg-white rounded-4 p-4 shadow-sm border border-secondary border-opacity-10 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="fw-bold fs-5 text-dark mb-0">Enrolled Student Roster</h3>
                    <span class="badge bg-primary rounded-pill">@Model.StudentCount Students</span>
                </div>
                @if (Model.EnrolledStudents != null && Model.EnrolledStudents.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle text-xs">
                            <thead class="table-light">
                                <tr>
                                    <th>Student</th>
                                    <th>University ID</th>
                                    <th>Email</th>
                                    <th>Enrolled Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var st in Model.EnrolledStudents)
                                {
                                    <tr>
                                        <td class="fw-semibold">@st.FullName</td>
                                        <td><code>@(st.UniversityId ?? "N/A")</code></td>
                                        <td>@st.Email</td>
                                        <td>@st.EnrolledAt.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center p-4 text-muted">
                        <i class="bi bi-people fs-2 d-block mb-2"></i>
                        <small>No students currently enrolled in this course.</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

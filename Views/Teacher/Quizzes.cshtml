@model IEnumerable<AUBDigitalAcademy.Models.ViewModels.TeacherQuizItemViewModel>
@{
    ViewData["Title"] = "Quizzes Overview";
    ViewData["ActivePage"] = "Quizzes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
        <div>
            <h1 class="teacher-title">Quizzes Overview</h1>
            <p class="teacher-subtitle">Quizzes published across your assigned courses with student attempt metrics.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-body p-0">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Quiz Title</th>
                                <th>Course</th>
                                <th>Questions</th>
                                <th>Time Limit</th>
                                <th>Passing Score</th>
                                <th>Student Attempts</th>
                                <th>Average Score</th>
                                <th class="pe-4">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var quiz in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@quiz.QuizTitle</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-25 py-1 text-xs">@quiz.CourseCode</span>
                                        <div class="text-muted text-xs mt-1">@quiz.CourseTitle</div>
                                    </td>
                                    <td><span class="fw-semibold text-dark">@quiz.QuestionCount</span> Qs</td>
                                    <td><span class="fw-semibold text-dark">@quiz.TimeLimitMinutes</span> mins</td>
                                    <td><span class="fw-semibold text-dark">@quiz.PassingScore%</span></td>
                                    <td>
                                        <span class="fw-bold text-dark">@quiz.TotalAttempts</span> attempts
                                    </td>
                                    <td>
                                        @if (quiz.TotalAttempts > 0)
                                        {
                                            <span class="fw-bold text-primary fs-6">@quiz.AverageScore%</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted text-xs">No attempts</span>
                                        }
                                    </td>
                                    <td class="pe-4">
                                        @if (quiz.IsPublished)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 text-xs">Published</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1 text-xs">Draft</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center p-5 text-muted">
                    <i class="bi bi-patch-question fs-1 d-block mb-3 text-secondary"></i>
                    <h4 class="fw-bold text-dark">No Quizzes Found</h4>
                    <p class="text-secondary text-sm mb-0">No quizzes have been created for your assigned courses yet.</p>
                </div>
            }
        </div>
    </div>
</div>

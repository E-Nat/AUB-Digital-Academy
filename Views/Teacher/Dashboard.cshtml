@model AUBDigitalAcademy.Models.ViewModels.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teaching Overview";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- 1. DASHBOARD HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 teacher-header">
        <div>
            <h1 class="teacher-title">Teaching Overview</h1>
            <p class="teacher-subtitle">Manage your courses, review student work, and support your students.</p>
        </div>
        <div class="d-flex align-items-center gap-2 teacher-header-actions">
            <select class="form-select term-select" aria-label="Current Academic Term">
                @foreach (var term in Model.AvailableTerms)
                {
                    if (term == Model.CurrentTerm)
                    {
                        <option value="@term" selected>@term</option>
                    }
                    else
                    {
                        <option value="@term">@term</option>
                    }
                }
            </select>
            <a href="/Teacher/Assignments" class="btn-create-assignment" title="Create a new assignment">
                <i class="bi bi-plus-lg"></i>
                <span>Create Assignment</span>
            </a>
        </div>
    </div>

    <!-- 2. QUICK STATS (ONLY 3 COMPACT SUMMARY CARDS) -->
    <div class="row g-3 mb-4">
        <!-- Card 1: My Courses -->
        <div class="col-12 col-md-4">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon courses">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.ActiveCoursesCount</div>
                    <div class="teacher-stat-title">My Courses</div>
                    <div class="teacher-stat-sub">Active courses</div>
                </div>
            </div>
        </div>

        <!-- Card 2: Pending Reviews -->
        <div class="col-12 col-md-4">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon reviews">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.PendingReviewsCount</div>
                    <div class="teacher-stat-title">Pending Reviews</div>
                    <div class="teacher-stat-sub">Awaiting grading</div>
                </div>
            </div>
        </div>

        <!-- Card 3: Upcoming Sessions -->
        <div class="col-12 col-md-4">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon sessions">
                    <i class="bi bi-camera-video-fill"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.UpcomingSessionsCount</div>
                    <div class="teacher-stat-title">Upcoming Sessions</div>
                    <div class="teacher-stat-sub">1-on-1 consultations</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. NEEDS YOUR ATTENTION & 4. TODAY'S SCHEDULE -->
    <div class="row g-4 mb-4">
        <!-- Primary Section: Needs Your Attention (Actionable Tasks) -->
        <div class="col-12 col-lg-7 col-xl-8">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="dashboard-card-title">Needs Your Attention</h2>
                        <p class="dashboard-card-subtitle">Tasks that require action.</p>
                    </div>
                </div>
                <ul class="attention-list">
                    @if (Model.AttentionItems != null && Model.AttentionItems.Any())
                    {
                        @foreach (var item in Model.AttentionItems)
                        {
                            <li class="attention-item">
                                <div class="attention-main">
                                    <div class="attention-title" title="@item.Title">@item.Title</div>
                                    <div class="attention-meta">
                                        <span class="pending-badge @(item.IsUrgent ? "urgent" : "normal")">
                                            @if (item.IsUrgent)
                                            {
                                                <i class="bi bi-exclamation-circle-fill"></i>
                                            }
                                            @item.PendingCount submissions pending
                                        </span>
                                        <span class="attention-meta-dot"></span>
                                        <span class="attention-course-name">@item.CourseName</span>
                                    </div>
                                </div>
                                <a href="@item.ReviewUrl" class="btn-review">
                                    Review
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="p-4 text-center text-muted">
                            <i class="bi bi-check2-circle fs-3 d-block mb-2 text-success"></i>
                            <span class="small">All caught up! No pending submissions or grading tasks.</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- Secondary Section: Today's Schedule (Next 1-2 Consultations) -->
        <div class="col-12 col-lg-5 col-xl-4">
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <div>
                        <h2 class="dashboard-card-title">Today's Schedule</h2>
                        <p class="dashboard-card-subtitle">Upcoming 1-on-1 consultations</p>
                    </div>
                    <a href="/Teacher/Grades" class="dashboard-link">
                        <span>View All</span>
                        <i class="bi bi-chevron-right small"></i>
                    </a>
                </div>
                <ul class="schedule-list">
                    @if (Model.TodaySchedule != null && Model.TodaySchedule.Any())
                    {
                        @foreach (var session in Model.TodaySchedule.Take(2))
                        {
                            <li class="schedule-item">
                                <div class="schedule-person">
                                    <div class="student-avatar">
                                        @session.StudentInitials
                                    </div>
                                    <div class="schedule-details">
                                        <span class="schedule-student-name">@session.StudentName</span>
                                        <span class="schedule-topic" title="@session.Topic">@session.Topic</span>
                                    </div>
                                </div>
                                <div class="schedule-footer">
                                    <span class="schedule-time-badge">
                                        <i class="bi bi-clock"></i>
                                        <span>@session.TimeDisplay</span>
                                    </span>
                                    <a href="@session.SessionUrl" class="btn-view-session">
                                        View Session
                                    </a>
                                </div>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="p-4 text-center text-muted">
                            <i class="bi bi-calendar-check fs-3 d-block mb-2 text-muted"></i>
                            <span class="small">No scheduled consultations for today.</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <!-- 5. MY COURSES (SIMPLIFIED COURSE CARDS - MAX 3) -->
    <div class="mb-4">
        <div class="section-header-row">
            <h2 class="section-main-title">My Courses</h2>
            <a href="/Teacher/Courses" class="dashboard-link">
                <span>View All Courses</span>
                <i class="bi bi-chevron-right small"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (Model.Courses != null && Model.Courses.Any())
            {
                @foreach (var course in Model.Courses.Take(3))
                {
                    <div class="col-12 col-md-4">
                        <div class="teacher-course-card">
                            <div class="course-cover-wrapper">
                                @if (!string.IsNullOrEmpty(course.CoverImageUrl))
                                {
                                    <img src="@course.CoverImageUrl" alt="@course.Title" class="course-cover-img" />
                                }
                                else
                                {
                                    <div class="course-cover-placeholder @course.GradientClass">
                                        <i class="bi @course.IconClass course-placeholder-icon"></i>
                                    </div>
                                }
                            </div>
                            <div class="course-card-body">
                                <div>
                                    <h3 class="course-card-title" title="@course.Title">@course.Title</h3>
                                    <div class="course-card-stats">
                                        <span class="course-card-stat-item">
                                            <i class="bi bi-people"></i>
                                            <span>@course.StudentCount Students</span>
                                        </span>
                                        <span class="course-card-stat-item">
                                            <i class="bi bi-folder2-open"></i>
                                            <span>@course.ModuleCount Modules</span>
                                        </span>
                                    </div>
                                </div>
                                <a href="@course.ManageUrl" class="btn-manage-course">
                                    Manage Course
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="dashboard-card p-4 text-center text-muted">
                        <p class="mb-0">No active courses assigned yet.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

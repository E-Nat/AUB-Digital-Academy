@model AUBDigitalAcademy.Models.ViewModels.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teaching Overview";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- 1. DASHBOARD HEADER -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4 teacher-header">
        <div>
            <h1 class="teacher-title">Teaching Overview</h1>
            <p class="teacher-subtitle">Manage your assigned courses, evaluate student submissions, and monitor class performance.</p>
        </div>
        <div class="d-flex align-items-center gap-2 teacher-header-actions">
            <a href="/Teacher/Courses" class="btn btn-outline-primary rounded-pill px-3 py-2 fw-semibold">
                <i class="bi bi-journal-bookmark me-1"></i> My Courses
            </a>
            <a href="/Teacher/Assignments" class="btn-create-assignment">
                <i class="bi bi-file-earmark-check me-1"></i>
                <span>Review Assignments</span>
            </a>
        </div>
    </div>

    <!-- 2. QUICK STATS CARDS -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Assigned Courses -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon courses">
                    <i class="bi bi-journal-bookmark-fill"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.ActiveCoursesCount</div>
                    <div class="teacher-stat-title">Assigned Courses</div>
                    <div class="teacher-stat-sub">Active teaching workload</div>
                </div>
            </div>
        </div>

        <!-- Card 2: Enrolled Students -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon sessions">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.TotalStudentsCount</div>
                    <div class="teacher-stat-title">Enrolled Students</div>
                    <div class="teacher-stat-sub">Across all courses</div>
                </div>
            </div>
        </div>

        <!-- Card 3: Pending Reviews -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon reviews">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.PendingReviewsCount</div>
                    <div class="teacher-stat-title">Pending Reviews</div>
                    <div class="teacher-stat-sub">Submissions to grade</div>
                </div>
            </div>
        </div>

        <!-- Card 4: Active Quizzes -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="teacher-stat-card">
                <div class="teacher-stat-icon courses">
                    <i class="bi bi-patch-question-fill text-info"></i>
                </div>
                <div class="teacher-stat-info">
                    <div class="teacher-stat-value">@Model.ActiveQuizzesCount</div>
                    <div class="teacher-stat-title">Active Quizzes</div>
                    <div class="teacher-stat-sub">Published assessments</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. NEEDS YOUR ATTENTION & ASSIGNED COURSES -->
    <div class="row g-4 mb-4">
        <!-- Attention Items / Submissions Needing Review -->
        <div class="col-12 col-lg-7 col-xl-8">
            <div class="dashboard-card h-100">
                <div class="dashboard-card-header d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="dashboard-card-title">Pending Reviews & Tasks</h2>
                        <p class="dashboard-card-subtitle">Student assignment submissions awaiting your evaluation.</p>
                    </div>
                    <a href="/Teacher/Assignments" class="text-primary text-decoration-none fw-semibold text-xs">View All</a>
                </div>
                <ul class="attention-list mb-0">
                    @if (Model.AttentionItems != null && Model.AttentionItems.Any())
                    {
                        @foreach (var item in Model.AttentionItems)
                        {
                            <li class="attention-item">
                                <div class="attention-item-content">
                                    <div class="attention-item-header">
                                        <h3 class="attention-item-title">@item.Title</h3>
                                        @if (item.IsUrgent)
                                        {
                                            <span class="urgent-tag"><i class="bi bi-exclamation-circle me-1"></i> Urgent</span>
                                        }
                                    </div>
                                    <div class="attention-item-meta">
                                        <span><i class="bi bi-book me-1"></i>@item.CourseName</span>
                                        <span>•</span>
                                        <span class="text-danger fw-semibold">@item.PendingCount pending submissions</span>
                                        <span>•</span>
                                        <span>@item.DueDateFormatted</span>
                                    </div>
                                </div>
                                <a href="@item.ReviewUrl" class="btn-attention-action">
                                    <span>Review</span>
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle-fill text-success fs-2 d-block mb-2"></i>
                            <div class="fw-semibold">All Caught Up!</div>
                            <small class="text-secondary">There are no pending assignment submissions requiring evaluation right now.</small>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <!-- My Teaching Summary / Quick Links -->
        <div class="col-12 col-lg-5 col-xl-4">
            <div class="dashboard-card h-100">
                <div class="dashboard-card-header">
                    <h2 class="dashboard-card-title">Quick Actions</h2>
                    <p class="dashboard-card-subtitle">Fast links to management views.</p>
                </div>
                <div class="d-flex flex-column gap-3 p-3">
                    <a href="/Teacher/Courses" class="d-flex align-items-center justify-content-between p-3 rounded-3 border border-secondary border-opacity-10 text-decoration-none hover-shadow bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-3 fs-4">
                                <i class="bi bi-journal-text"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-sm">My Courses</div>
                                <small class="text-muted text-xs">View curriculum & rosters</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a href="/Teacher/Grades" class="d-flex align-items-center justify-content-between p-3 rounded-3 border border-secondary border-opacity-10 text-decoration-none hover-shadow bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success bg-opacity-10 text-success p-2 rounded-3 fs-4">
                                <i class="bi bi-clipboard-data"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-sm">Student Grades</div>
                                <small class="text-muted text-xs">View assignment & quiz scores</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a href="/Teacher/Quizzes" class="d-flex align-items-center justify-content-between p-3 rounded-3 border border-secondary border-opacity-10 text-decoration-none hover-shadow bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-info bg-opacity-10 text-info p-2 rounded-3 fs-4">
                                <i class="bi bi-patch-question"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-sm">Quizzes Overview</div>
                                <small class="text-muted text-xs">Check quiz attempt statistics</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>

                    <a href="/Teacher/Books" class="d-flex align-items-center justify-content-between p-3 rounded-3 border border-secondary border-opacity-10 text-decoration-none hover-shadow bg-light">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-3 fs-4">
                                <i class="bi bi-book"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark text-sm">Learning Resources</div>
                                <small class="text-muted text-xs">Books & attached files</small>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. MY COURSES GRID -->
    <div class="dashboard-card mb-4">
        <div class="dashboard-card-header d-flex justify-content-between align-items-center">
            <div>
                <h2 class="dashboard-card-title">My Teaching Courses</h2>
                <p class="dashboard-card-subtitle">Courses currently assigned to your instruction.</p>
            </div>
            <a href="/Teacher/Courses" class="text-primary text-decoration-none fw-semibold text-xs">View All Courses</a>
        </div>

        <div class="row g-4 p-3">
            @if (Model.Courses != null && Model.Courses.Any())
            {
                @foreach (var course in Model.Courses)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="teacher-course-card border border-secondary border-opacity-10 rounded-4 p-4 shadow-sm bg-white h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-1 font-semibold text-xs">
                                    @course.Code
                                </span>
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 text-xs">
                                    @course.StatusDisplay
                                </span>
                            </div>
                            <h3 class="fw-bold text-dark fs-5 mb-2">@course.Title</h3>
                            <div class="text-muted text-xs mb-4">
                                <span><i class="bi bi-bookmark me-1"></i>@course.MajorName</span> • 
                                <span><i class="bi bi-calendar3 me-1"></i>@course.SemesterName</span>
                            </div>
                            <div class="row g-2 mb-4 mt-auto pt-3 border-top border-secondary border-opacity-10 text-muted text-xs">
                                <div class="col-6"><i class="bi bi-people me-1 text-primary"></i> @course.StudentCount Students</div>
                                <div class="col-6"><i class="bi bi-layers me-1 text-info"></i> @course.ModuleCount Chapters</div>
                            </div>
                            <a href="@course.ManageUrl" class="btn btn-outline-primary w-100 rounded-pill font-semibold py-2">
                                Manage Course <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center p-5 text-muted">
                    <i class="bi bi-journal-x fs-1 d-block mb-3 text-secondary"></i>
                    <h4 class="fw-bold">No Courses Assigned Yet</h4>
                    <p class="text-secondary text-sm">You do not have any courses assigned to your instructor account yet.</p>
                </div>
            }
        </div>
    </div>
</div>

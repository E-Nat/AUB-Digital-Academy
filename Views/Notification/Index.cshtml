@model AUBDigitalAcademy.Models.ViewModels.NotificationFeedViewModel
@inject AUBDigitalAcademy.Services.Interfaces.IHtmlSanitizationService HtmlSanitizer
@{
    ViewData["Title"] = "Notification Center";
    ViewData["ActivePage"] = "Notifications";
    var activeTab = (string)(ViewBag.ActiveTab ?? "all");
    var announcements = (List<AUBDigitalAcademy.Models.ViewModels.AnnouncementItemViewModel>)(ViewBag.Announcements ?? new List<AUBDigitalAcademy.Models.ViewModels.AnnouncementItemViewModel>());
    var isFacultyOrAdmin = User.IsInRole("Admin") || User.IsInRole("Teacher");
}

<div class="container-fluid p-0">
    <!-- Top Action Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Notifications</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill text-primary"></i>
                <span>Notification Center</span>
                @if (Model.UnreadCount > 0)
                {
                    <span class="badge bg-danger rounded-pill fs-6">@Model.UnreadCount New</span>
                }
            </h1>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (Model.UnreadCount > 0)
            {
                <form asp-controller="Notification" asp-action="MarkAllAsRead" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-secondary rounded-pill px-3 py-1.5 small fw-semibold">
                        <i class="bi bi-check2-all me-1"></i> Mark All as Read
                    </button>
                </form>
            }
            @if (isFacultyOrAdmin)
            {
                <button type="button" class="btn btn-primary rounded-pill px-3 py-1.5 small fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#createAnnouncementModal">
                    <i class="bi bi-megaphone me-1"></i> Post Announcement
                </button>
            }
        </div>
    </div>

    <!-- Filter Tabs -->
    <ul class="nav nav-pills mb-4 bg-light p-1.5 rounded-3 border d-inline-flex">
        <li class="nav-item">
            <a class="nav-link rounded-pill py-1.5 px-3 small fw-semibold @(activeTab == "all" ? "active" : "text-secondary")" href="/Notifications?tab=all">
                <i class="bi bi-inbox me-1"></i> All Notifications (@Model.Notifications.Count)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill py-1.5 px-3 small fw-semibold @(activeTab == "unread" ? "active" : "text-secondary")" href="/Notifications?tab=unread">
                <i class="bi bi-envelope-badge me-1"></i> Unread (@Model.UnreadCount)
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill py-1.5 px-3 small fw-semibold @(activeTab == "announcements" ? "active" : "text-secondary")" href="/Notifications?tab=announcements">
                <i class="bi bi-megaphone me-1"></i> Announcements (@announcements.Count)
            </a>
        </li>
    </ul>

    <!-- Tab Contents -->
    <div class="row">
        <div class="col-12 col-lg-9">
            @if (activeTab == "announcements")
            {
                <!-- Announcements List -->
                @if (announcements.Count == 0)
                {
                    <div class="card border rounded-3 p-5 text-center text-muted shadow-sm bg-white">
                        <i class="bi bi-megaphone fs-1 d-block mb-3 text-secondary opacity-50"></i>
                        <h5 class="fw-bold text-dark">No Announcements</h5>
                        <p class="small text-muted mb-0">There are currently no active announcements for your courses.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ann in announcements)
                        {
                            <div class="card border rounded-3 p-4 shadow-sm @(ann.IsPinned ? "border-warning bg-warning bg-opacity-10" : "bg-white")">
                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        @if (ann.Scope == AUBDigitalAcademy.Models.Enums.AnnouncementScope.Global)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-globe me-1"></i> Global Notice
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                                                <i class="bi bi-book me-1"></i> @ann.CourseCode - @ann.CourseTitle
                                            </span>
                                        }
                                        @if (ann.IsPinned)
                                        {
                                            <span class="badge bg-warning text-dark border border-warning rounded-pill px-2 py-1">
                                                <i class="bi bi-pin-angle-fill me-1"></i> Pinned
                                            </span>
                                        }
                                        <span class="text-muted small">&bull; Posted by <strong>@ann.AuthorName</strong> (@ann.AuthorRole) &bull; @ann.PublishedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    @if (ann.CanDelete)
                                    {
                                        <form asp-controller="Notification" asp-action="DeleteAnnouncement" method="post" onsubmit="return confirm('Are you sure you want to delete this announcement?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@ann.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger border-0 py-1 px-2" title="Delete Announcement">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                                <h5 class="fw-bold text-dark mb-2">@ann.Title</h5>
                                <div class="text-secondary small mb-0" style="white-space: pre-wrap;">@Html.Raw(HtmlSanitizer.SanitizeLessonHtml(ann.Content))</div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <!-- Notifications List (All or Unread) -->
                var displayList = activeTab == "unread"
                    ? Model.Notifications.Where(n => !n.IsRead).ToList()
                    : Model.Notifications;

                @if (displayList.Count == 0)
                {
                    <div class="card border rounded-3 p-5 text-center text-muted shadow-sm bg-white">
                        <i class="bi bi-bell-slash fs-1 d-block mb-3 text-secondary opacity-50"></i>
                        <h5 class="fw-bold text-dark">No Notifications</h5>
                        <p class="small text-muted mb-0">@(activeTab == "unread" ? "You have read all of your notifications." : "You have no notifications in your history.")</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var n in displayList)
                        {
                            <div class="card border rounded-3 p-3 shadow-sm @(n.IsRead ? "bg-white" : "bg-primary-subtle bg-opacity-10 border-primary border-opacity-25")">
                                <div class="d-flex align-items-start gap-3">
                                    <div class="flex-shrink-0 mt-1">
                                        <i class="bi @n.IconClass fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <div class="d-flex align-items-center justify-content-between gap-2 mb-1 flex-wrap">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge @n.BadgeBgClass rounded-pill" style="font-size: 0.7rem;">@n.TypeDisplay</span>
                                                <span class="fw-bold text-dark small">@n.Title</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2">
                                                <small class="text-muted" style="font-size: 0.75rem;">@n.RelativeTime</small>
                                                @if (!n.IsRead)
                                                {
                                                    <form asp-controller="Notification" asp-action="MarkAsRead" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@n.Id" />
                                                        <button type="submit" class="btn btn-sm btn-link text-primary p-0" title="Mark as read">
                                                            <i class="bi bi-check2"></i>
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </div>
                                        <p class="text-secondary small mb-2">@n.Message</p>
                                        @if (!string.IsNullOrEmpty(n.TargetUrl))
                                        {
                                            <a href="@n.TargetUrl" class="btn btn-sm btn-outline-primary py-0.5 px-2 text-xs rounded-pill">
                                                <span>View Details</span> <i class="bi bi-arrow-right ms-1"></i>
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <!-- Sidebar / Tips -->
        <div class="col-12 col-lg-3 mt-4 mt-lg-0">
            <div class="card border rounded-3 p-3 bg-light shadow-sm">
                <h6 class="fw-bold text-dark mb-2"><i class="bi bi-info-circle text-primary me-1"></i> About Notifications</h6>
                <p class="small text-muted mb-2">You receive instant system updates for:</p>
                <ul class="small text-muted ps-3 mb-0">
                    <li><strong class="text-dark">Discussion Replies:</strong> When teachers or classmates reply to your lesson questions.</li>
                    <li><strong class="text-dark">New Lessons:</strong> When your instructors publish curriculum materials.</li>
                    <li><strong class="text-dark">Grades Released:</strong> When your assignments or quizzes are scored.</li>
                    <li><strong class="text-dark">Announcements:</strong> Important institutional or course updates.</li>
                    <li><strong class="text-dark">Milestones:</strong> When you complete 100% of a course!</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@if (isFacultyOrAdmin)
{
    <!-- Create Announcement Modal -->
    <div class="modal fade" id="createAnnouncementModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-megaphone me-1 text-primary"></i> Publish Announcement</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Notification" asp-action="CreateAnnouncement" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Scope <span class="text-danger">*</span></label>
                            <select name="Scope" id="announcementScopeSelect" class="form-select form-select-sm" required>
                                @if (User.IsInRole("Admin"))
                                {
                                    <option value="0">Global (All Platform Users)</option>
                                }
                                <option value="1" selected>Course-Specific</option>
                            </select>
                        </div>
                        <div class="mb-3" id="courseSelectGroup">
                            <label class="form-label small fw-semibold text-dark">Course ID <span class="text-danger">*</span></label>
                            <input type="number" name="CourseId" class="form-control form-control-sm" placeholder="Enter Course ID" />
                            <small class="text-muted">Enter the numeric ID of the course you wish to notify.</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Title <span class="text-danger">*</span></label>
                            <input type="text" name="Title" class="form-control form-control-sm" placeholder="e.g. Midterm exam timetable released" required minlength="3" maxlength="200" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">Content / Message <span class="text-danger">*</span></label>
                            <textarea name="Content" class="form-control form-control-sm" rows="4" placeholder="Detailed announcement details..." required minlength="3" maxlength="4000"></textarea>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="IsPinned" value="true" id="isPinnedCheck">
                            <label class="form-check-label small" for="isPinnedCheck">
                                Pin this announcement to top
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                            <i class="bi bi-send me-1"></i> Publish & Notify
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

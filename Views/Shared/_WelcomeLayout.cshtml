<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUB Digital Academy</title>
    
    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <!-- Custom Public Site Styles & Motion -->
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-animations.css" asp-append-version="true" />
    
    <link rel="icon" type="image/x-icon" href="~/logos/rel_icon.png">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="welcome-body">

    <!-- Keyboard Accessibility Skip Link -->
    <a href="#mainContent" class="skip-nav-link">Skip to main content</a>

    <!-- Accessible Sticky Header -->
    <header class="welcome-header sticky-top" id="siteHeader">
        <nav class="navbar navbar-expand-lg welcome-navbar" id="mainNav" aria-label="Main Navigation">
            <div class="container-max d-flex align-items-center justify-content-between w-100">
                
                <!-- University Brand / Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2 text-decoration-none" href="#home" aria-label="AUB Digital Academy Homepage">
                    <div class="brand-logo-icon" aria-hidden="true">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div class="brand-text-container">
                        <span class="brand-title">AUB</span>
                        <span class="brand-subtitle">DIGITAL ACADEMY</span>
                    </div>
                </a>
                
                <!-- Center Navigation Links -->
                <ul class="navbar-nav d-none d-lg-flex flex-row gap-4 align-items-center mb-0" id="navLinksList">
                    <li class="nav-item">
                        <a class="nav-link active" href="#home">
                            <span>Home</span>
                            <span class="nav-indicator" aria-hidden="true"></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#programs">
                            <span>Programs</span>
                            <span class="nav-indicator" aria-hidden="true"></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#why-choose-us">
                            <span>Why AUB</span>
                            <span class="nav-indicator" aria-hidden="true"></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#courses">
                            <span>Courses</span>
                            <span class="nav-indicator" aria-hidden="true"></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">
                            <span>About</span>
                            <span class="nav-indicator" aria-hidden="true"></span>
                        </a>
                    </li>
                </ul>
                
                <!-- Action Buttons -->
                <div class="d-none d-lg-flex align-items-center gap-2.5">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var dashUrl = User.IsInRole("Admin") ? "/Admin" : User.IsInRole("Teacher") ? "/Teacher/Dashboard" : "/Student/Dashboard";
                        <a href="@dashUrl" class="btn btn-gold-action d-inline-flex align-items-center gap-2">
                            <i class="bi bi-grid-fill" aria-hidden="true"></i> Dashboard
                        </a>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-outline-signin d-inline-flex align-items-center gap-2">
                            <i class="bi bi-person" aria-hidden="true"></i> Sign In
                        </a>
                        <a href="/Account/Login" class="btn btn-gold-action d-inline-flex align-items-center gap-1.5">
                            Get Started <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    }
                </div>

                <!-- Mobile Menu Button -->
                <button class="mobile-toggle-btn d-lg-none" type="button" id="mobileMenuToggle" aria-label="Toggle navigation menu" aria-expanded="false" aria-controls="mobileDrawer">
                    <i class="bi bi-list fs-2" aria-hidden="true"></i>
                </button>
                
            </div>
        </nav>
    </header>

    <!-- Mobile Navigation Drawer -->
    <div class="mobile-drawer d-lg-none" id="mobileDrawer" role="dialog" aria-modal="true" aria-label="Mobile Navigation Menu">
        <div class="mobile-drawer-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <div class="brand-logo-icon" style="width: 34px; height: 34px; font-size: 1rem;" aria-hidden="true">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <span class="text-white fw-bold fs-6">AUB Digital Academy</span>
            </div>
            <button class="btn text-white p-1" id="mobileDrawerClose" aria-label="Close navigation menu">
                <i class="bi bi-x-lg fs-5" aria-hidden="true"></i>
            </button>
        </div>

        <ul class="mobile-nav-list list-unstyled mt-3 mb-auto">
            <li><a class="mobile-nav-link active" href="#home"><i class="bi bi-house-door me-2" aria-hidden="true"></i> Home</a></li>
            <li><a class="mobile-nav-link" href="#programs"><i class="bi bi-collection me-2" aria-hidden="true"></i> Academic Programs</a></li>
            <li><a class="mobile-nav-link" href="#why-choose-us"><i class="bi bi-shield-check me-2" aria-hidden="true"></i> Why AUB</a></li>
            <li><a class="mobile-nav-link" href="#courses"><i class="bi bi-journal-bookmark me-2" aria-hidden="true"></i> Courses</a></li>
            <li><a class="mobile-nav-link" href="#about"><i class="bi bi-info-circle me-2" aria-hidden="true"></i> About Academy</a></li>
        </ul>

        <div class="mobile-drawer-footer pt-3 mt-3 border-top border-white border-opacity-10">
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var dashUrl = User.IsInRole("Admin") ? "/Admin" : User.IsInRole("Teacher") ? "/Teacher/Dashboard" : "/Student/Dashboard";
                <a href="@dashUrl" class="btn btn-gold-action w-100 justify-content-center py-2.5">
                    <i class="bi bi-grid-fill me-2" aria-hidden="true"></i> Open Dashboard
                </a>
            }
            else
            {
                <a href="/Account/Login" class="btn btn-outline-signin text-white w-100 justify-content-center py-2.5 mb-2">
                    <i class="bi bi-person me-2" aria-hidden="true"></i> Sign In to Portal
                </a>
                <a href="/Account/Login" class="btn btn-gold-action w-100 justify-content-center py-2.5">
                    Get Started <i class="bi bi-arrow-right ms-1.5" aria-hidden="true"></i>
                </a>
            }
        </div>
    </div>
    <div class="mobile-backdrop d-lg-none" id="mobileBackdrop" aria-hidden="true"></div>

    <!-- Main View Content -->
    <main id="mainContent" tabindex="-1">
        @RenderBody()
    </main>

    <!-- Public Institutional Footer -->
    <footer class="landing-footer">
        <div class="container-max">
            <div class="row g-4 g-lg-5 pb-5 border-bottom border-white border-opacity-10">
                
                <div class="col-lg-4 pe-lg-4">
                    <a class="footer-brand d-flex align-items-center gap-2 mb-3 text-decoration-none" href="#home" aria-label="AUB Home">
                        <div class="brand-logo-icon" aria-hidden="true">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <div>
                            <span class="d-block text-white fw-bold fs-4 lh-1">AUB</span>
                            <span class="d-block text-gold fw-bold text-xs" style="letter-spacing: 0.1em;">DIGITAL ACADEMY</span>
                        </div>
                    </a>
                    <p class="text-white text-opacity-75 text-sm mb-4" style="line-height: 1.65;">
                        Empowering students and faculty with modern accredited curricula, interactive coursework, real-time assessment, and unified academic management.
                    </p>
                    <div class="social-links d-flex gap-2">
                        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="AUB on Facebook"><i class="bi bi-facebook" aria-hidden="true"></i></a>
                        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="AUB on Instagram"><i class="bi bi-instagram" aria-hidden="true"></i></a>
                        <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="AUB on LinkedIn"><i class="bi bi-linkedin" aria-hidden="true"></i></a>
                        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="AUB on YouTube"><i class="bi bi-youtube" aria-hidden="true"></i></a>
                    </div>
                </div>
                
                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="text-white fw-bold mb-3 text-sm text-uppercase" style="letter-spacing: 0.08em;">Quick Links</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-sm">
                        <li><a href="#home" class="footer-link">Home</a></li>
                        <li><a href="#programs" class="footer-link">Programs</a></li>
                        <li><a href="#why-choose-us" class="footer-link">Why Choose Us</a></li>
                        <li><a href="#courses" class="footer-link">Courses</a></li>
                        <li><a href="#about" class="footer-link">About Academy</a></li>
                    </ul>
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <h6 class="text-white fw-bold mb-3 text-sm text-uppercase" style="letter-spacing: 0.08em;">Portals</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 text-sm">
                        <li><a href="/Account/Login" class="footer-link">Student Portal</a></li>
                        <li><a href="/Account/Login" class="footer-link">Faculty Portal</a></li>
                        <li><a href="/Account/Login" class="footer-link">Administration</a></li>
                        <li><a href="/Account/ForgotPassword" class="footer-link">Password Help</a></li>
                    </ul>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <h6 class="text-white fw-bold mb-3 text-sm text-uppercase" style="letter-spacing: 0.08em;">Contact Campus</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2.5 text-sm text-white text-opacity-75">
                        <li class="d-flex align-items-start gap-2">
                            <i class="bi bi-geo-alt text-gold mt-1 flex-shrink-0" aria-hidden="true"></i>
                            <span>Phnom Penh Campus, Kingdom of Cambodia</span>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-envelope text-gold flex-shrink-0" aria-hidden="true"></i>
                            <a href="mailto:info@aub.edu.kh" class="footer-link">info@aub.edu.kh</a>
                        </li>
                        <li class="d-flex align-items-center gap-2">
                            <i class="bi bi-telephone text-gold flex-shrink-0" aria-hidden="true"></i>
                            <span>+855 23 999 111</span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center pt-4 text-white text-opacity-50 text-xs">
                <div>&copy; 2026 AUB Digital Academy. All rights reserved.</div>
                <div class="d-flex gap-3 mt-2 mt-md-0">
                    <a href="/Home/Privacy" class="footer-link text-xs">Privacy Policy</a>
                    <span aria-hidden="true">&bull;</span>
                    <a href="/Home/Privacy" class="footer-link text-xs">Academic Integrity</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/home.js" asp-append-version="true"></script>
    <script src="~/js/home-animations.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

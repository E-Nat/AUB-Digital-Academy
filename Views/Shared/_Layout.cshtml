@functions {
    bool IsActiveRoute(string activePage, string routePath)
    {
        var active = ViewData["ActivePage"]?.ToString();
        if (!string.IsNullOrEmpty(active) && string.Equals(active, activePage, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var path = Context.Request.Path.Value?.ToLower() ?? "";
        if (string.IsNullOrEmpty(path) || path == "/")
        {
            return string.Equals(activePage, "Dashboard", StringComparison.OrdinalIgnoreCase);
        }

        var r = routePath.ToLower();
        if (path == r)
        {
            return true;
        }

        if (r != "/admin/dashboard" && r != "/teacher/dashboard" && r != "/student/dashboard" && r != "/" && path.StartsWith(r))
        {
            return true;
        }

        return false;
    }
}
@{
    var userRole = User.IsInRole("Admin") ? "Admin" : User.IsInRole("Teacher") ? "Teacher" : User.IsInRole("Assistance") ? "Assistance" : "Student";
    var dashboardArea = (userRole == "Teacher" || userRole == "Assistance") ? "Teacher" : userRole;
    var areaPrefix = $"/{dashboardArea}";
    var userName = User.Identity?.Name ?? "User";
    var userInitial = !string.IsNullOrEmpty(userName) ? userName.Substring(0, 1).ToUpper() : "U";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUB Digital Academy</title>
    
    <!-- Pre-paint Theme Initialization (Prevents Dark Mode FOUC Flash) -->
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = saved || (prefersDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-bs-theme', theme);
            } catch (e) {}
        })();
    </script>

    <!-- Google Fonts Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    
    <!-- Custom CSS -->
    <link rel="icon" type="image/x-icon" href="~/logos/rel_icon.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar Overlay (Mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        @if (User.IsInRole("Admin"))
        {
            <partial name="_Sidebar" />
        }
        else
        {
            <!-- Sidebar (Modern 240px Clean SaaS Sidebar for Teacher / Student) -->
            <aside class="sidebar" id="sidebar" aria-label="Sidebar navigation">
                <!-- Brand Header -->
                <div class="sidebar-header">
                    <a href="/@dashboardArea/Dashboard" class="sidebar-brand-link d-flex align-items-center gap-2.5 w-100 text-decoration-none">
                        <img src="~/logos/rel_icon.png" alt="AUB University Emblem" class="sidebar-logo-img" />
                        <div class="sidebar-brand">
                            <span class="brand-text">AUB <span class="brand-gold">ACADEMY</span></span>
                            <small class="brand-sub">University Command</small>
                        </div>
                    </a>
                </div>

                <!-- Navigation Links -->
                <nav class="sidebar-nav" id="sidebarNav">
                    @if (User.IsInRole("Teacher") || User.IsInRole("Assistance"))
                    {
                        <div class="nav-group">
                            <a href="/Teacher/Dashboard" class="nav-link-item @(IsActiveRoute("Dashboard", $"/{userRole}/Dashboard") || IsActiveRoute("Dashboard", "/Teacher/Dashboard") ? "active" : "")" title="Dashboard" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-grid-fill"></i></div>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </div>

                        <div class="sidebar-divider" aria-hidden="true"></div>

                        <div class="nav-group">
                            <a href="/Teacher/Courses" class="nav-link-item @(IsActiveRoute("Courses", $"/{userRole}/Courses") || IsActiveRoute("Courses", "/Teacher/Courses") ? "active" : "")" title="My Courses" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-journal-bookmark-fill"></i></div>
                                <span class="nav-label">My Courses</span>
                            </a>
                            <a href="/Teacher/Assignments" class="nav-link-item @(IsActiveRoute("Assignments", "/Teacher/Assignments") || IsActiveRoute("Submissions", "/Teacher/Submissions") ? "active" : "")" title="Submissions" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-file-earmark-check-fill"></i></div>
                                <span class="nav-label">Submissions</span>
                            </a>
                            <a href="/Teacher/Quizzes" class="nav-link-item @(IsActiveRoute("Quizzes", "/Teacher/Quizzes") ? "active" : "")" title="Quizzes" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-patch-question-fill"></i></div>
                                <span class="nav-label">Quizzes</span>
                            </a>
                            <a href="/Teacher/Books" class="nav-link-item @(IsActiveRoute("Books", "/Teacher/Books") ? "active" : "")" title="Books" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-book-fill"></i></div>
                                <span class="nav-label">Books</span>
                            </a>
                            <a href="/Teacher/Grades" class="nav-link-item @(IsActiveRoute("Grades", $"/{userRole}/Grades") || IsActiveRoute("Grades", "/Teacher/Grades") ? "active" : "")" title="Grades" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-clipboard-data-fill"></i></div>
                                <span class="nav-label">Grades</span>
                            </a>
                        </div>

                        <div class="sidebar-divider" aria-hidden="true"></div>

                        <div class="nav-group">
                            <a href="/Profile" class="nav-link-item @(IsActiveRoute("Profile", "/Profile") ? "active" : "")" title="Settings" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-gear-fill"></i></div>
                                <span class="nav-label">Settings</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="nav-group">
                            <a href="/Student/Dashboard" class="nav-link-item @(IsActiveRoute("Dashboard", $"/{userRole}/Dashboard") ? "active" : "")" title="Dashboard" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-grid-fill"></i></div>
                                <span class="nav-label">Dashboard</span>
                            </a>
                        </div>

                        <div class="sidebar-divider" aria-hidden="true"></div>

                        <div class="nav-group">
                            <a href="/Student/Courses" class="nav-link-item @(IsActiveRoute("Courses", $"/{userRole}/Courses") ? "active" : "")" title="My Courses" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-journal-bookmark-fill"></i></div>
                                <span class="nav-label">My Courses</span>
                            </a>
                            <a href="/Student/Grades" class="nav-link-item @(IsActiveRoute("Grades", $"/{userRole}/Grades") ? "active" : "")" title="Grades" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-clipboard-data-fill"></i></div>
                                <span class="nav-label">Grades</span>
                            </a>
                        </div>

                        <div class="sidebar-divider" aria-hidden="true"></div>

                        <div class="nav-group">
                            <a href="/Profile" class="nav-link-item @(IsActiveRoute("Profile", "/Profile") ? "active" : "")" title="Settings" data-bs-toggle="tooltip" data-bs-placement="right">
                                <div class="nav-icon-tile"><i class="bi bi-gear-fill"></i></div>
                                <span class="nav-label">Settings</span>
                            </a>
                        </div>
                    }
                </nav>

                <!-- Bottom User Profile Card with Real Identity & Logout -->
                <div class="sidebar-footer">
                    <div class="sidebar-user-card">
                        <div class="d-flex align-items-center gap-2.5 overflow-hidden flex-grow-1">
                            <div class="sidebar-user-avatar" title="@userName">
                                @userInitial
                            </div>
                            <div class="sidebar-user-meta">
                                <div class="sidebar-user-name text-truncate" title="@userName">@userName</div>
                                <div class="sidebar-user-role">@userRole</div>
                            </div>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0 flex-shrink-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="sidebar-logout-btn" title="Sign out" aria-label="Sign out">
                                <i class="bi bi-box-arrow-right"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>
        }

        <!-- Main Workspace -->
        <div class="main-content" id="mainContent">
            <!-- Topbar (Executive Header) -->
            <header class="topbar">
                <div class="d-flex align-items-center gap-2">
                    <button class="topbar-toggle-btn" id="sidebarToggle" aria-label="Toggle navigation menu" title="Toggle Sidebar">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <nav aria-label="breadcrumb" class="ms-1 d-none d-lg-block">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="/@dashboardArea/Dashboard" class="text-decoration-none">@userRole</a></li>
                            <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                        </ol>
                    </nav>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <!-- Global Search Input with Ctrl+K shortcut -->
                    <div class="topbar-search-wrap d-none d-md-flex align-items-center">
                        <i class="bi bi-search text-muted me-2"></i>
                        <input type="text" class="topbar-search-input" id="globalSearchInput" placeholder="Search courses, users, enrollments..." aria-label="Search records" />
                        <kbd class="topbar-search-kbd">Ctrl K</kbd>
                    </div>
                }

                <div class="d-flex align-items-center gap-2.5">
                    <!-- Theme Toggle (Light / Dark Mode with LocalStorage Persistence) -->
                    <button class="topbar-icon-btn theme-toggle-btn" id="themeToggle" title="Toggle light/dark theme" aria-label="Toggle theme">
                        <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                    </button>

                    <!-- Real-Time Notifications (Phase 5C) -->
                    <div class="dropdown">
                        <button class="topbar-icon-btn position-relative" id="notificationBtn" data-bs-toggle="dropdown" aria-label="Notifications" aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notificationBadge" style="display: none; font-size: 10px;">0</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg notification-dropdown p-0" aria-labelledby="notificationBtn" style="min-width: 340px; max-width: 400px;">
                            <div class="notification-dropdown-header d-flex align-items-center justify-content-between p-3 border-bottom bg-light">
                                <span class="fw-bold text-dark">Notifications</span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none p-0 text-primary small fw-semibold" id="markAllReadBtn" style="font-size: 12px;">Mark all read</button>
                            </div>
                            <div id="notificationListContainer" style="max-height: 360px; overflow-y: auto;">
                                <div class="p-4 text-center text-muted">
                                    <i class="bi bi-bell-slash fs-3 d-block mb-2 text-secondary opacity-50"></i>
                                    <div class="fw-semibold small text-dark-emphasis">No new notifications</div>
                                    <div class="text-secondary small mt-1" style="font-size: 12px;">You are completely caught up on system notices.</div>
                                </div>
                            </div>
                            <div class="p-2 border-top text-center bg-light">
                                <a href="/Notifications" class="small text-decoration-none fw-semibold text-primary">View all in Notification Center <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>

                    <!-- User Profile Dropdown (Matches Real Identity) -->
                    <div class="dropdown">
                        <button class="topbar-user-btn d-flex align-items-center gap-2" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="User menu">
                            <div class="topbar-user-avatar">
                                @userInitial
                            </div>
                            <div class="d-none d-md-block text-start lh-sm">
                                <div class="topbar-user-name">@userName</div>
                                <div class="topbar-user-role">@userRole</div>
                            </div>
                            <i class="bi bi-chevron-down d-none d-md-block text-muted small ms-0.5"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg topbar-user-dropdown" aria-labelledby="userMenuBtn">
                            <li class="dropdown-header">
                                <div class="fw-bold text-dark-emphasis">@userName</div>
                                <div class="text-muted small">@userRole Account</div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center gap-2" href="/Profile">
                                    <i class="bi bi-person text-secondary"></i>
                                    <span>Profile &amp; Security</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Sign Out</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Main Content Area -->
            <main class="content-area" id="mainContentArea">
                <!-- Global Toast Container -->
                <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;" id="toastContainer"></div>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-check-circle-fill flex-shrink-0"></i>
                        <div class="flex-grow-1">@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                        <div class="flex-grow-1">@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AUB Digital Academy</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-white">
    <div class="d-flex min-vh-100">
        
        <!-- Left Panel (Branding) -->
        <div class="auth-left-panel d-none d-lg-flex flex-column position-relative overflow-hidden w-50">
            <!-- Background Elements -->
            <div class="auth-bg-overlay"></div>
            
            <div class="auth-left-content position-relative z-3 d-flex flex-column h-100 p-5">
                <!-- Header / Logo -->
                <div class="d-flex align-items-center gap-3 mb-auto">
                    <div class="auth-logo-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <span class="text-white fw-bold fs-3 letter-spacing-tight">AUB</span>
                        <div class="d-flex flex-column lh-1 mt-1">
                            <span class="text-white fw-semibold" style="font-size: 0.75rem; letter-spacing: 1px;">DIGITAL</span>
                            <span class="text-gold fw-bold" style="font-size: 0.75rem; letter-spacing: 1px;">ACADEMY</span>
                        </div>
                    </div>
                </div>
                
                <!-- Main Text -->
                <div class="mb-auto mt-5 pt-5">
                    <p class="text-white fs-4 mb-2 fw-light">Welcome to</p>
                    <h1 class="text-white display-5 fw-bold mb-4">AUB <span class="text-gold">Digital Academy</span></h1>
                    <div class="auth-title-underline mb-4"></div>
                    <p class="text-white opacity-75 fs-5 fw-light" style="max-width: 400px; line-height: 1.6;">
                        The smart learning platform for students and teachers.
                    </p>
                </div>
                
                <!-- Footer area of left panel if needed, currently empty to match mockup -->
                <div></div>
            </div>
            
            <!-- Graphic/Building Illustration Placeholder (using CSS for abstract look) -->
            <div class="auth-abstract-bg position-absolute bottom-0 start-0 w-100 z-1"></div>
        </div>
        
        <!-- Right Panel (Form) -->
        <div class="auth-right-panel d-flex flex-column justify-content-center align-items-center w-100 w-lg-50 bg-white position-relative">
            <div class="auth-form-wrapper w-100 p-4 p-md-5" style="max-width: 550px;">
                @RenderBody()
            </div>
        </div>
        
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

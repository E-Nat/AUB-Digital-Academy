@model AUBDigitalAcademy.Models.ViewModels.CourseEnrollmentListViewModel
@{
    ViewData["Title"] = $"Enrolled Students - {Model.CourseTitle}";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    @{
        var isAdminUser = User.IsInRole("Admin");
        var isTeacherUser = User.IsInRole("Teacher");
        var canManageCurriculum = isAdminUser || isTeacherUser;
        var coursesBackUrl = isAdminUser ? "/Admin/Courses" : "/Teacher/Courses";
        var courseCrumbUrl = canManageCurriculum ? $"/Academic/Curriculum/{Model.CourseId}" : $"/Teacher/CourseDetails/{Model.CourseId}";
    }
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="@coursesBackUrl" class="text-decoration-none">Courses</a></li>
            <li class="breadcrumb-item"><a href="@courseCrumbUrl" class="text-decoration-none">@Model.CourseTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">Enrolled Students</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="admin-page-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-secondary-subtle text-secondary font-monospace">@Model.CourseCode</span>
                <h1 class="admin-page-title mb-0">@Model.CourseTitle</h1>
            </div>
            <p class="admin-page-subtitle">
                Instructor: <strong>@Model.TeacherName</strong> &bull; Total Enrolled: <strong>@Model.TotalEnrollments</strong> Students
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@coursesBackUrl" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="bi bi-arrow-left"></i>
                <span>Back to Courses</span>
            </a>
            @if (User.IsInRole("Admin"))
            {
                <button class="btn btn-primary-aub d-inline-flex align-items-center gap-2 shadow-sm" data-bs-toggle="modal" data-bs-target="#enrollStudentModal" type="button">
                    <i class="bi bi-plus-lg"></i>
                    <span>Enroll Student</span>
                </button>
            }
        </div>
    </div>

    <!-- Alert Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main Table Card -->
    <div class="course-table-card bg-white border rounded-3 shadow-sm overflow-hidden mb-4">
        <div class="p-3 border-bottom d-flex align-items-center justify-content-between bg-light">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-people-fill text-primary"></i>
                <h6 class="fw-bold mb-0 text-dark">Course Roster</h6>
                <span class="badge bg-primary rounded-pill">@Model.TotalEnrollments</span>
            </div>
            @if (canManageCurriculum)
            {
                <div>
                    <a href="@Url.Action("Curriculum", "Academic", new { id = Model.CourseId })" class="btn btn-sm btn-outline-primary shadow-sm">
                        <i class="bi bi-diagram-3 me-1"></i> View Curriculum
                    </a>
                </div>
            }
        </div>

        @if (Model.Students.Count == 0)
        {
            <!-- Empty State -->
            <div class="p-5 text-center">
                <i class="bi bi-person-x fs-1 d-block mb-3 text-secondary opacity-50"></i>
                <h5 class="fw-bold text-dark mb-1">No students enrolled in this course yet.</h5>
                <p class="text-muted small mb-3">Enroll students into this course to enable learning and progress tracking.</p>
                @if (User.IsInRole("Admin"))
                {
                    <button class="btn btn-primary-aub btn-sm shadow-sm" data-bs-toggle="modal" data-bs-target="#enrollStudentModal" type="button">
                        <i class="bi bi-plus-lg me-1"></i> Enroll Student
                    </button>
                }
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table course-table mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width: 240px;">Student</th>
                            <th>Student ID</th>
                            <th>Enrolled Date</th>
                            <th>Account Status</th>
                            <th>Learning Activity</th>
                            <th class="text-end pe-3" style="min-width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model.Students)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                                            @(string.IsNullOrEmpty(student.FullName) ? "S" : student.FullName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@student.FullName</div>
                                            <small class="text-muted">@student.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace text-dark small fw-medium">@(student.UniversityId ?? "N/A")</span>
                                </td>
                                <td>
                                    <span class="small text-dark">@student.EnrolledAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    @if (student.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 small">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1 small">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (student.HasLearningActivity)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-check2-circle"></i> Activity Recorded
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-secondary border d-inline-flex align-items-center gap-1">
                                            <i class="bi bi-dash-circle"></i> No Activity Yet
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex align-items-center justify-content-end gap-1">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a href="/Enrollment?studentId=@student.StudentId" class="btn btn-sm btn-outline-secondary p-1" title="Manage Student Enrollments">
                                                <i class="bi bi-person-gear"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-outline-danger p-1 remove-student-enrollment-btn"
                                                    data-id="@student.EnrollmentId"
                                                    data-course-id="@Model.CourseId"
                                                    data-course-title="@Model.CourseTitle"
                                                    data-student-name="@student.FullName"
                                                    data-student-id="@student.StudentId"
                                                    title="Remove Enrollment">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ============================================================ -->
<!-- 1. ENROLL STUDENT MODAL (From Course View)                   -->
<!-- ============================================================ -->
@if (User.IsInRole("Admin"))
{
    <div class="modal fade" id="enrollStudentModal" tabindex="-1" aria-labelledby="enrollStudentModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom py-3 px-4">
                    <h5 class="modal-title fw-bold text-dark mb-0" id="enrollStudentModalTitle">
                        <i class="bi bi-person-plus-fill text-primary me-2"></i> Enroll Student in Course
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form asp-controller="Enrollment" asp-action="Enroll" method="post" id="enrollStudentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <input type="hidden" name="returnUrl" value="/Enrollment/CourseStudents?courseId=@Model.CourseId" />

                    <div class="modal-body p-4">
                        <!-- Course Info (Preselected) -->
                        <div class="mb-3 p-3 bg-light rounded-3 border">
                            <label class="form-label small fw-semibold text-secondary mb-1">Target Course</label>
                            <div class="fw-bold text-dark fs-6">@Model.CourseTitle</div>
                            <div class="small text-muted font-monospace">@Model.CourseCode &bull; Instructor: @Model.TeacherName</div>
                        </div>

                        <!-- Student Selector -->
                        <div class="mb-3">
                            <label for="studentSelect" class="form-label small fw-bold text-secondary mb-1">
                                Select Student <span class="text-danger">*</span>
                            </label>
                            <select name="studentId" id="studentSelect" class="form-select" required>
                                <option value="">-- Choose an available student --</option>
                                @if (Model.AvailableStudents.Count == 0)
                                {
                                    <option value="" disabled="disabled">All active students are already enrolled</option>
                                }
                                else
                                {
                                    @foreach (var student in Model.AvailableStudents)
                                    {
                                        <option value="@student.Id">
                                            @student.FullName (@(student.UniversityId ?? student.Email))
                                        </option>
                                    }
                                }
                            </select>
                            <div class="form-text small text-muted mt-1">Students already enrolled in this course are excluded from the list.</div>
                        </div>
                    </div>

                    <div class="modal-footer border-top p-3 bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary-aub px-4 shadow-sm" @(Model.AvailableStudents.Count == 0 ? "disabled" : "")>
                            <i class="bi bi-check-lg me-1"></i> Enroll Student
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- 2. SAFE REMOVE ENROLLMENT CONFIRMATION MODAL                 -->
    <!-- ============================================================ -->
    <div class="modal fade" id="removeStudentEnrollmentModal" tabindex="-1" aria-labelledby="removeStudentEnrollmentModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header border-bottom py-3 px-4 bg-danger-subtle">
                    <h5 class="modal-title fw-bold text-danger mb-0" id="removeStudentEnrollmentModalTitle">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i> Remove Enrollment?
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form asp-controller="Enrollment" asp-action="Unenroll" method="post" id="removeStudentEnrollmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="enrollmentId" id="courseRemoveModalEnrollmentId" value="" />
                    <input type="hidden" name="courseId" value="@Model.CourseId" />
                    <input type="hidden" name="studentId" id="courseRemoveModalStudentId" value="" />
                    <input type="hidden" name="returnUrl" value="/Enrollment/CourseStudents?courseId=@Model.CourseId" />

                    <div class="modal-body p-4">
                        <p class="mb-3">Are you sure you want to remove:</p>
                        <div class="p-3 bg-light border rounded-3 mb-3">
                            <div class="fw-bold text-dark fs-6" id="courseRemoveModalStudentName">Student Name</div>
                            <div class="small text-muted mt-1">From course: <strong class="text-primary">@Model.CourseTitle</strong></div>
                        </div>

                        <div class="alert alert-warning py-2 px-3 small mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-shield-lock-fill fs-5 text-warning"></i>
                            <div>
                                <strong>Academic Protection Guard:</strong> If this student has recorded learning progress, quiz submissions, or assignments, removal will be blocked to preserve student academic history.
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top p-3 bg-light">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger px-4 shadow-sm">
                            <i class="bi bi-trash me-1"></i> Remove Enrollment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const removeButtons = document.querySelectorAll('.remove-student-enrollment-btn');
                const removeModalEl = document.getElementById('removeStudentEnrollmentModal');
                const removeModal = removeModalEl ? new bootstrap.Modal(removeModalEl) : null;

                removeButtons.forEach(btn => {
                    btn.addEventListener('click', function () {
                        const enrollmentId = this.getAttribute('data-id');
                        const studentName = this.getAttribute('data-student-name');
                        const studentId = this.getAttribute('data-student-id');

                        document.getElementById('courseRemoveModalEnrollmentId').value = enrollmentId;
                        document.getElementById('courseRemoveModalStudentId').value = studentId;
                        document.getElementById('courseRemoveModalStudentName').textContent = studentName;

                        if (removeModal) {
                            removeModal.show();
                        }
                    });
                });
            });
        </script>
    }
}

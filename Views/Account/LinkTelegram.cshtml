@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Link Telegram Account";
    var linkUrl = ViewBag.LinkUrl as string ?? "https://t.me/AUBLinkBot";
    var plainToken = ViewBag.PlainToken as string ?? "";
    var studentName = ViewBag.StudentName as string ?? "User";
    var universityId = ViewBag.UniversityId as string ?? "";
    var userId = ViewBag.UserId as string ?? "";
}

<div class="auth-card-inner" id="linkTelegramRoot" data-user-id="@userId">
    @* ── Header ────────────────────────────────────────────────────────────── *@
    <div class="auth-form-header mb-4 text-start">
        <div class="d-inline-flex align-items-center gap-2 px-2.5 py-1 rounded-pill bg-primary bg-opacity-10 text-primary small fw-semibold mb-2">
            <i class="bi bi-shield-lock-fill"></i>
            <span>Required 2FA Security</span>
        </div>
        <h2 class="auth-heading text-aub-navy fw-bold mb-1">Pair Telegram Account</h2>
        <p class="auth-subheading text-secondary small mb-0">
            AUB Digital Academy requires Telegram Two-Factor Authentication to access all accounts.
        </p>
    </div>

    @* ── User Context Badge ───────────────────────────────────────────────── *@
    <div class="p-3 mb-3 rounded-3 bg-light border border-light-subtle d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-2.5">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 38px; height: 38px;">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="lh-sm">
                <span class="d-block fw-semibold text-aub-navy small">@studentName</span>
                <span class="text-secondary font-monospace" style="font-size: 0.8rem;">ID: @universityId</span>
            </div>
        </div>
        <span class="badge bg-warning bg-opacity-15 text-warning-emphasis rounded-pill px-2.5 py-1 small" id="linkStatusBadge">
            <i class="bi bi-hourglass-split me-1"></i> Awaiting Link
        </span>
    </div>

    @* ── Instructions Card ────────────────────────────────────────────────── *@
    <div class="card border border-info border-opacity-25 bg-info bg-opacity-10 rounded-3 p-3 mb-4">
        <div class="d-flex gap-3">
            <div class="text-info fs-4 flex-shrink-0">
                <i class="bi bi-info-circle-fill"></i>
            </div>
            <div class="small">
                <div class="fw-bold mb-1 text-info-emphasis">How to link your Telegram:</div>
                <ol class="ps-3 mb-0 text-secondary">
                    <li>Click the <b>"Open in Telegram"</b> button below.</li>
                    <li>In Telegram, press <b>START</b> to pair your profile.</li>
                    <li>This page will automatically advance once paired.</li>
                </ol>
            </div>
        </div>
    </div>

    @* ── Direct Action Button ─────────────────────────────────────────────── *@
    <div class="d-grid gap-2 mb-3">
        <a href="@linkUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg rounded-3 py-2.5 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm">
            <i class="bi bi-telegram fs-5"></i>
            <span>Open in Telegram (&#64;AUBLinkBot)</span>
        </a>
    </div>

    @* ── Manual Token Option ──────────────────────────────────────────────── *@
    <div class="text-center mb-4">
        <div class="text-muted small mb-1">Or send this command manually to <b>&#64;AUBLinkBot</b>:</div>
        <div class="input-group input-group-sm">
            <input type="text" class="form-control text-center font-monospace bg-light" id="manualCommandInput" value="/link @plainToken" readonly>
            <button class="btn btn-outline-secondary" type="button" id="copyManualCommandBtn">
                Copy
            </button>
        </div>
    </div>

    @* ── Progress Indicator & Back to Login ──────────────────────────────── *@
    <div class="d-flex align-items-center justify-content-between pt-2 border-top">
        <div class="d-flex align-items-center gap-2 text-muted small">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span>Listening for connection...</span>
        </div>
        <a asp-controller="Account" asp-action="Login" class="text-decoration-none text-muted small">
            Cancel
        </a>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var copyBtn = document.getElementById('copyManualCommandBtn');
            var cmdInput = document.getElementById('manualCommandInput');
            if (copyBtn && cmdInput) {
                copyBtn.addEventListener('click', function() {
                    navigator.clipboard.writeText(cmdInput.value);
                    copyBtn.textContent = 'Copied!';
                    setTimeout(function() { copyBtn.textContent = 'Copy'; }, 2000);
                });
            }

            var rootEl = document.getElementById('linkTelegramRoot');
            var userId = rootEl ? (rootEl.getAttribute('data-user-id') || '') : '';
            if (!userId) return;

            var checkInterval = setInterval(function() {
                fetch('/Account/CheckTelegramLinkStatus?userId=' + encodeURIComponent(userId))
                    .then(function(res) { return res.json(); })
                    .then(function(data) {
                        if (data && data.linked) {
                            clearInterval(checkInterval);
                            var badge = document.getElementById('linkStatusBadge');
                            if (badge) {
                                badge.className = 'badge bg-success bg-opacity-15 text-success rounded-pill px-2.5 py-1 small';
                                badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Linked!';
                            }
                            setTimeout(function() {
                                window.location.href = '/Account/VerifyTelegram?userId=' + encodeURIComponent(userId);
                            }, 1000);
                        }
                    })
                    .catch(function(err) {
                        console.warn('Poll error:', err);
                    });
            }, 2500);
        })();
    </script>
}

@model AUBDigitalAcademy.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}

<div class="pe-xl-5 auth-fade-in">
    <h2 class="fw-bold mb-2 text-navy" style="font-size: 2.25rem; letter-spacing: -0.5px;">Verify &amp; Set New Password</h2>
    <p class="text-secondary mb-4 fs-6">Enter the single-use 6-digit code sent to your linked Telegram account and choose a new password.</p>

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info py-2 px-3 mb-3 small rounded-3" role="alert">
            @TempData["InfoMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning py-2 px-3 mb-3 small rounded-3" role="alert">
            @TempData["ErrorMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger py-2 px-3 mb-3 small rounded-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"
         role="alert"></div>

    <form asp-action="ResetPassword" asp-controller="Account" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Code" class="form-label fw-medium text-dark mb-2 fs-6">Telegram Verification Code</label>
            <div class="input-group auth-input-group">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary">
                    <i class="bi bi-telegram fs-5"></i>
                </span>
                <input asp-for="Code"
                       class="form-control border-start-0 ps-1 py-2 fs-5 font-monospace shadow-none"
                       placeholder="6-digit code"
                       maxlength="10"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       required
                       autofocus />
            </div>
            <span asp-validation-for="Code" class="text-danger small mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label fw-medium text-dark mb-2 fs-6">New Password</label>
            <div class="input-group auth-input-group">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary">
                    <i class="bi bi-lock fs-5"></i>
                </span>
                <input asp-for="NewPassword" class="form-control border-start-0 border-end-0 px-1 py-2 fs-6 shadow-none" placeholder="Enter new password" autocomplete="new-password" required />
                <button class="btn btn-outline-secondary border-start-0 bg-white text-secondary pe-3 toggle-pwd" type="button" style="border-color: var(--bs-border-color);">
                    <i class="bi bi-eye-slash fs-5"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block fw-medium"></span>
        </div>

        <div class="mb-4">
            <label asp-for="ConfirmPassword" class="form-label fw-medium text-dark mb-2 fs-6">Confirm Password</label>
            <div class="input-group auth-input-group">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary">
                    <i class="bi bi-shield-lock fs-5"></i>
                </span>
                <input asp-for="ConfirmPassword" class="form-control border-start-0 border-end-0 px-1 py-2 fs-6 shadow-none" placeholder="Confirm your new password" autocomplete="new-password" required />
                <button class="btn btn-outline-secondary border-start-0 bg-white text-secondary pe-3 toggle-pwd" type="button" style="border-color: var(--bs-border-color);">
                    <i class="bi bi-eye-slash fs-5"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block fw-medium"></span>
        </div>

        <button type="submit" class="btn btn-primary-aub w-100 py-3 mb-3 rounded-3 fs-6 fw-medium shadow-sm transition-all">
            Reset Password
        </button>
    </form>

    <div class="d-flex align-items-center justify-content-between pt-3 border-top">
        <form asp-action="ResendPasswordResetCode" asp-controller="Account" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-decoration-none text-secondary p-0 small">
                <i class="bi bi-arrow-clockwise me-1"></i>Resend Code
            </button>
        </form>

        <form asp-action="CancelPasswordReset" asp-controller="Account" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-decoration-none text-secondary p-0 small">
                Back to Sign In
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('.toggle-pwd').forEach(btn => {
            btn.addEventListener('click', function() {
                const input = this.previousElementSibling;
                const icon = this.querySelector('i');
                const type = input.getAttribute('type') === 'password' ? 'text' : 'password';
                input.setAttribute('type', type);
                icon.classList.toggle('bi-eye');
                icon.classList.toggle('bi-eye-slash');
            });
        });
    </script>
}

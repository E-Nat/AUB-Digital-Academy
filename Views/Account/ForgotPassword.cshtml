@model AUBDigitalAcademy.Models.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-form-section">
    <h2 class="auth-form-title">Forgot Password</h2>
    <p class="auth-form-subtitle">Enter your email address and we'll send you a link to reset your password.</p>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="mb-4">
            <label asp-for="Email" class="form-label"></label>
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                <input asp-for="Email" class="form-control" placeholder="Enter your email address" autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary-aub w-100 mb-3">
            <i class="bi bi-send me-2"></i>Send Reset Link
        </button>

        <div class="text-center">
            <a href="@Url.Action("Login", "Auth")" class="auth-link">
                <i class="bi bi-arrow-left me-1"></i>Back to Login
            </a>
        </div>
    </form>
</div>


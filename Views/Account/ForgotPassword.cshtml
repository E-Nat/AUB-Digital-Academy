@model AUBDigitalAcademy.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="pe-xl-5 auth-fade-in">
    <div class="mb-4">
        <a href="@Url.Action("Login", "Account")" class="text-secondary text-decoration-none d-flex align-items-center gap-2 hover-navy mb-4" style="width: fit-content;">
            <i class="bi bi-arrow-left"></i>
            <span class="fw-medium">Back to Login</span>
        </a>
    </div>

    <h2 class="fw-bold mb-2 text-navy" style="font-size: 2.25rem; letter-spacing: -0.5px;">Reset Password</h2>
    <p class="text-secondary mb-4 fs-6">Enter your student ID or university email to begin account recovery.</p>

    <form asp-action="ForgotPassword" asp-controller="Account" method="post">
        
        <div class="mb-4">
            <label asp-for="Email" class="form-label fw-semibold text-dark mb-2 small">Student ID or University Email</label>
            <div class="input-group auth-input-group">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary">
                    <i class="bi bi-person fs-5"></i>
                </span>
                <input asp-for="Email" class="form-control border-start-0 ps-1 py-2 fs-6 shadow-none" placeholder="Enter your student ID or university email" required autofocus />
            </div>
            <span asp-validation-for="Email" class="text-danger small mt-1 d-block fw-medium"></span>
        </div>

        <button type="submit" class="btn btn-primary-aub w-100 py-3 mb-3 rounded-3 fs-6 fw-medium shadow-sm transition-all">
            <span>Send Reset Instructions</span>
            <i class="bi bi-arrow-right ms-1"></i>
        </button>
        
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100 py-3 rounded-3 fs-6 fw-medium transition-all">
            Cancel
        </a>
    </form>
</div>

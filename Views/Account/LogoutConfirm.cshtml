@{
    ViewData["Title"] = "Logout Confirmation";
    Layout = "_AuthLayout";
}

<div class="pe-xl-5 auth-fade-in d-flex flex-column justify-content-center h-100 text-center pb-5">
    
    <div class="mb-4 mx-auto bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
        <i class="bi bi-box-arrow-right text-danger" style="font-size: 3rem;"></i>
    </div>
    
    <h2 class="fw-bold mb-3 text-navy" style="font-size: 2.25rem; letter-spacing: -0.5px;">Logout?</h2>
    
    <p class="text-secondary mb-5 mx-auto" style="max-width: 320px; font-size: 1rem; line-height: 1.6;">
        Are you sure you want to sign out of AUB Digital Academy?
    </p>

    <div class="d-flex flex-column gap-3 mx-auto w-100" style="max-width: 400px;">
        <form asp-action="Logout" asp-controller="Account" method="post" class="w-100">
            <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fs-6 fw-medium shadow-sm transition-all">
                Logout
            </button>
        </form>
        
        <button type="button" onclick="history.back()" class="btn btn-outline-secondary w-100 py-3 rounded-3 fs-6 fw-medium transition-all">
            Cancel
        </button>
    </div>
</div>

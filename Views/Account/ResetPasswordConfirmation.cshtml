@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = "_AuthLayout";
}

<div class="pe-xl-5 auth-fade-in d-flex flex-column justify-content-center h-100 text-center pb-5">
    
    <div class="mb-4 mx-auto success-icon-container">
        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
    </div>
    
    <h2 class="fw-bold mb-3 text-navy" style="font-size: 2.25rem; letter-spacing: -0.5px;">Password Reset Successful</h2>
    
    <p class="text-secondary mb-5 mx-auto" style="max-width: 320px; font-size: 1rem; line-height: 1.6;">
        Your password has been successfully changed. You can now use your new password to sign in to your account.
    </p>

    <div class="mx-auto w-100" style="max-width: 400px;">
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary-aub w-100 py-3 rounded-3 fs-6 fw-medium shadow-sm transition-all">
            Back to Login
        </a>
    </div>
</div>

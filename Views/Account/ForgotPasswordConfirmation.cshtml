@{
    ViewData["Title"] = "Check Your Email";
    Layout = "_AuthLayout";
}

<div class="pe-xl-5 auth-fade-in d-flex flex-column justify-content-center h-100 text-center pb-5">
    
    <div class="mb-4 mx-auto bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
        <i class="bi bi-envelope-check text-primary" style="font-size: 3rem;"></i>
    </div>
    
    <h2 class="fw-bold mb-3 text-navy" style="font-size: 2.25rem; letter-spacing: -0.5px;">Check Your Email</h2>
    
    <p class="text-secondary mb-5 mx-auto" style="max-width: 320px; font-size: 1rem; line-height: 1.6;">
        We have sent a password reset link to your email address. Please check your inbox and spam folders.
    </p>

    <div class="d-flex flex-column gap-3 mx-auto w-100" style="max-width: 400px;">
        <a href="https://mail.google.com" target="_blank" class="btn btn-primary-aub w-100 py-3 rounded-3 fs-6 fw-medium shadow-sm transition-all">
            Open Email App
        </a>
        
        <a href="@Url.Action("Login", "Account")" class="btn btn-outline-secondary w-100 py-3 rounded-3 fs-6 fw-medium transition-all">
            Back to Login
        </a>
    </div>
</div>

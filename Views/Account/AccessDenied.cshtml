@{
    ViewData["Title"] = "Access Denied";
    Layout = "_AuthLayout";
}

<div class="auth-form-section text-center">
    <div class="mb-4">
        <i class="bi bi-shield-exclamation" style="font-size: 4rem; color: #dc3545;"></i>
    </div>
    <h2 class="auth-form-title">Access Denied</h2>
    <p class="auth-form-subtitle">You do not have permission to access this page. Please contact the administrator if you believe this is an error.</p>

    <div class="d-flex gap-2 justify-content-center mt-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Go Back
        </a>
        <a href="/" class="btn btn-primary-aub">
            <i class="bi bi-house me-1"></i>Home
        </a>
    </div>
</div>

@model AUBDigitalAcademy.Models.ViewModels.LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Sign In";
    Layout = "_AuthLayout";

    // Google OAuth is only available when real client credentials are configured.
    var googleClientId = Configuration["Authentication:Google:ClientId"];
    var googleClientSecret = Configuration["Authentication:Google:ClientSecret"];
    bool googleConfigured = !string.IsNullOrWhiteSpace(googleClientId) && !string.IsNullOrWhiteSpace(googleClientSecret);
}

<div id="loginView" class="auth-fade-in w-100">

    @* Mobile University Brand Header (< 992px) *@
    <div class="d-flex d-lg-none align-items-center gap-3 mb-4 pb-3 border-bottom">
        <div class="auth-mobile-logo-icon" aria-hidden="true">
            <i class="bi bi-mortarboard-fill text-gold"></i>
        </div>
        <div>
            <div class="fw-bold text-navy fs-5 lh-1">AUB Digital Academy</div>
            <span class="text-secondary small">University Gateway</span>
        </div>
    </div>

    @* Global Success & Info Alerts *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2.5 px-3 rounded-3" role="alert">
            <i class="bi bi-check-circle-fill flex-shrink-0"></i>
            <div class="small fw-medium">@TempData["SuccessMessage"]</div>
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3 py-2.5 px-3 rounded-3" role="alert">
            <i class="bi bi-info-circle-fill flex-shrink-0"></i>
            <div class="small">@TempData["InfoMessage"]</div>
        </div>
    }

    @* Form Header *@
    <div style="margin-bottom: 28px;">
        <h1 class="mb-2" style="font-size: clamp(40px, 2.7vw, 44px); font-weight: 700; letter-spacing: -0.5px; color: #0B1F4D; line-height: 1.2;">Sign In</h1>
        <p class="mb-0" style="font-size: 16px; color: #64748B; line-height: 1.5;">Sign in with your ACLEDA University student account.</p>
    </div>

    @* Credential Login Form *@
    <form id="loginForm" asp-action="Login" asp-controller="Account" method="post" novalidate aria-label="Sign in form">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        @* Server-Side Error Alert *@
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-3 py-2.5 px-3 rounded-3" role="alert" aria-live="polite">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-0.5" aria-hidden="true"></i>
                <div class="small">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        @* Client/AJAX Error Alert *@
        <div id="loginErrorAlert" class="alert alert-danger d-none d-flex align-items-start gap-2 mb-3 py-2.5 px-3 rounded-3" role="alert" aria-live="assertive">
            <i class="bi bi-exclamation-triangle-fill flex-shrink-0 mt-0.5" aria-hidden="true"></i>
            <div class="small flex-grow-1" id="loginErrorMessage">Invalid University ID/Email or password.</div>
            <button type="button" class="btn-close btn-close-sm ms-auto" id="closeErrorBtn" aria-label="Dismiss error notice"></button>
        </div>

        @* ── Identifier: University ID or Email ─────────────────────────── *@
        <div class="mb-3 auth-input-group-container">
            <label asp-for="LoginId" class="auth-input-label" id="loginIdLabel" style="font-size: 15.5px; font-weight: 600; color: #1E293B;">
                Student ID or University Email
            </label>
            <div class="input-group auth-input-group" id="loginIdGroup" style="height: 62px; border-radius: 13px; border: 1.5px solid #CBD5E1;">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary" id="loginIdAddon" aria-hidden="true" style="font-size: 21px;">
                    <i class="bi bi-person"></i>
                </span>
                <input asp-for="LoginId"
                       class="form-control border-start-0 ps-1 py-2 fs-6 shadow-none"
                       placeholder="Enter your student ID or university email"
                       autocomplete="username"
                       autocapitalize="none"
                       spellcheck="false"
                       aria-required="true"
                       aria-describedby="loginIdAddon loginIdValidation"
                       style="height: 58px; font-size: 16px;"
                       required />
            </div>
            <span asp-validation-for="LoginId" class="text-danger small mt-1 d-block fw-medium" id="loginIdValidation"></span>
        </div>

        @* ── Password Field with Visibility Toggle ───────────────────────── *@
        <div class="mb-3 auth-input-group-container">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label asp-for="Password" class="auth-input-label mb-0" id="passwordLabel" style="font-size: 15.5px; font-weight: 600; color: #1E293B;">
                    Password
                </label>
                <a asp-action="ForgotPassword" asp-controller="Account"
                   class="text-decoration-none fw-semibold" style="font-size: 14.5px; color: #0861E9;">
                    Forgot password?
                </a>
            </div>
            <div class="input-group auth-input-group" id="passwordGroup" style="height: 62px; border-radius: 13px; border: 1.5px solid #CBD5E1;">
                <span class="input-group-text bg-white border-end-0 ps-3 pe-2 text-secondary" id="passwordAddon" aria-hidden="true" style="font-size: 21px;">
                    <i class="bi bi-lock"></i>
                </span>
                <input asp-for="Password"
                       class="form-control border-start-0 border-end-0 px-1 py-2 fs-6 shadow-none"
                       placeholder="Enter your password"
                       autocomplete="current-password"
                       aria-required="true"
                       aria-describedby="passwordAddon passwordValidation"
                       style="height: 58px; font-size: 16px;"
                       required />
                <button class="btn btn-outline-secondary border-start-0 bg-white text-secondary pe-3 auth-pass-toggle-btn"
                        type="button"
                        id="togglePassword"
                        aria-label="Show password"
                        aria-pressed="false"
                        title="Toggle password visibility">
                    <i class="bi bi-eye-slash fs-5" aria-hidden="true"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small mt-1 d-block fw-medium" id="passwordValidation"></span>
        </div>

        @* ── Remember Me Checkbox ───────────────────────────────────────── *@
        <div class="d-flex align-items-center mb-4">
            <div class="form-check custom-checkbox mb-0 d-flex align-items-center gap-2">
                <input asp-for="RememberMe"
                       class="form-check-input shadow-none cursor-pointer"
                       id="rememberMeCheck"
                       style="width: 20px; height: 20px;" />
                <label asp-for="RememberMe"
                       class="form-check-label text-secondary cursor-pointer ms-1"
                       for="rememberMeCheck"
                       style="font-size: 15px; color: #475569;">
                    Keep me signed in on this device
                </label>
            </div>
        </div>

        @* ── Sign In Primary Action Button ──────────────────────────────── *@
        <button type="submit"
                id="btnSignIn"
                class="btn w-100 mb-3 fw-bold d-flex justify-content-center align-items-center gap-2"
                style="height: 66px; background-color: #0861E9; color: #FFFFFF; border-radius: 14px; font-size: 17.5px; box-shadow: 0 4px 14px rgba(8, 97, 233, 0.28);"
                aria-label="Sign in to your account">
            <span id="btnSignInText">Sign In to Workspace</span>
            <i class="bi bi-arrow-right" id="btnSignInArrow" aria-hidden="true"></i>
            <div class="spinner-border spinner-border-sm d-none" id="signInSpinner" role="status" aria-hidden="true">
                <span class="visually-hidden">Signing in…</span>
            </div>
        </button>

        @* ── New Student Activation Link ───────────────────────────────────── *@
        <div class="text-center mb-3">
            <span class="text-secondary" style="font-size: 15px;">New student?</span>
            <a href="/pages/authentication/activate-account.html" class="text-decoration-none fw-semibold ms-1" style="color: #0861E9; font-size: 15px;" id="activateAccountLink">
                Activate Your Account
            </a>
        </div>
    </form>

    @* ── Helpdesk Footer ────────────────────────────────────────────────── *@
    <div class="text-center pt-3 text-secondary" style="font-size: 14.5px;">
        <span>Need help accessing your account? <a href="mailto:it.support@aub.edu.kh" class="text-decoration-none fw-semibold" style="color: #0861E9;">Contact IT Support.</a></span>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/login.js" asp-append-version="true"></script>
}

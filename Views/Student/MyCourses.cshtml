@model AUBDigitalAcademy.Models.ViewModels.StudentMyCoursesViewModel
@{
    ViewData["Title"] = "My Enrolled Courses";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Student/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Courses</li>
        </ol>
    </nav>

    <!-- Page Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold text-dark mb-0">My Enrolled Courses</h1>
                <span class="badge bg-primary rounded-pill">@Model.TotalCourses</span>
            </div>
            <p class="text-muted small mb-0">Access course materials, syllabus structure, and active curriculum modules.</p>
        </div>
    </div>

    @if (Model.TotalCourses == 0)
    {
        <!-- Clean Empty State -->
        <div class="card border rounded-3 p-5 text-center bg-white shadow-sm my-4">
            <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center mx-auto mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-journal-x fs-1 text-secondary opacity-50"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">You are not enrolled in any courses yet.</h4>
            <p class="text-muted small mb-4 mx-auto" style="max-width: 480px;">
                Your student profile currently has no registered academic courses for this semester.
                Please contact the university academic administration or your faculty advisor to process your course registrations.
            </p>
            <div>
                <a href="/Student/Dashboard" class="btn btn-outline-secondary btn-sm shadow-sm">
                    <i class="bi bi-arrow-left me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Real Enrolled Courses Grid -->
        <div class="student-course-grid mb-4">
            @foreach (var course in Model.Courses)
            {
                <div class="student-course-card">
                    <div class="student-course-card-header">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-white text-dark font-monospace">@course.CourseCode</span>
                            <span class="badge bg-light text-dark opacity-75 small">@course.SemesterName</span>
                        </div>
                        <h5 class="fw-bold text-white mb-0" title="@course.CourseTitle">@course.CourseTitle</h5>
                    </div>
                    <div class="student-course-card-body">
                        <div class="small text-muted mb-2">
                            <i class="bi bi-person-video3 me-1 text-primary"></i> Instructor: <strong>@course.TeacherName</strong>
                        </div>
                        <div class="small text-muted mb-3">
                            <i class="bi bi-bookmark me-1 text-secondary"></i> Major: @course.MajorName
                        </div>
                        <p class="small text-secondary mb-0 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(course.Description) ? "No description provided for this course." : course.Description)
                        </p>
                        <div class="mt-3 pt-2 border-top">
                            <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span class="fw-bold text-dark">@course.ProgressPercentage%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(course.ProgressPercentage == 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @course.ProgressPercentage%;" aria-valuenow="@course.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                @course.CompletedLessons of @course.TotalLessons lessons completed
                            </div>
                        </div>
                    </div>
                    <div class="student-course-card-footer">
                        <span class="small text-muted">
                            <i class="bi bi-calendar-check me-1"></i> Enrolled @course.EnrolledAt.ToString("MMM dd, yyyy")
                        </span>
                        <a href="/Student/Course/@course.CourseId" class="btn btn-primary-aub btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                            <span>Open Course</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

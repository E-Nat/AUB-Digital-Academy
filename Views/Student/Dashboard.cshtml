@model AUBDigitalAcademy.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Student Dashboard";
    ViewData["ActivePage"] = "Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Welcome Header Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #003366 0%, #004080 100%); color: white;">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 56px; height: 56px; background: rgba(255,255,255,0.2); font-size: 1.5rem;">
                        @(string.IsNullOrEmpty(Model.StudentName) ? "S" : Model.StudentName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h2 class="fw-bold mb-1 text-white">Welcome back, @Model.StudentName!</h2>
                        <div class="d-flex align-items-center gap-3 small" style="color: rgba(255,255,255,0.85);">
                            <span><i class="bi bi-card-text me-1"></i> ID: <strong>@(Model.UniversityId ?? "N/A")</strong></span>
                            <span><i class="bi bi-envelope me-1"></i> @Model.StudentEmail</span>
                            <span><i class="bi bi-journal-bookmark me-1"></i> <strong>@Model.EnrolledCoursesCount</strong> Active Enrolled Courses</span>
                        </div>
                    </div>
                </div>
                <div>
                    <a href="/Student/Courses" class="btn btn-light d-inline-flex align-items-center gap-2 shadow-sm text-primary fw-semibold">
                        <i class="bi bi-book-fill"></i>
                        <span>Go to My Courses</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background:#EFF6FF; color:#2563EB; font-size: 1.25rem;">
                    <i class="bi bi-journal-check"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-bold">Enrolled Courses</div>
                    <div class="fs-4 fw-bold text-dark">@Model.EnrolledCoursesCount</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background:#ECFDF5; color:#059669; font-size: 1.25rem;">
                    <i class="bi bi-check2-circle"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-bold">Completed Lessons</div>
                    <div class="fs-4 fw-bold text-success">@Model.CompletedLessonsCount</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background:#FEF3C7; color:#D97706; font-size: 1.25rem;">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-bold">Current Term</div>
                    <div class="fs-6 fw-bold text-dark text-truncate" style="max-width: 140px;" title="@Model.CurrentTermName">@Model.CurrentTermName</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="card border rounded-3 p-3 bg-white shadow-sm d-flex flex-row align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; background:#F5F3FF; color:#7C3AED; font-size: 1.25rem;">
                    <i class="bi bi-mortarboard"></i>
                </div>
                <div>
                    <div class="small text-muted text-uppercase fw-bold">Academic Status</div>
                    <div class="fs-6 fw-bold text-success">Active Standing</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section: My Enrolled Courses -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-0">My Enrolled Courses</h4>
            <p class="text-muted small mb-0">Current academic courses assigned to your student profile.</p>
        </div>
        @if (Model.EnrolledCoursesCount > 0)
        {
            <a href="/Student/Courses" class="btn btn-outline-primary btn-sm d-inline-flex align-items-center gap-1">
                <span>View All (@Model.EnrolledCoursesCount)</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        }
    </div>

    @if (Model.EnrolledCoursesCount == 0)
    {
        <!-- Empty State -->
        <div class="card border rounded-3 p-5 text-center bg-white shadow-sm">
            <i class="bi bi-journal-x fs-1 d-block mb-3 text-secondary opacity-50"></i>
            <h5 class="fw-bold text-dark mb-1">You are not enrolled in any courses yet.</h5>
            <p class="text-muted small mb-0">Please contact your academic administrator or faculty advisor to register for courses.</p>
        </div>
    }
    else
    {
        <div class="student-course-grid mb-4">
            @foreach (var course in Model.EnrolledCourses)
            {
                <div class="student-course-card">
                    <div class="student-course-card-header">
                        <span class="badge bg-white text-dark font-monospace mb-2">@course.CourseCode</span>
                        <h5 class="fw-bold text-white mb-0 text-truncate" title="@course.CourseTitle">@course.CourseTitle</h5>
                    </div>
                    <div class="student-course-card-body">
                        <div class="small text-muted mb-2">
                            <i class="bi bi-person-video3 me-1 text-primary"></i> Instructor: <strong>@course.TeacherName</strong>
                        </div>
                        <div class="small text-muted mb-2">
                            <i class="bi bi-bookmark me-1"></i> Major: @course.MajorName
                        </div>
                        <div class="small text-muted mb-3">
                            <i class="bi bi-calendar3 me-1"></i> Term: @course.SemesterName
                        </div>
                        <p class="small text-secondary mb-0 line-clamp-2">
                            @(string.IsNullOrWhiteSpace(course.Description) ? "No description provided for this course." : course.Description)
                        </p>
                        <div class="mt-3 pt-2 border-top">
                            <div class="d-flex align-items-center justify-content-between small text-muted mb-1">
                                <span>Progress</span>
                                <span class="fw-bold text-dark">@course.ProgressPercentage%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar @(course.ProgressPercentage == 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @course.ProgressPercentage%;" aria-valuenow="@course.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="small text-muted mt-1" style="font-size: 0.75rem;">
                                @course.CompletedLessons of @course.TotalLessons lessons completed
                                @if (course.TotalVideoLessons > 0)
                                {
                                    <span> &bull; Video: @course.CompletedVideoLessons/@course.TotalVideoLessons (@course.VideoProgressPercentage%)</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="student-course-card-footer">
                        <span class="small text-muted">
                            <i class="bi bi-clock-history me-1"></i> @course.EnrolledAt.ToString("MMM dd, yyyy")
                        </span>
                        <a href="/Student/Course/@course.CourseId" class="btn btn-primary-aub btn-sm d-inline-flex align-items-center gap-1 shadow-sm">
                            <span>Open Course</span>
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

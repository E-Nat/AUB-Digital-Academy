@model AUBDigitalAcademy.Models.ViewModels.StudentAssignmentViewModel
@{
    ViewData["Title"] = $"{Model.Title} - {Model.CourseTitle}";
    ViewData["ActivePage"] = "Courses";
}

@section Styles {
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Student/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Student/Courses" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item"><a href="/Student/Course/@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Top Action Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #003366 0%, #004080 100%); color: white;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-white text-dark font-monospace">@Model.CourseCode</span>
                        <span class="badge bg-light text-dark opacity-75">Module @Model.ModulePosition: @Model.ModuleTitle</span>
                        <span class="badge bg-warning text-dark"><i class="bi bi-file-earmark-arrow-up me-1"></i>Assignment</span>
                        <span class="badge bg-info-subtle text-info border border-info-subtle">Max Score: @Model.MaxScore pts</span>
                        @if (Model.HasSubmission && Model.LatestStatus == AUBDigitalAcademy.Models.Enums.SubmissionStatus.Graded)
                        {
                            <span class="badge bg-success text-white"><i class="bi bi-check-circle-fill me-1"></i>Graded</span>
                        }
                    </div>
                    <h3 class="fw-bold mb-0 text-white">@Model.Title</h3>
                </div>
                <div>
                    <a href="/Student/Course/@Model.CourseId" class="btn btn-light d-inline-flex align-items-center gap-2 shadow-sm text-primary fw-semibold">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Course Overview</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Main Content Row -->
    <div class="row g-4">
        <!-- Left Column: Assignment Details, Submission Status, Submission Form, History -->
        <div class="col-lg-8">
            <!-- Assignment Instructions Card -->
            <div class="card border rounded-3 bg-white shadow-sm mb-4">
                <div class="card-header bg-light py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <h5 class="fw-bold mb-0 text-dark">Assignment Instructions</h5>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Due Date:</span>
                        <span class="badge @(Model.IsPastDue ? "bg-danger" : "bg-primary") px-3 py-2">
                            <i class="bi bi-calendar-event me-1"></i>
                            @Model.DueDate.ToString("MMM dd, yyyy · HH:mm") UTC
                        </span>
                        @if (Model.IsPastDue)
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Past Due (Late submissions allowed)</span>
                        }
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrWhiteSpace(Model.Instruction))
                    {
                        <div class="text-secondary mb-3" style="white-space: pre-line; line-height: 1.6;">
                            @Model.Instruction
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-0">No specific written instructions provided for this assignment.</p>
                    }
                </div>
            </div>

            <!-- Current Submission Status Card (if submitted) -->
            @if (Model.HasSubmission)
            {
                <div class="card border rounded-3 bg-white shadow-sm mb-4">
                    <div class="card-header bg-light py-3 border-bottom d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clipboard-check-fill text-success fs-5"></i>
                            <h5 class="fw-bold mb-0 text-dark">Latest Submission Status (Attempt #@Model.LatestAttemptNumber)</h5>
                        </div>
                        <span class="text-muted small">Submitted: @Model.LatestSubmittedAt?.ToString("MMM dd, yyyy · HH:mm")</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-sm-6 col-md-3">
                                <label class="text-muted text-xs text-uppercase fw-bold d-block">Status</label>
                                @if (Model.LatestStatus == AUBDigitalAcademy.Models.Enums.SubmissionStatus.Graded)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle fs-6 px-3 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i>Graded
                                    </span>
                                }
                                else if (Model.LatestStatus == AUBDigitalAcademy.Models.Enums.SubmissionStatus.Late)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle fs-6 px-3 py-1">
                                        <i class="bi bi-clock-history me-1"></i>Submitted Late
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle fs-6 px-3 py-1">
                                        <i class="bi bi-hourglass-split me-1"></i>Under Review
                                    </span>
                                }
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <label class="text-muted text-xs text-uppercase fw-bold d-block">Score</label>
                                @if (Model.LatestScore.HasValue)
                                {
                                    <span class="fw-bold fs-5 text-dark">@Model.LatestScore.Value / @Model.MaxScore</span>
                                    double pct = Math.Round((Model.LatestScore.Value / Model.MaxScore) * 100, 1);
                                    <span class="badge @(pct >= 50 ? "bg-success" : "bg-danger") ms-1">@pct%</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Pending evaluation</span>
                                }
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <label class="text-muted text-xs text-uppercase fw-bold d-block">Submitted File / Link</label>
                                @if (!string.IsNullOrEmpty(Model.LatestFileUrl))
                                {
                                    @if (Model.LatestFileUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || Model.LatestFileUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@Model.LatestFileUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mt-1">
                                            <i class="bi bi-box-arrow-up-right me-1"></i>Open External Link
                                        </a>
                                    }
                                    else
                                    {
                                        <a href="/Student/Assignment/Download/@Model.LatestSubmissionId" class="btn btn-sm btn-outline-primary mt-1">
                                            <i class="bi bi-download me-1"></i>@(Model.LatestOriginalFileName ?? "Download File")
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">Text response only</span>
                                }
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <label class="text-muted text-xs text-uppercase fw-bold d-block">Evaluated By</label>
                                <span class="text-dark small">@(Model.LatestGradedByName ?? "Instructor/TA")</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.LatestTextResponse))
                        {
                            <div class="mt-3 p-3 bg-light rounded-3 border">
                                <strong class="small text-muted d-block mb-1">Your Submission Notes / Response:</strong>
                                <p class="small mb-0 text-dark" style="white-space: pre-line;">@Model.LatestTextResponse</p>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.LatestFeedback))
                        {
                            <div class="mt-3 p-3 bg-success-subtle rounded-3 border border-success-subtle">
                                <strong class="small text-success d-block mb-1"><i class="bi bi-chat-quote-fill me-1"></i>Instructor Feedback:</strong>
                                <p class="small mb-0 text-dark" style="white-space: pre-line;">@Model.LatestFeedback</p>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Submission / Resubmission Form Card -->
            <div class="card border rounded-3 bg-white shadow-sm mb-4">
                <div class="card-header bg-light py-3 border-bottom d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-cloud-arrow-up-fill text-primary fs-5"></i>
                        <h5 class="fw-bold mb-0 text-dark">@(Model.HasSubmission ? "Submit a New Attempt (Resubmission)" : "Turn In Assignment")</h5>
                    </div>
                    @if (Model.HasSubmission)
                    {
                        <span class="badge bg-secondary">Next Attempt: #@(Model.LatestAttemptNumber + 1)</span>
                    }
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Student" asp-action="SubmitAssignment" method="post" enctype="multipart/form-data" id="assignmentSubmitForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="courseId" value="@Model.CourseId" />
                        <input type="hidden" name="courseItemId" value="@Model.CourseItemId" />

                        <div class="alert alert-info border-info-subtle small mb-4">
                            <i class="bi bi-info-circle me-1"></i>
                            <strong>Submission Policy:</strong> You can upload a file (PDF, ZIP, DOCX up to 10MB), provide an external URL (GitHub, Google Drive), or enter written response notes. Resubmissions are allowed; all attempts are preserved.
                        </div>

                        <!-- Submission Methods -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-file-earmark-arrow-up me-1 text-primary"></i>Upload Submission File (Optional)
                            </label>
                            <input type="file" name="submissionFile" class="form-control" accept=".pdf,.zip,.docx,application/pdf,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
                            <div class="form-text text-muted small">Supported formats: PDF, ZIP, DOCX. Maximum file size: 10 MB.</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-link-45deg me-1 text-primary"></i>External URL (Optional)
                            </label>
                            <input type="url" name="externalUrl" class="form-control" placeholder="https://github.com/your-username/repository or https://drive.google.com/..." />
                            <div class="form-text text-muted small">Must start with http:// or https://. Direct links to GitHub repositories or cloud documents.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">
                                <i class="bi bi-card-text me-1 text-primary"></i>Written Response / Student Notes (Optional)
                            </label>
                            <textarea name="textResponse" rows="4" class="form-control" placeholder="Type or paste your written answers, implementation notes, or comments for the instructor..."></textarea>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                            <span class="text-muted small">
                                @if (Model.IsPastDue)
                                {
                                    <span class="text-danger"><i class="bi bi-exclamation-triangle me-1"></i>Submitting after due date will be marked as Late.</span>
                                }
                                else
                                {
                                    <span>Due in: @Model.DueDate.ToString("MMM dd, yyyy")</span>
                                }
                            </span>
                            <button type="submit" class="btn btn-primary px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 shadow-sm">
                                <i class="bi bi-send-fill"></i>
                                <span>@(Model.HasSubmission ? "Submit New Attempt" : "Submit Assignment")</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Submission History (if multiple attempts) -->
            @if (Model.SubmissionHistory != null && Model.SubmissionHistory.Count > 1)
            {
                <div class="card border rounded-3 bg-white shadow-sm mb-4">
                    <div class="card-header bg-light py-3 border-bottom">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-clock-history text-secondary fs-5"></i>
                            <h5 class="fw-bold mb-0 text-dark">Submission History (@Model.SubmissionHistory.Count Attempts)</h5>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 text-sm">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Attempt</th>
                                        <th>Submitted At</th>
                                        <th>Content</th>
                                        <th>Status</th>
                                        <th>Score</th>
                                        <th class="pe-4">Feedback</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attempt in Model.SubmissionHistory.OrderByDescending(a => a.AttemptNumber))
                                    {
                                        <tr class="@(attempt.IsLatest ? "table-light fw-medium" : "")">
                                            <td class="ps-4">
                                                <span class="badge @(attempt.IsLatest ? "bg-primary" : "bg-secondary") rounded-pill">
                                                    Attempt #@attempt.AttemptNumber
                                                </span>
                                                @if (attempt.IsLatest)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle text-xs ms-1">Active</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="text-xs text-muted">@attempt.SubmittedAt.ToString("MMM dd, yyyy · HH:mm")</div>
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(attempt.FileUrl))
                                                {
                                                    @if (attempt.FileUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || attempt.FileUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
                                                    {
                                                        <a href="@attempt.FileUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-info rounded-pill px-2 py-0 text-xs">Link</a>
                                                    }
                                                    else
                                                    {
                                                        <a href="/Student/Assignment/Download/@attempt.SubmissionId" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0 text-xs">
                                                            <i class="bi bi-download"></i> File
                                                        </a>
                                                    }
                                                }
                                                @if (!string.IsNullOrEmpty(attempt.TextResponse))
                                                {
                                                    <span class="text-muted text-xs text-truncate d-inline-block ms-1" style="max-width: 120px;" title="@attempt.TextResponse">
                                                        @attempt.TextResponse
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                @if (attempt.Status == AUBDigitalAcademy.Models.Enums.SubmissionStatus.Graded)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Graded</span>
                                                }
                                                else if (attempt.Status == AUBDigitalAcademy.Models.Enums.SubmissionStatus.Late)
                                                {
                                                    <span class="badge bg-danger-subtle text-danger">Late</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning">Submitted</span>
                                                }
                                            </td>
                                            <td>
                                                @if (attempt.Score.HasValue)
                                                {
                                                    <span class="fw-bold text-dark">@attempt.Score / @attempt.MaxScore</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted text-xs">--</span>
                                                }
                                            </td>
                                            <td class="pe-4 text-xs text-muted text-truncate" style="max-width: 160px;" title="@attempt.Feedback">
                                                @(attempt.Feedback ?? "--")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Curriculum Navigation Sidebar -->
        <div class="col-lg-4">
            <div class="card border rounded-3 bg-white shadow-sm overflow-hidden sticky-lg-top" style="top: 1.5rem; z-index: 10;">
                <div class="p-3 border-bottom bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-collection-play-fill text-primary"></i>
                            <h6 class="fw-bold mb-0 text-dark">Course Curriculum</h6>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                            @Model.CompletedLessonsCount/@Model.TotalLessonsCount Completed
                        </span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.CourseProgressPercentage)%;" aria-valuenow="@Model.CourseProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="p-3" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    @if (Model.Modules.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">
                            No modules in this course.
                        </div>
                    }
                    else
                    {
                        <div class="accordion" id="curriculumPlayerAccordion">
                            @foreach (var mod in Model.Modules.OrderBy(m => m.Position))
                            {
                                var collapseId = $"collapsePlayerMod{mod.ModuleId}";
                                var headingId = $"headingPlayerMod{mod.ModuleId}";
                                var isExpanded = mod.IsCurrentModule;

                                <div class="player-module-card mb-2">
                                    <div class="player-module-header @(isExpanded ? "active-module" : "")" id="@headingId">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1 me-2 text-truncate">
                                            <span class="badge @(isExpanded ? "bg-primary text-white" : "bg-light text-dark border") rounded-pill px-2 py-1 small">
                                                M@mod.Position
                                            </span>
                                            <span class="fw-semibold text-dark text-truncate small" title="@mod.Title">
                                                @mod.Title
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="small text-muted" style="font-size: 0.75rem;">@mod.CompletedCount/@mod.LessonCount</span>
                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId">
                                                <i class="bi bi-chevron-down small"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="@collapseId" class="collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId">
                                        @if (mod.Lessons.Count == 0)
                                        {
                                            <div class="p-2 text-muted small text-center fst-italic">
                                                No items in this module.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var item in mod.Lessons.OrderBy(l => l.Position))
                                            {
                                                string itemUrl = item.Type switch
                                                {
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Quiz => $"/Student/Course/{Model.CourseId}/Quiz/{item.CourseItemId}",
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Assignment => $"/Student/Course/{Model.CourseId}/Assignment/{item.CourseItemId}",
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Book => $"/Student/Course/{Model.CourseId}/Book/{item.CourseItemId}",
                                                    _ => $"/Student/Course/{Model.CourseId}/Lesson/{item.CourseItemId}"
                                                };

                                                <a href="@itemUrl"
                                                   class="player-lesson-link d-flex align-items-center gap-2 text-decoration-none @(item.IsCurrent ? "current-lesson" : "")"
                                                   title="@item.Title"
                                                   data-item-id="@item.CourseItemId">
                                                    @if (item.IsCompleted || item.HasPassedQuiz)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0" title="Completed"></i>
                                                    }
                                                    else if (item.IsCurrent)
                                                    {
                                                        <i class="bi bi-arrow-right-circle-fill text-primary fs-6 flex-shrink-0" title="Current"></i>
                                                    }
                                                    else if (item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Quiz)
                                                    {
                                                        <i class="bi bi-patch-question-fill text-warning fs-6 flex-shrink-0" title="Quiz"></i>
                                                    }
                                                    else if (item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Assignment)
                                                    {
                                                        <i class="bi bi-file-earmark-arrow-up-fill text-info fs-6 flex-shrink-0" title="Assignment"></i>
                                                    }
                                                    else if (item.Type == AUBDigitalAcademy.Models.Enums.ItemType.Book)
                                                    {
                                                        <i class="bi bi-book-fill text-secondary fs-6 flex-shrink-0" title="Book"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle text-secondary opacity-50 fs-6 flex-shrink-0" title="Lesson"></i>
                                                    }

                                                    <div class="flex-grow-1 text-truncate">
                                                        <div class="small fw-medium @(item.IsCurrent ? "text-primary fw-bold" : "text-dark") text-truncate">
                                                            @item.Title
                                                        </div>
                                                        <span class="text-muted" style="font-size: 0.75rem;">
                                                            @item.Type.ToString() @item.Position
                                                        </span>
                                                    </div>

                                                    @if (item.IsCurrent)
                                                    {
                                                        <span class="badge bg-primary text-white rounded-pill px-2 py-0 text-xs">Active</span>
                                                    }
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

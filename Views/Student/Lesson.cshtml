@model AUBDigitalAcademy.Models.ViewModels.StudentLessonPlayerViewModel
@inject AUBDigitalAcademy.Services.Interfaces.IHtmlSanitizationService HtmlSanitizer
@{
    ViewData["Title"] = $"{Model.LessonTitle} - {Model.CourseTitle}";
    ViewData["ActivePage"] = "Courses";

    string? safeVideoUrl = HtmlSanitizer.SanitizeResourceUrl(Model.VideoUrl);
    string? safeContentHtml = HtmlSanitizer.SanitizeLessonHtml(Model.ContentHtml);
    bool hasSafeVideo = !string.IsNullOrEmpty(safeVideoUrl);
    bool hasSafeContent = !string.IsNullOrEmpty(safeContentHtml);

    // Helper to extract YouTube video embed URL
    string? youtubeEmbedUrl = null;
    if (hasSafeVideo)
    {
        var match = System.Text.RegularExpressions.Regex.Match(
            safeVideoUrl!,
            @"(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=))([\w-]{11})",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (match.Success)
        {
            youtubeEmbedUrl = $"https://www.youtube-nocookie.com/embed/{match.Groups[1].Value}";
        }
    }

    bool isDirectVideoFile = hasSafeVideo &&
        (safeVideoUrl!.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
         safeVideoUrl.EndsWith(".webm", StringComparison.OrdinalIgnoreCase) ||
         safeVideoUrl.EndsWith(".ogg", StringComparison.OrdinalIgnoreCase));

}

@section Styles {
    <link rel="stylesheet" href="~/css/student.css" asp-append-version="true" />
}

<div class="container-fluid p-0">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/Student/Dashboard" class="text-decoration-none">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="/Student/Courses" class="text-decoration-none">My Courses</a></li>
            <li class="breadcrumb-item"><a href="/Student/Course/@Model.CourseId" class="text-decoration-none">@Model.CourseTitle</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.LessonTitle</li>
        </ol>
    </nav>

    <!-- Lesson Top Action Banner -->
    <div class="card border-0 shadow-sm rounded-3 mb-4 overflow-hidden" style="background: linear-gradient(135deg, #003366 0%, #004080 100%); color: white;">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-white text-dark font-monospace">@Model.CourseCode</span>
                        <span class="badge bg-light text-dark opacity-75">Module @Model.ModulePosition: @Model.ModuleTitle</span>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Lesson @Model.CurrentLessonIndex of @Model.TotalLessonsCount</span>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Course Progress: <span class="course-progress-pct">@Model.CourseProgressPercentage%</span></span>
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success text-white" id="headerCompletedBadge"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                        }
                    </div>
                    <h3 class="fw-bold mb-0 text-white">@Model.LessonTitle</h3>
                </div>
                <div>
                    <a href="/Student/Course/@Model.CourseId" class="btn btn-light d-inline-flex align-items-center gap-2 shadow-sm text-primary fw-semibold">
                        <i class="bi bi-grid-3x3-gap"></i>
                        <span>Course Overview</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Lesson Player Content Row -->
    <div class="row g-4">
        <!-- Left / Center Column: Video & Lesson Content -->
        <div class="col-lg-8">
            @if (Model.IsLocked)
            {
                <div class="alert alert-warning border border-warning shadow-sm mb-4 d-flex align-items-start gap-3 p-3 rounded-3" role="alert">
                    <div class="fs-3 text-warning flex-shrink-0"><i class="bi bi-lock-fill"></i></div>
                    <div>
                        <h5 class="fw-bold text-dark mb-1">This Lesson is Locked</h5>
                        <p class="small text-muted mb-2">
                            This course enforces <strong>Sequential Access</strong>. You must complete the required prerequisite item(s) below before you can complete this lesson:
                        </p>
                        <ul class="mb-0 small fw-semibold text-dark">
                            @foreach (var prereq in Model.MissingPrerequisites)
                            {
                                <li><i class="bi bi-arrow-right-short text-warning"></i> @prereq</li>
                            }
                        </ul>
                    </div>
                </div>
            }

            <!-- Video Player Section (Rendered only when a safe VideoUrl exists) -->
            @if (hasSafeVideo)
            {
                <div class="card border rounded-3 bg-dark text-white shadow-sm mb-4 overflow-hidden">
                    <div class="card-body p-0">
                        @if (!string.IsNullOrEmpty(youtubeEmbedUrl))
                        {
                            <div class="ratio ratio-16x9">
                                <iframe src="@youtubeEmbedUrl" title="@Model.LessonTitle" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                            </div>
                        }
                        else if (isDirectVideoFile)
                        {
                            <div class="p-2 bg-black">
                                <video id="lessonVideoPlayer" controls class="w-100 rounded" style="max-height: 500px;" preload="metadata">
                                    <source src="@safeVideoUrl" />
                                    Your browser does not support the video tag.
                                </video>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-center bg-dark">
                                <i class="bi bi-camera-reels text-warning fs-1 d-block mb-3"></i>
                                <h5 class="fw-bold text-white mb-2">Video Lecture Available</h5>
                                <p class="text-secondary small mb-3">This lesson includes an external streaming video resource.</p>
                                <a href="@safeVideoUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm px-4">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Open Video Resource
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Lesson Notes & Reading Content Section -->
            <div class="card border rounded-3 p-4 bg-white shadow-sm mb-4">
                <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                    <h5 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-book text-primary"></i>
                        <span>Lecture Content & Notes</span>
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        @if (Model.IsCompleted)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle">
                                <i class="bi bi-check-circle-fill text-success me-1"></i> Completed
                            </span>
                        }
                        @if (hasSafeVideo)
                        {
                            <span class="badge bg-light text-muted border" id="videoWatchProgressBadge">
                                <i class="bi bi-play-circle text-primary me-1"></i> Watched: @Model.VideoQualifyingPercentage%
                            </span>
                        }
                    </div>
                </div>

                <div class="lesson-content-body">
                    @if (hasSafeContent)
                    {
                        @Html.Raw(safeContentHtml)
                    }
                    else
                    {
                        <div class="text-muted p-4 text-center border rounded-3 bg-light">
                            <i class="bi bi-journal-text fs-3 d-block mb-2 text-secondary opacity-50"></i>
                            <p class="mb-0 small">No written lecture notes provided for this lesson.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Bottom Navigation Bar & Completion Controls -->
            <div class="card border rounded-3 p-3 bg-white shadow-sm mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <!-- Previous Button -->
                    @if (Model.HasPrevious && Model.PreviousLesson != null)
                    {
                        <a href="/Student/Course/@Model.CourseId/Lesson/@Model.PreviousLesson.CourseItemId"
                           class="btn btn-outline-primary d-inline-flex align-items-center gap-2"
                           title="@Model.PreviousLesson.Title">
                            <i class="bi bi-arrow-left"></i>
                            <span>Previous Lesson</span>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary opacity-50 d-inline-flex align-items-center gap-2" disabled aria-disabled="true">
                            <i class="bi bi-arrow-left"></i>
                            <span>Previous Lesson</span>
                        </button>
                    }

                    <!-- Center: Mark as Complete / Completed Action -->
                    <div class="d-flex align-items-center gap-2" id="completionActionContainer">
                        @if (Model.IsLocked)
                        {
                            <button type="button" class="btn btn-outline-warning d-inline-flex align-items-center gap-2" disabled aria-disabled="true" title="Locked by course prerequisites">
                                <i class="bi bi-lock-fill"></i>
                                <span>Locked</span>
                            </button>
                        }
                        else if (Model.IsCompleted)
                        {
                            <button type="button" class="btn btn-success d-inline-flex align-items-center gap-2" disabled aria-disabled="true">
                                <i class="bi bi-check-circle-fill"></i>
                                <span>Completed</span>
                            </button>
                        }
                        else
                        {
                            <form asp-controller="Student" asp-action="CompleteLesson" method="post" id="completeLessonForm" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="courseId" value="@Model.CourseId" />
                                <input type="hidden" name="courseItemId" value="@Model.CourseItemId" />
                                <button type="submit" id="btnMarkComplete" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Mark as Complete</span>
                                </button>
                            </form>
                        }
                    </div>

                    <!-- Next Button -->
                    @if (Model.HasNext && Model.NextLesson != null)
                    {
                        <a href="/Student/Course/@Model.CourseId/Lesson/@Model.NextLesson.CourseItemId"
                           class="btn btn-primary d-inline-flex align-items-center gap-2"
                           title="@Model.NextLesson.Title">
                            <span>Next Lesson</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-outline-secondary opacity-50 d-inline-flex align-items-center gap-2" disabled aria-disabled="true">
                            <span>Next Lesson</span>
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    }
                </div>
                <div class="text-center mt-2 pt-2 border-top">
                    <small class="text-muted">
                        Lesson @Model.CurrentLessonIndex of @Model.TotalLessonsCount &bull; Course Progress: <strong class="text-primary course-progress-pct">@Model.CourseProgressPercentage%</strong> (<span class="course-completed-count">@Model.CompletedLessonsCount</span>/@Model.TotalLessonsCount Completed)
                    </small>
                </div>
            </div>
        </div>

        <!-- Lesson Discussions & Q&A (Phase 5B) -->
        <div class="card border-0 shadow-sm rounded-3 mb-4 mt-4" id="discussions">
            <div class="card-header bg-white border-bottom py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-chat-square-text-fill text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Lesson Discussions</h5>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5 py-1">
                        @(Model.Discussions?.Threads?.Count ?? 0) @(Model.Discussions?.Threads?.Count == 1 ? "Question" : "Questions")
                    </span>
                </div>
                @if (Model.Discussions?.CanPostThread == true)
                {
                    <button class="btn btn-sm btn-primary rounded-pill px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                            type="button" data-bs-toggle="collapse" data-bs-target="#askQuestionBox" aria-expanded="false" aria-controls="askQuestionBox">
                        <i class="bi bi-question-circle me-1"></i>
                        <span>Ask a Question</span>
                    </button>
                }
            </div>

            <div class="card-body p-4">
                @if (Model.Discussions?.CanPostThread == true)
                {
                    <!-- Collapsible "Ask a Question" Form -->
                    <div class="collapse mb-4" id="askQuestionBox">
                        <div class="p-3 p-md-4 rounded-3 border bg-light shadow-sm">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Ask a Question about this Lesson</h6>
                            <form id="createDiscussionThreadForm" asp-controller="Discussion" asp-action="CreateThread" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="CourseItemId" value="@Model.CourseItemId" />
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-dark">Question Title <span class="text-danger">*</span></label>
                                    <input type="text" name="Title" class="form-control" placeholder="e.g. Can someone clarify the difference between array and list?" required minlength="3" maxlength="200" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-dark">Details / Context <span class="text-danger">*</span></label>
                                    <textarea name="Content" class="form-control" rows="3" placeholder="Describe what you tried, the timestamp in the video, or what is confusing..." required minlength="3" maxlength="4000"></textarea>
                                </div>
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" data-bs-toggle="collapse" data-bs-target="#askQuestionBox">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                        <i class="bi bi-send me-1"></i> Post Question
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                }

                <!-- Discussion Threads Feed -->
                @if (Model.Discussions == null || Model.Discussions.Threads.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        <h6 class="fw-semibold text-dark mb-1">No questions yet</h6>
                        <p class="small text-muted mb-0">Have a question or thought about this lesson? Be the first to start a discussion!</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3" id="discussionThreadsContainer">
                        @foreach (var thread in Model.Discussions.Threads)
                        {
                            <div class="card border rounded-3 p-3 discussion-thread-card @(thread.IsPinned ? "border-warning bg-warning bg-opacity-10 shadow-sm" : "bg-white")"
                                 id="thread-card-@thread.Id" data-thread-id="@thread.Id">
                                <!-- Thread Header -->
                                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <div class="avatar-circle-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                            @(string.IsNullOrEmpty(thread.AuthorName) ? "U" : thread.AuthorName.Substring(0, 1).ToUpper())
                                        </div>
                                        <div>
                                            <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                <span class="fw-semibold text-dark small">@thread.AuthorName</span>
                                                <span class="badge @(thread.AuthorRole switch { "Teacher" => "bg-primary text-white", "Teaching Assistant" => "bg-info text-dark", "Admin" => "bg-dark text-white", _ => "bg-light text-muted border" }) rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                                                    @thread.AuthorRole
                                                </span>
                                                <span class="text-muted" style="font-size: 0.75rem;">&bull; @thread.CreatedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (thread.IsPinned)
                                        {
                                            <span class="badge bg-warning text-dark border border-warning rounded-pill px-2 py-1" style="font-size: 0.7rem;" id="badge-pin-thread-@thread.Id">
                                                <i class="bi bi-pin-angle-fill me-1"></i>Pinned
                                            </span>
                                        }
                                        @if (thread.IsAnswered)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem;" id="badge-answered-thread-@thread.Id">
                                                <i class="bi bi-check-circle-fill me-1"></i>Answered
                                            </span>
                                        }
                                        @if (thread.IsDeleted)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem;">
                                                <i class="bi bi-shield-slash me-1"></i>Moderated
                                            </span>
                                        }

                                        <!-- Thread Options Dropdown -->
                                        @if (thread.CanModerate || thread.IsAuthor)
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-link text-secondary p-1" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bi bi-three-dots-vertical"></i>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                                    @if (thread.CanModerate)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item btn-toggle-pin-thread" type="button" data-thread-id="@thread.Id">
                                                                <i class="bi bi-pin-angle me-2"></i>@(thread.IsPinned ? "Unpin Question" : "Pin Question")
                                                            </button>
                                                        </li>
                                                    }
                                                    @if (thread.CanModerate || thread.IsAuthor)
                                                    {
                                                        <li>
                                                            <button class="dropdown-item btn-toggle-answered-thread" type="button" data-thread-id="@thread.Id">
                                                                <i class="bi bi-check2-circle me-2"></i>@(thread.IsAnswered ? "Mark as Unanswered" : "Mark as Answered")
                                                            </button>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                        <li>
                                                            <button class="dropdown-item text-danger btn-delete-thread" type="button"
                                                                    data-thread-id="@thread.Id" data-is-moderator="@(thread.CanModerate ? "true" : "false")">
                                                                <i class="bi bi-trash me-2"></i>Delete Question
                                                            </button>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- Thread Body -->
                                <h6 class="fw-bold text-dark mb-1">@thread.Title</h6>
                                @if (thread.IsDeleted)
                                {
                                    <div class="p-2 mb-2 bg-danger-subtle border border-danger-subtle rounded text-danger small">
                                        <i class="bi bi-shield-exclamation me-1"></i>
                                        <strong>Moderated:</strong> @thread.ModerationReason @(thread.DeletedByName != null ? $"by {thread.DeletedByName}" : "")
                                    </div>
                                    <p class="text-secondary small text-decoration-line-through mb-2">@thread.Content</p>
                                }
                                else
                                {
                                    <div class="text-dark small mb-2" style="white-space: pre-wrap;">@Html.Raw(HtmlSanitizer.SanitizeLessonHtml(thread.Content))</div>
                                }

                                <!-- Thread Action Bar (Replies trigger) -->
                                <div class="d-flex align-items-center justify-content-between pt-2 border-top">
                                    <button class="btn btn-sm btn-link text-decoration-none text-muted p-0 d-inline-flex align-items-center gap-1"
                                            type="button" data-bs-toggle="collapse" data-bs-target="#replies-collapse-@thread.Id" aria-expanded="true">
                                        <i class="bi bi-chat-left-text"></i>
                                        <span class="small fw-semibold reply-count-label" id="reply-count-@thread.Id">
                                            @thread.RepliesCount @(thread.RepliesCount == 1 ? "Reply" : "Replies")
                                        </span>
                                    </button>
                                    @if (Model.Discussions.CanReply && !thread.IsDeleted)
                                    {
                                        <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-0.5 text-xs fw-semibold"
                                                type="button" data-bs-toggle="collapse" data-bs-target="#reply-form-@thread.Id">
                                            <i class="bi bi-reply-fill me-1"></i>Reply
                                        </button>
                                    }
                                </div>

                                <!-- Collapsible Replies Area -->
                                <div class="collapse show mt-3" id="replies-collapse-@thread.Id">
                                    <div class="ps-md-3 border-start border-2 border-primary-subtle d-flex flex-column gap-2" id="replies-list-@thread.Id">
                                        @foreach (var reply in thread.Replies)
                                        {
                                            <div class="p-2.5 rounded-3 @(reply.IsPinned ? "bg-warning bg-opacity-10 border border-warning" : "bg-light border")"
                                                 id="reply-card-@reply.Id">
                                                <div class="d-flex align-items-center justify-content-between mb-1">
                                                    <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                        <span class="fw-semibold text-dark text-xs">@reply.AuthorName</span>
                                                        <span class="badge @(reply.AuthorRole switch { "Teacher" => "bg-primary text-white", "Teaching Assistant" => "bg-info text-dark", "Admin" => "bg-dark text-white", _ => "bg-secondary-subtle text-muted" }) rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">
                                                            @reply.AuthorRole
                                                        </span>
                                                        @if (reply.IsInstructorAnswer)
                                                        {
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">
                                                                <i class="bi bi-patch-check-fill me-0.5"></i>Faculty Answer
                                                            </span>
                                                        }
                                                        @if (reply.IsPinned)
                                                        {
                                                            <span class="badge bg-warning text-dark border border-warning rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;" id="badge-pin-reply-@reply.Id">
                                                                <i class="bi bi-pin-angle-fill me-0.5"></i>Pinned Helpful
                                                            </span>
                                                        }
                                                        @if (reply.IsDeleted)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-1.5 py-0.5" style="font-size: 0.6rem;">
                                                                <i class="bi bi-shield-slash me-0.5"></i>Moderated
                                                            </span>
                                                        }
                                                        <span class="text-muted text-xs">&bull; @reply.CreatedAt.ToString("MMM dd, HH:mm")</span>
                                                    </div>
                                                    @if (reply.CanModerate || reply.IsAuthor)
                                                    {
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="dropdown">
                                                                <i class="bi bi-three-dots"></i>
                                                            </button>
                                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm small">
                                                                @if (reply.CanModerate)
                                                                {
                                                                    <li>
                                                                        <button class="dropdown-item btn-toggle-pin-reply" type="button" data-reply-id="@reply.Id">
                                                                            <i class="bi bi-pin-angle me-2"></i>@(reply.IsPinned ? "Unpin Answer" : "Pin as Helpful Answer")
                                                                        </button>
                                                                    </li>
                                                                    <li><hr class="dropdown-divider"></li>
                                                                }
                                                                <li>
                                                                    <button class="dropdown-item text-danger btn-delete-reply" type="button"
                                                                            data-reply-id="@reply.Id" data-is-moderator="@(reply.CanModerate ? "true" : "false")">
                                                                        <i class="bi bi-trash me-2"></i>Delete Reply
                                                                    </button>
                                                                </li>
                                                            </ul>
                                                        </div>
                                                    }
                                                </div>
                                                @if (reply.IsDeleted)
                                                {
                                                    <div class="p-1.5 mb-1 bg-danger-subtle border border-danger-subtle rounded text-danger text-xs">
                                                        <i class="bi bi-shield-exclamation me-1"></i>
                                                        <strong>Moderated:</strong> @reply.ModerationReason @(reply.DeletedByName != null ? $"by {reply.DeletedByName}" : "")
                                                    </div>
                                                    <p class="text-secondary text-xs text-decoration-line-through mb-0">@reply.Content</p>
                                                }
                                                else
                                                {
                                                    <div class="text-dark text-xs mb-0" style="white-space: pre-wrap;">@Html.Raw(HtmlSanitizer.SanitizeLessonHtml(reply.Content))</div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <!-- Reply Input Box -->
                                    @if (Model.Discussions.CanReply && !thread.IsDeleted)
                                    {
                                        <div class="collapse mt-2" id="reply-form-@thread.Id">
                                            <form class="create-reply-form" asp-controller="Discussion" asp-action="CreateReply" method="post" data-thread-id="@thread.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ThreadId" value="@thread.Id" />
                                                <div class="input-group input-group-sm">
                                                    <textarea name="Content" class="form-control" rows="1" placeholder="Write a constructive reply..." required maxlength="4000"></textarea>
                                                    <button type="submit" class="btn btn-primary fw-semibold px-3">
                                                        <i class="bi bi-send-fill me-1"></i> Reply
                                                    </button>
                                                </div>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Right Column: Course Curriculum Sidebar Navigation -->
        <div class="col-lg-4">
            <div class="card border rounded-3 bg-white shadow-sm overflow-hidden sticky-lg-top" style="top: 1.5rem; z-index: 10;">
                <div class="p-3 border-bottom bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-collection-play-fill text-primary"></i>
                            <h6 class="fw-bold mb-0 text-dark">Course Curriculum</h6>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">
                            <span class="course-completed-count">@Model.CompletedLessonsCount</span>/@Model.TotalLessonsCount Completed
                        </span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success course-progress-bar" role="progressbar" style="width: @(Model.CourseProgressPercentage)%;" aria-valuenow="@Model.CourseProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div class="p-3" style="max-height: calc(100vh - 200px); overflow-y: auto;">
                    @if (Model.Modules.Count == 0)
                    {
                        <div class="p-4 text-center text-muted small">
                            No modules in this course.
                        </div>
                    }
                    else
                    {
                        <div class="accordion" id="curriculumPlayerAccordion">
                            @foreach (var mod in Model.Modules.OrderBy(m => m.Position))
                            {
                                var collapseId = $"collapsePlayerMod{mod.ModuleId}";
                                var headingId = $"headingPlayerMod{mod.ModuleId}";
                                var isExpanded = mod.IsCurrentModule;

                                <div class="player-module-card mb-2">
                                    <div class="player-module-header @(isExpanded ? "active-module" : "")" id="@headingId">
                                        <div class="d-flex align-items-center gap-2 flex-grow-1 me-2 text-truncate">
                                            <span class="badge @(isExpanded ? "bg-primary text-white" : "bg-light text-dark border") rounded-pill px-2 py-1 small">
                                                M@mod.Position
                                            </span>
                                            <span class="fw-semibold text-dark text-truncate small" title="@mod.Title">
                                                @mod.Title
                                            </span>
                                        </div>
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="small text-muted" style="font-size: 0.75rem;">@mod.CompletedCount/@mod.LessonCount</span>
                                            <button class="btn btn-sm btn-link text-secondary p-0" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="@(isExpanded ? "true" : "false")" aria-controls="@collapseId">
                                                <i class="bi bi-chevron-down small"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div id="@collapseId" class="collapse @(isExpanded ? "show" : "")" aria-labelledby="@headingId">
                                        @if (mod.Lessons.Count == 0)
                                        {
                                            <div class="p-2 text-muted small text-center fst-italic">
                                                No lessons in this module.
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var lesson in mod.Lessons.OrderBy(l => l.Position))
                                            {
                                                var isQuiz = lesson.Type == AUBDigitalAcademy.Models.Enums.ItemType.Quiz;
                                                var isAssignment = lesson.Type == AUBDigitalAcademy.Models.Enums.ItemType.Assignment;
                                                var isBook = lesson.Type == AUBDigitalAcademy.Models.Enums.ItemType.Book;

                                                string itemUrl = lesson.Type switch
                                                {
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Quiz => $"/Student/Course/{Model.CourseId}/Quiz/{lesson.CourseItemId}",
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Assignment => $"/Student/Course/{Model.CourseId}/Assignment/{lesson.CourseItemId}",
                                                    AUBDigitalAcademy.Models.Enums.ItemType.Book => $"/Student/Course/{Model.CourseId}/Book/{lesson.CourseItemId}",
                                                    _ => $"/Student/Course/{Model.CourseId}/Lesson/{lesson.CourseItemId}"
                                                };

                                                <a href="@(lesson.IsLocked ? "javascript:void(0)" : itemUrl)"
                                                   class="player-lesson-link d-flex align-items-center gap-2 text-decoration-none @(lesson.IsCurrent ? "current-lesson" : "") @(lesson.IsLocked ? "opacity-50" : "")"
                                                   title="@(lesson.IsLocked ? $"Locked. Prerequisites: {string.Join(", ", lesson.MissingPrerequisites)}" : lesson.Title)"
                                                   data-item-id="@lesson.CourseItemId">
                                                    @if (lesson.IsLocked)
                                                    {
                                                        <i class="bi bi-lock-fill text-warning fs-6 flex-shrink-0" title="Locked by prerequisites"></i>
                                                    }
                                                    else if (lesson.IsCompleted || lesson.HasPassedQuiz)
                                                    {
                                                        <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0" title="Completed"></i>
                                                    }
                                                    else if (lesson.IsCurrent)
                                                    {
                                                        <i class="bi bi-arrow-right-circle-fill text-primary fs-6 flex-shrink-0" title="Current"></i>
                                                    }
                                                    else if (isQuiz)
                                                    {
                                                        <i class="bi bi-patch-question-fill text-warning fs-6 flex-shrink-0" title="Quiz"></i>
                                                    }
                                                    else if (isAssignment)
                                                    {
                                                        <i class="bi bi-file-earmark-arrow-up-fill text-info fs-6 flex-shrink-0" title="Assignment"></i>
                                                    }
                                                    else if (isBook)
                                                    {
                                                        <i class="bi bi-book-fill text-secondary fs-6 flex-shrink-0" title="Book"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-circle text-secondary opacity-50 fs-6 flex-shrink-0" title="Not Completed"></i>
                                                    }

                                                    <div class="flex-grow-1 text-truncate">
                                                        <div class="small fw-medium @(lesson.IsCurrent ? "text-primary fw-bold" : (lesson.IsLocked ? "text-muted" : "text-dark")) text-truncate">
                                                            @lesson.Title
                                                        </div>
                                                        <span class="text-muted" style="font-size: 0.75rem;">
                                                            @lesson.Type.ToString() @lesson.Position
                                                        </span>
                                                    </div>

                                                    @if (lesson.IsLocked)
                                                    {
                                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1 flex-shrink-0" style="font-size: 0.65rem;">
                                                            <i class="bi bi-lock-fill text-warning me-0.5"></i> Locked
                                                        </span>
                                                    }
                                                    else if (lesson.IsCurrent)
                                                    {
                                                        <span class="badge bg-primary text-white rounded-pill px-2 py-1 flex-shrink-0" style="font-size: 0.65rem;">
                                                            ▶ Current
                                                        </span>
                                                    }
                                                    else if (lesson.IsCompleted || lesson.HasPassedQuiz)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 flex-shrink-0 badge-completed" style="font-size: 0.65rem;">
                                                            ✓ @(isQuiz ? "Passed" : "Completed")
                                                        </span>
                                                    }
                                                    else if (isQuiz)
                                                    {
                                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill px-2 py-1 flex-shrink-0" style="font-size: 0.65rem;">
                                                            Quiz
                                                        </span>
                                                    }
                                                </a>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('completeLessonForm')?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const form = this;
            const btn = document.getElementById('btnMarkComplete');
            if (!btn || btn.disabled) return;

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Saving...';

            try {
                const formData = new FormData(form);
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        // Replace form with Completed button
                        const container = document.getElementById('completionActionContainer');
                        if (container) {
                            container.innerHTML = '<button type="button" class="btn btn-success d-inline-flex align-items-center gap-2" disabled aria-disabled="true"><i class="bi bi-check-circle-fill"></i><span>Completed</span></button>';
                        }

                        // Add badge to header if not present
                        if (!document.getElementById('headerCompletedBadge')) {
                            const badge = document.createElement('span');
                            badge.id = 'headerCompletedBadge';
                            badge.className = 'badge bg-success text-white';
                            badge.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>Completed';
                            document.querySelector('.card-body .d-flex.align-items-center.gap-2')?.appendChild(badge);
                        }

                        // Update progress indicators on page
                        if (data.progressPercentage !== undefined) {
                            document.querySelectorAll('.course-progress-pct').forEach(el => el.textContent = data.progressPercentage + '%');
                            document.querySelectorAll('.course-progress-bar').forEach(el => {
                                el.style.width = data.progressPercentage + '%';
                                el.setAttribute('aria-valuenow', data.progressPercentage);
                            });
                            document.querySelectorAll('.course-completed-count').forEach(el => el.textContent = data.completedLessons);
                        }

                        // Update current lesson icon & badge in sidebar
                        const currentLessonEl = document.querySelector('.player-lesson-link.current-lesson');
                        if (currentLessonEl) {
                            const icon = currentLessonEl.querySelector('i');
                            if (icon) {
                                icon.className = 'bi bi-check-circle-fill text-success fs-6 flex-shrink-0';
                            }
                            if (!currentLessonEl.querySelector('.badge-completed')) {
                                const badge = document.createElement('span');
                                badge.className = 'badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1 flex-shrink-0 badge-completed';
                                badge.style.fontSize = '0.65rem';
                                badge.textContent = '✓ Completed';
                                currentLessonEl.appendChild(badge);
                            }
                        }
                        return;
                    }
                }
            } catch (err) {
                console.error('AJAX completion error, falling back to full post:', err);
            }
            form.submit();
        });

        // Phase 5A: HTML5 Video Anti-Seek Watch Tracking (>=90%) & Resume
        (function () {
            const video = document.getElementById('lessonVideoPlayer');
            if (!video) return;

            const resumePos = @Model.LastVideoPositionSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const heartbeatUrl = '/Student/Course/@Model.CourseId/Lesson/@Model.CourseItemId/VideoHeartbeat';
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const antiForgeryToken = tokenInput ? tokenInput.value : '';

            let lastStableTime = 0;
            let pendingStart = null;
            let pendingEnd = null;
            let isSeeking = false;
            let lastSentAt = 0;

            video.addEventListener('loadedmetadata', function () {
                if (resumePos > 0 && video.duration > 2 && resumePos < video.duration - 1) {
                    video.currentTime = resumePos;
                    lastStableTime = resumePos;
                }
            });

            video.addEventListener('seeking', function () {
                isSeeking = true;
                pendingStart = null;
                pendingEnd = null;
            });

            video.addEventListener('seeked', function () {
                isSeeking = false;
                lastStableTime = video.currentTime;
            });

            async function sendHeartbeat(isAdvance) {
                if (!video.duration || isNaN(video.duration)) return;
                const segStart = isAdvance && pendingStart !== null ? pendingStart : 0;
                const segEnd = isAdvance && pendingEnd !== null ? pendingEnd : 0;
                pendingStart = null;
                pendingEnd = null;
                lastSentAt = Date.now();

                const body = new URLSearchParams({
                    currentPositionSeconds: video.currentTime.toFixed(2),
                    videoDurationSeconds: video.duration.toFixed(2),
                    segmentStartSeconds: segStart.toFixed(2),
                    segmentEndSeconds: segEnd.toFixed(2),
                    isPlaybackAdvance: isAdvance ? 'true' : 'false'
                });

                try {
                    const res = await fetch(heartbeatUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'RequestVerificationToken': antiForgeryToken
                        },
                        body: body.toString()
                    });
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.success) {
                        const badge = document.getElementById('videoWatchProgressBadge');
                        if (badge && data.watchedPercentage !== undefined) {
                            badge.innerHTML = `<i class="bi bi-play-circle text-primary me-1"></i> Watched: ${data.watchedPercentage}%`;
                        }
                        if (data.isCompleted) {
                            const container = document.getElementById('completionActionContainer');
                            if (container) {
                                container.innerHTML = '<button type="button" class="btn btn-success d-inline-flex align-items-center gap-2" disabled aria-disabled="true"><i class="bi bi-check-circle-fill"></i><span>Completed</span></button>';
                            }
                        }
                    }
                } catch (e) {
                    console.warn('Video heartbeat error:', e);
                }
            }

            video.addEventListener('timeupdate', function () {
                if (isSeeking || video.paused) return;
                const nowPos = video.currentTime;
                const delta = nowPos - lastStableTime;
                if (delta > 0 && delta <= 4.0) {
                    if (pendingStart === null) pendingStart = lastStableTime;
                    pendingEnd = nowPos;
                } else if (delta > 4.0 || delta < 0) {
                    pendingStart = null;
                    pendingEnd = null;
                }
                lastStableTime = nowPos;

                if (Date.now() - lastSentAt >= 4000) {
                    sendHeartbeat(pendingStart !== null && pendingEnd !== null);
                }
            });

            video.addEventListener('pause', () => sendHeartbeat(pendingStart !== null && pendingEnd !== null));
            video.addEventListener('ended', () => sendHeartbeat(pendingStart !== null && pendingEnd !== null));
        })();

        // Phase 5B: Lesson Discussions & Moderation Interactive Scripting
        (function () {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const antiForgeryToken = tokenInput ? tokenInput.value : '';

            // Pin / Unpin Thread
            document.querySelectorAll('.btn-toggle-pin-thread').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const threadId = this.dataset.threadId;
                    const body = new URLSearchParams({ threadId: threadId });
                    try {
                        const res = await fetch('/Discussion/TogglePinThread', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': antiForgeryToken,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            window.location.hash = 'thread-card-' + threadId;
                            window.location.reload();
                        } else {
                            alert(data.message || 'Failed to update pin state.');
                        }
                    } catch (e) {
                        console.error('Error toggling pin state:', e);
                    }
                });
            });

            // Mark / Unmark Answered
            document.querySelectorAll('.btn-toggle-answered-thread').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const threadId = this.dataset.threadId;
                    const body = new URLSearchParams({ threadId: threadId });
                    try {
                        const res = await fetch('/Discussion/ToggleAnsweredThread', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': antiForgeryToken,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            window.location.hash = 'thread-card-' + threadId;
                            window.location.reload();
                        } else {
                            alert(data.message || 'Failed to update answered state.');
                        }
                    } catch (e) {
                        console.error('Error toggling answered state:', e);
                    }
                });
            });

            // Pin / Unpin Reply
            document.querySelectorAll('.btn-toggle-pin-reply').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const replyId = this.dataset.replyId;
                    const body = new URLSearchParams({ replyId: replyId });
                    try {
                        const res = await fetch('/Discussion/TogglePinReply', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': antiForgeryToken,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            window.location.reload();
                        } else {
                            alert(data.message || 'Failed to update reply pin state.');
                        }
                    } catch (e) {
                        console.error('Error toggling reply pin state:', e);
                    }
                });
            });

            // Delete Thread (Author or Moderator)
            document.querySelectorAll('.btn-delete-thread').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const threadId = this.dataset.threadId;
                    const isModerator = this.dataset.isModerator === 'true';

                    let reason = '';
                    if (isModerator) {
                        reason = prompt('Enter moderation reason (optional):', 'Violates community guidelines') || '';
                    } else {
                        if (!confirm('Are you sure you want to delete this question?')) return;
                    }

                    const body = new URLSearchParams({ id: threadId, reason: reason });
                    try {
                        const res = await fetch('/Discussion/DeleteThread', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': antiForgeryToken,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            window.location.reload();
                        } else {
                            alert(data.message || 'Failed to delete question.');
                        }
                    } catch (e) {
                        console.error('Error deleting thread:', e);
                    }
                });
            });

            // Delete Reply (Author or Moderator)
            document.querySelectorAll('.btn-delete-reply').forEach(btn => {
                btn.addEventListener('click', async function () {
                    const replyId = this.dataset.replyId;
                    const isModerator = this.dataset.isModerator === 'true';

                    let reason = '';
                    if (isModerator) {
                        reason = prompt('Enter moderation reason (optional):', 'Inappropriate or unhelpful comment') || '';
                    } else {
                        if (!confirm('Are you sure you want to delete this reply?')) return;
                    }

                    const body = new URLSearchParams({ id: replyId, reason: reason });
                    try {
                        const res = await fetch('/Discussion/DeleteReply', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/x-www-form-urlencoded',
                                'RequestVerificationToken': antiForgeryToken,
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body.toString()
                        });
                        const data = await res.json();
                        if (res.ok && data.success) {
                            window.location.reload();
                        } else {
                            alert(data.message || 'Failed to delete reply.');
                        }
                    } catch (e) {
                        console.error('Error deleting reply:', e);
                    }
                });
            });
        })();
    </script>
}

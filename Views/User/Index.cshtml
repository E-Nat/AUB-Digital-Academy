@model IEnumerable<AUBDigitalAcademy.Models.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User Management";
    var currentRole = ViewData["CurrentRole"]?.ToString() ?? "All";
    var currentSearch = ViewData["CurrentSearch"]?.ToString() ?? "";
    var currentStatus = ViewData["CurrentStatus"]?.ToString() ?? "All";
    var counts = ViewBag.Counts as AUBDigitalAcademy.Models.ViewModels.UserCountsViewModel 
        ?? new AUBDigitalAcademy.Models.ViewModels.UserCountsViewModel();
    var hasActiveFilters = !string.IsNullOrEmpty(currentSearch) || currentRole != "All" || currentStatus != "All";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <style>
        .user-nav-tabs .nav-link {
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--aub-gray-600, #6c757d);
            border: none;
            border-bottom: 2px solid transparent;
            padding: 0.65rem 1.1rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.15s ease-in-out;
            background: transparent;
        }
        .user-nav-tabs .nav-link:hover {
            color: var(--aub-navy, #003366);
            border-bottom-color: var(--aub-gray-300, #dee2e6);
        }
        .user-nav-tabs .nav-link.active {
            color: var(--aub-navy, #003366);
            border-bottom-color: var(--aub-navy, #003366);
            background: transparent;
        }
        .user-stat-card {
            border: 1px solid #E2E8F0;
            border-radius: 10px;
            background: #FFFFFF;
            padding: 14px 18px;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .user-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
        }
    </style>
}

<div class="container-fluid px-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2 py-1 rounded-pill">
                    <i class="bi bi-shield-lock-fill me-1"></i> Identity & Access
                </span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-1">User Management</h1>
            <p class="text-muted mb-0">Centralized directory of system administrators, faculty instructors, and registered students.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 shadow-sm rounded-3">
                <i class="bi bi-person-plus-fill"></i>
                <span class="fw-semibold">Add New User</span>
            </a>
        </div>
    </div>

    <!-- Summary KPI Cards (Backed by Real Database Counts) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Total Accounts</span>
                    <i class="bi bi-people text-secondary fs-5"></i>
                </div>
                <div class="h3 fw-bold text-dark mb-0">@counts.TotalUsers</div>
                <span class="text-muted" style="font-size: 0.78rem;">All registered identities</span>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Students</span>
                    <i class="bi bi-mortarboard text-success fs-5"></i>
                </div>
                <div class="h3 fw-bold text-success mb-0">@counts.TotalStudents</div>
                <span class="text-muted" style="font-size: 0.78rem;">Enrolled learners</span>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Faculty / Teachers</span>
                    <i class="bi bi-person-badge text-primary fs-5"></i>
                </div>
                <div class="h3 fw-bold text-primary mb-0">@counts.TotalTeachers</div>
                <span class="text-muted" style="font-size: 0.78rem;">Instructors &amp; creators</span>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Teaching Assistants</span>
                    <i class="bi bi-person-workspace text-indigo fs-5" style="color: #4338ca;"></i>
                </div>
                <div class="h3 fw-bold mb-0" style="color: #4338ca;">@counts.TotalAssistants</div>
                <span class="text-muted" style="font-size: 0.78rem;">Course support staff</span>
            </div>
        </div>
        <div class="col-6 col-md-6 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Administrators</span>
                    <i class="bi bi-shield-check text-purple fs-5" style="color: #6b21a8;"></i>
                </div>
                <div class="h3 fw-bold mb-0" style="color: #6b21a8;">@counts.TotalAdmins</div>
                <span class="text-muted" style="font-size: 0.78rem;">System controllers</span>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl">
            <div class="user-stat-card">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-muted small fw-medium">Active Status</span>
                    <i class="bi bi-check-circle text-success fs-5"></i>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <div class="h3 fw-bold text-dark mb-0">@counts.ActiveUsers</div>
                    <span class="text-muted small">/ @counts.TotalUsers active</span>
                </div>
                @if (counts.InactiveUsers > 0)
                {
                    <span class="text-danger fw-medium" style="font-size: 0.78rem;">@counts.InactiveUsers deactivated account@(counts.InactiveUsers > 1 ? "s" : "")</span>
                }
                else
                {
                    <span class="text-success fw-medium" style="font-size: 0.78rem;">100% accounts operational</span>
                }
            </div>
        </div>
    </div>

    <!-- Main Container Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <!-- Role Tabs Header -->
        <div class="card-header bg-white border-bottom pt-3 pb-0 px-3 px-md-4">
            <ul class="nav user-nav-tabs" role="tablist">
                <li class="nav-item">
                    <a asp-action="Index" 
                       asp-route-role="All" 
                       asp-route-search="@currentSearch" 
                       asp-route-status="@(currentStatus != "All" ? (currentStatus == "Active" ? "true" : "false") : null)"
                       class="nav-link @(currentRole == "All" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>All Users</span>
                        <span class="badge rounded-pill @(currentRole == "All" ? "bg-primary" : "bg-light text-dark border")" style="font-size: 0.75rem;">
                            @counts.TotalUsers
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" 
                       asp-route-role="Student" 
                       asp-route-search="@currentSearch" 
                       asp-route-status="@(currentStatus != "All" ? (currentStatus == "Active" ? "true" : "false") : null)"
                       class="nav-link @(currentRole == "Student" ? "active" : "")">
                        <i class="bi bi-mortarboard"></i>
                        <span>Students</span>
                        <span class="badge rounded-pill @(currentRole == "Student" ? "bg-success" : "bg-light text-dark border")" style="font-size: 0.75rem;">
                            @counts.TotalStudents
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" 
                       asp-route-role="Teacher" 
                       asp-route-search="@currentSearch" 
                       asp-route-status="@(currentStatus != "All" ? (currentStatus == "Active" ? "true" : "false") : null)"
                       class="nav-link @(currentRole == "Teacher" ? "active" : "")">
                        <i class="bi bi-person-badge"></i>
                        <span>Teachers</span>
                        <span class="badge rounded-pill @(currentRole == "Teacher" ? "bg-primary" : "bg-light text-dark border")" style="font-size: 0.75rem;">
                            @counts.TotalTeachers
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" 
                       asp-route-role="Assistance" 
                       asp-route-search="@currentSearch" 
                       asp-route-status="@(currentStatus != "All" ? (currentStatus == "Active" ? "true" : "false") : null)"
                       class="nav-link @(currentRole == "Assistance" ? "active" : "")">
                        <i class="bi bi-person-workspace"></i>
                        <span>Assistance</span>
                        <span class="badge rounded-pill @(currentRole == "Assistance" ? "bg-indigo text-white" : "bg-light text-dark border")" style="background-color: @(currentRole == "Assistance" ? "#4338ca" : ""); font-size: 0.75rem;">
                            @counts.TotalAssistants
                        </span>
                    </a>
                </li>
                <li class="nav-item">
                    <a asp-action="Index" 
                       asp-route-role="Admin" 
                       asp-route-search="@currentSearch" 
                       asp-route-status="@(currentStatus != "All" ? (currentStatus == "Active" ? "true" : "false") : null)"
                       class="nav-link @(currentRole == "Admin" ? "active" : "")">
                        <i class="bi bi-shield-lock"></i>
                        <span>Admins</span>
                        <span class="badge rounded-pill @(currentRole == "Admin" ? "bg-purple text-white" : "bg-light text-dark border")" style="background-color: @(currentRole == "Admin" ? "#6b21a8" : ""); font-size: 0.75rem;">
                            @counts.TotalAdmins
                        </span>
                    </a>
                </li>
            </ul>
        </div>

        <!-- Search & Filter Bar -->
        <div class="card-body p-3 p-md-4 border-bottom bg-light bg-opacity-25">
            <form method="get" asp-action="Index" class="row g-2 align-items-center">
                <!-- Keep selected role tab active when applying search or status filter -->
                <input type="hidden" name="role" value="@currentRole" />

                <div class="col-12 col-md-6 col-lg-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0 shadow-none" 
                               placeholder="Search by name, email address, or University ID..." 
                               value="@currentSearch" />
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                    <select name="status" class="form-select shadow-none">
                        <option value="" selected="@(currentStatus == "All")">All Account Statuses</option>
                        <option value="true" selected="@(currentStatus == "Active")">Active Accounts Only</option>
                        <option value="false" selected="@(currentStatus == "Inactive")">Inactive / Deactivated Only</option>
                    </select>
                </div>

                <div class="col-12 col-sm-6 col-md-3 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-dark w-100 fw-medium d-inline-flex align-items-center justify-content-center gap-1">
                        <i class="bi bi-funnel-fill"></i>
                        <span>Filter</span>
                    </button>
                    @if (hasActiveFilters)
                    {
                        <a asp-action="Index" asp-route-role="@currentRole" class="btn btn-outline-secondary" title="Reset search and filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    }
                </div>
            </form>

            @if (hasActiveFilters)
            {
                <div class="d-flex align-items-center gap-2 mt-2 pt-1 flex-wrap">
                    <span class="small text-muted">Active criteria:</span>
                    @if (currentRole != "All")
                    {
                        <span class="badge bg-white text-dark border px-2 py-1">Role: @currentRole</span>
                    }
                    @if (!string.IsNullOrEmpty(currentSearch))
                    {
                        <span class="badge bg-white text-dark border px-2 py-1">Query: "@currentSearch"</span>
                    }
                    @if (currentStatus != "All")
                    {
                        <span class="badge bg-white text-dark border px-2 py-1">Status: @currentStatus</span>
                    }
                    <a asp-action="Index" class="small text-danger text-decoration-none ms-1">
                        <i class="bi bi-x-circle me-1"></i>Clear all
                    </a>
                </div>
            }
        </div>

        <!-- User Table -->
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="min-width: 250px;">User</th>
                            <th style="min-width: 140px;">University ID</th>
                            <th style="min-width: 220px;">Contact / Email</th>
                            <th style="min-width: 120px;">Role</th>
                            <th style="min-width: 110px;">Status</th>
                            <th style="min-width: 130px;">Joined Date</th>
                            <th style="min-width: 150px;">Academic Details</th>
                            <th class="pe-4 text-end" style="width: 110px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-3">
                                            @if (!string.IsNullOrEmpty(user.Avatar))
                                            {
                                                <img src="@user.Avatar" class="rounded-circle border" width="40" height="40" alt="@user.FullName" />
                                            }
                                            else
                                            {
                                                var initial = string.IsNullOrWhiteSpace(user.FullName) ? "U" : user.FullName.Trim().Substring(0, 1).ToUpper();
                                                var bgClass = user.Role == "Admin" ? "bg-purple-subtle text-purple border-purple" : 
                                                              user.Role == "Teacher" ? "bg-primary-subtle text-primary border-primary-subtle" : 
                                                              user.Role == "Assistance" ? "border-indigo text-indigo" :
                                                              "bg-success-subtle text-success border-success-subtle";
                                                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold border @bgClass" 
                                                     style="width: 40px; height: 40px; font-size: 1.05rem; flex-shrink: 0; @(user.Role == "Assistance" ? "background-color: #e0e7ff; color: #4338ca; border-color: #c7d2fe !important;" : "")">
                                                    @initial
                                                </div>
                                            }
                                            <div>
                                                <a asp-action="Details" asp-route-id="@user.Id" class="fw-semibold text-dark text-decoration-none hover-primary d-block">
                                                    @user.FullName
                                                </a>
                                                <div class="small text-muted font-monospace" style="font-size: 0.75rem;">
                                                    ID: @user.Id.Substring(0, Math.Min(8, user.Id.Length))...
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.UniversityId))
                                        {
                                            <span class="font-monospace small bg-light px-2 py-1 rounded border text-dark fw-semibold">
                                                @user.UniversityId
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small fst-italic">Not Assigned</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="text-dark fw-medium">@user.Email</div>
                                    </td>
                                    <td>
                                        @if (user.Role == "Admin")
                                        {
                                            <span class="badge border px-2 py-1" style="background-color: #f3e8ff; color: #6b21a8; border-color: #d8b4fe !important;">
                                                <i class="bi bi-shield-lock-fill me-1"></i> Admin
                                            </span>
                                        }
                                        else if (user.Role == "Teacher")
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="bi bi-person-badge-fill me-1"></i> Teacher
                                            </span>
                                        }
                                        else if (user.Role == "Assistance")
                                        {
                                            <span class="badge border px-2 py-1" style="background-color: #e0e7ff; color: #4338ca; border-color: #c7d2fe !important;">
                                                <i class="bi bi-person-workspace me-1"></i> Assistance
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="bi bi-mortarboard-fill me-1"></i> Student
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 d-inline-flex align-items-center gap-1">
                                                <span class="dash-live-dot" style="width: 5px; height: 5px;"></span>
                                                <span>Active</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">
                                                <i class="bi bi-slash-circle me-1"></i> Deactivated
                                            </span>
                                        }
                                    </td>
                                    <td class="small text-secondary">
                                        @user.CreatedAt.ToString("MMM d, yyyy")
                                    </td>
                                    <td class="small">
                                        <span class="fw-bold text-dark">@user.RelevantCount</span>
                                        <span class="text-muted">@user.RelevantCountLabel</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="dropdown">
                                            <button class="btn btn-sm btn-light border shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Account actions">
                                                <i class="bi bi-three-dots-vertical"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                                <li>
                                                    <a asp-action="Details" asp-route-id="@user.Id" class="dropdown-item py-1">
                                                        <i class="bi bi-eye text-primary me-2"></i> View Profile
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="Edit" asp-route-id="@user.Id" class="dropdown-item py-1">
                                                        <i class="bi bi-pencil text-secondary me-2"></i> Edit Account
                                                    </a>
                                                </li>
                                                <li>
                                                    <a asp-action="ResetPassword" asp-route-id="@user.Id" class="dropdown-item py-1">
                                                        <i class="bi bi-key text-warning me-2"></i> Reset Password
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <form asp-action="ToggleStatus" asp-route-id="@user.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        @if (user.IsActive)
                                                        {
                                                            <button type="submit" class="dropdown-item py-1 text-danger" onclick="return confirm('Are you sure you want to deactivate the account for @user.FullName? Academic history will be strictly preserved.');">
                                                                <i class="bi bi-pause-circle me-2"></i> Deactivate Account
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="submit" class="dropdown-item py-1 text-success">
                                                                <i class="bi bi-play-circle me-2"></i> Activate Account
                                                            </button>
                                                        }
                                                    </form>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <div class="py-4">
                                        <i class="bi bi-people fs-1 text-secondary d-block mb-3 opacity-50"></i>
                                        <h5 class="fw-bold text-dark mb-1">No user accounts found</h5>
                                        <p class="text-muted small mb-3">No matching records found for the current tab and filter criteria.</p>
                                        @if (hasActiveFilters)
                                        {
                                            <a asp-action="Index" asp-route-role="All" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> Reset Filters
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="Create" class="btn btn-sm btn-primary">
                                                <i class="bi bi-person-plus-fill me-1"></i> Add First User
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer / Table Metadata -->
        <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="small text-muted">
                Showing <strong>@(Model?.Count() ?? 0)</strong> user account@(Model?.Count() == 1 ? "" : "s") in this view
            </span>
            <span class="small text-muted font-monospace">
                AUB Digital Academy Directory
            </span>
        </div>
    </div>
</div>

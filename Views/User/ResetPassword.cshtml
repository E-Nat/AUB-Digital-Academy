@model AUBDigitalAcademy.Models.ViewModels.ResetPasswordAdminViewModel
@{
    ViewData["Title"] = $"Reset Password - {Model.FullName}";
}

<div class="container-fluid px-0" style="max-width: 600px;">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark mb-1">Administrative Password Reset</h1>
            <p class="text-muted mb-0">Set a new password for @Model.FullName.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i>
            <span>Back to Users</span>
        </a>
    </div>

    <!-- Form Card -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="FullName" />
                <input type="hidden" asp-for="Email" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 rounded-3" role="alert"></div>

                <div class="bg-light p-3 rounded-3 border mb-4">
                    <div class="row">
                        <div class="col-6">
                            <span class="text-muted small d-block">Target Account</span>
                            <span class="fw-semibold text-dark">@Model.FullName</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Email Address</span>
                            <span class="fw-medium text-dark">@Model.Email</span>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label fw-semibold text-dark">New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-key"></i>
                        </span>
                        <input asp-for="NewPassword" class="form-control border-start-0 shadow-none" placeholder="Enter new password (min. 6 characters)" autofocus />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmNewPassword" class="form-label fw-semibold text-dark">Confirm New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted border-end-0">
                            <i class="bi bi-key-fill"></i>
                        </span>
                        <input asp-for="ConfirmNewPassword" class="form-control border-start-0 shadow-none" placeholder="Re-enter new password" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" class="text-danger small mt-1 d-block fw-medium"></span>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex align-items-center justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-light border px-4">Cancel</a>
                    <button type="submit" class="btn btn-warning px-4 fw-medium text-dark">
                        <i class="bi bi-check-circle-fill me-1"></i> Confirm Password Reset
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@{
    ViewData["Title"] = "Academic Schedule";
    ViewData["ActivePage"] = "Schedule";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-calendar3 text-primary me-2"></i>Academic Schedule
            </h2>
            <p class="text-muted text-sm mb-0">Master timetable, examination schedules, and term calendar.</p>
        </div>
        <a href="/Admin/Courses" class="btn btn-outline-primary rounded-pill px-3 py-2 text-sm">
            <i class="bi bi-journal-text me-1"></i> Course Management
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <div class="py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-calendar-event fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Academic Timetable & Schedule Engine</h5>
            <p class="text-muted text-sm mx-auto" style="max-width: 500px;">
                Weekly lecture timetables, exam room allocations, and semester milestone schedules are synced directly from active semester configurations.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/Admin/Courses" class="btn btn-primary rounded-pill px-4">View Courses</a>
                <a href="/Admin/Dashboard" class="btn btn-light border rounded-pill px-4">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>

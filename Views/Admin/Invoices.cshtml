@{
    ViewData["Title"] = "Billing Invoices";
    ViewData["ActivePage"] = "Invoices";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-receipt-cutoff text-primary me-2"></i>Billing & Invoices
            </h2>
            <p class="text-muted text-sm mb-0">Official academic billing statements, receipts, and outstanding tuition invoices.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <div class="py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-receipt fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Official Billing Statements & Invoicing</h5>
            <p class="text-muted text-sm mx-auto" style="max-width: 500px;">
                Generate, export, and dispatch certified PDF tuition statements and receipts with institutional digital seals.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/Admin/Payments" class="btn btn-primary rounded-pill px-4">Payments</a>
                <a href="/Admin/Dashboard" class="btn btn-light border rounded-pill px-4">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Reports & Analytics";
    ViewData["ActivePage"] = "Reports";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-bar-chart-fill text-primary me-2"></i>Institutional Reports & Analytics
            </h2>
            <p class="text-muted text-sm mb-0">Academic performance metrics, enrollment trends, and faculty productivity analytics.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <div class="py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-graph-up-arrow fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Executive Analytics & Accreditation Data</h5>
            <p class="text-muted text-sm mx-auto" style="max-width: 500px;">
                Comprehensive analytics for course pass rates, assessment completion velocity, student retention, and institutional accreditation reporting.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/Admin/Files" class="btn btn-outline-primary rounded-pill px-4">File Management</a>
                <a href="/Admin/Dashboard" class="btn btn-primary rounded-pill px-4">Executive Dashboard</a>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["Title"] = "Teacher Payroll";
    ViewData["ActivePage"] = "Payroll";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-cash-stack text-primary me-2"></i>Faculty & Teaching Assistant Payroll
            </h2>
            <p class="text-muted text-sm mb-0">Teaching honorariums, monthly faculty payroll, and assistance allowances.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <div class="py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-10 text-warning mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-wallet2 fs-2 text-warning"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Faculty Compensation & Payroll Distribution</h5>
            <p class="text-muted text-sm mx-auto" style="max-width: 500px;">
                Calculate faculty teaching hours, course credit multipliers, and teaching assistant stipends.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/Admin/Users?role=Teacher" class="btn btn-primary rounded-pill px-4">Faculty Roster</a>
                <a href="/Admin/Dashboard" class="btn btn-light border rounded-pill px-4">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>

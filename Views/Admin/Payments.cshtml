@{
    ViewData["Title"] = "Fee Payments";
    ViewData["ActivePage"] = "Payments";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-credit-card-2-front-fill text-primary me-2"></i>Fee Payments & Transactions
            </h2>
            <p class="text-muted text-sm mb-0">Tuition fees, transaction audit records, and payment gateway receipts.</p>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-5 bg-white text-center">
        <div class="py-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-cash-coin fs-2"></i>
            </div>
            <h5 class="fw-bold text-dark mb-2">Student Tuition & Payment Ledger</h5>
            <p class="text-muted text-sm mx-auto" style="max-width: 500px;">
                Automated student fee collection, bank slip verification, and payment ledger management. All financial data is encrypted and audited.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/Admin/Users?role=Student" class="btn btn-primary rounded-pill px-4">Student Roster</a>
                <a href="/Admin/Dashboard" class="btn btn-light border rounded-pill px-4">Return to Dashboard</a>
            </div>
        </div>
    </div>
</div>

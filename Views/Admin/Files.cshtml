@model AUBDigitalAcademy.Models.ViewModels.AdminFileManagementViewModel
@{
    ViewData["Title"] = "File Storage & Lifecycle Management";
    ViewData["ActivePage"] = "Files";
}

<div class="container-fluid py-4 px-4">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb text-xs mb-1">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard" class="text-decoration-none">Admin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">File Management</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark fs-3 mb-1">
                <i class="bi bi-folder2-open text-primary me-2"></i>File Storage & Lifecycle Management
            </h2>
            <p class="text-muted text-sm mb-0">Monitor stored assignment attachments, audit file retention, and manage soft deletion and recovery.</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 border-0 shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Storage Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-xs fw-semibold text-uppercase">Total Attachments</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">@Model.TotalFilesCount</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary" style="width: 48px; height: 48px;">
                        <i class="bi bi-files fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-xs fw-semibold text-uppercase">Active Files</span>
                        <h3 class="fw-bold text-success mt-1 mb-0">@Model.ActiveFilesCount</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-success bg-opacity-10 text-success" style="width: 48px; height: 48px;">
                        <i class="bi bi-file-earmark-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-xs fw-semibold text-uppercase">Soft-Deleted Files</span>
                        <h3 class="fw-bold text-danger mt-1 mb-0">@Model.SoftDeletedFilesCount</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger" style="width: 48px; height: 48px;">
                        <i class="bi bi-trash3 fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-xs fw-semibold text-uppercase">Total Storage Used</span>
                        <h3 class="fw-bold text-dark mt-1 mb-0">
                            @if (Model.TotalStorageBytes >= 1024 * 1024 * 1024)
                            {
                                @((Model.TotalStorageBytes / (1024.0 * 1024.0 * 1024.0)).ToString("F2")) <span class="fs-6 fw-normal text-muted">GB</span>
                            }
                            else if (Model.TotalStorageBytes >= 1024 * 1024)
                            {
                                @((Model.TotalStorageBytes / (1024.0 * 1024.0)).ToString("F2")) <span class="fs-6 fw-normal text-muted">MB</span>
                            }
                            else
                            {
                                @((Model.TotalStorageBytes / 1024.0).ToString("F1")) <span class="fs-6 fw-normal text-muted">KB</span>
                            }
                        </h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-info bg-opacity-10 text-info" style="width: 48px; height: 48px;">
                        <i class="bi bi-hdd-network fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Files Table Card -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-4 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h5 class="fw-bold text-dark mb-0">Stored Student Files & Audit Trail</h5>
                <small class="text-muted">Preserves all student work on physical storage with recovery capabilities.</small>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.Files == null || !Model.Files.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder-x fs-1 text-muted opacity-50 d-block mb-2"></i>
                    <h6 class="fw-semibold text-dark">No student files stored yet</h6>
                    <p class="text-muted text-sm mb-0">Uploaded assignment attachments will appear here.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-sm">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">File Name</th>
                                <th>Student</th>
                                <th>Course & Assignment</th>
                                <th>Size</th>
                                <th>Uploaded At</th>
                                <th>Status</th>
                                <th class="pe-4 text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var file in Model.Files)
                            {
                                <tr class="@(file.IsDeleted ? "bg-light text-muted opacity-75" : "")">
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center gap-2">
                                            @if (file.OriginalFileName.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-file-earmark-pdf-fill text-danger fs-4"></i>
                                            }
                                            else if (file.OriginalFileName.EndsWith(".zip", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-file-earmark-zip-fill text-warning fs-4"></i>
                                            }
                                            else if (file.OriginalFileName.EndsWith(".docx", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <i class="bi bi-file-earmark-word-fill text-primary fs-4"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-earmark-fill text-secondary fs-4"></i>
                                            }
                                            <div>
                                                <span class="fw-semibold text-dark text-break">@file.OriginalFileName</span>
                                                <div class="text-xs text-muted">ID: #@file.Id · Submission #@file.SubmissionId</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="fw-medium text-dark">@file.StudentName</div>
                                        <div class="text-xs text-muted">@file.StudentEmail</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary text-xs">@file.CourseCode</span>
                                        <div class="text-xs fw-medium text-dark mt-1">@file.AssignmentTitle</div>
                                    </td>
                                    <td>
                                        <span class="text-xs">
                                            @if (file.FileSizeBytes >= 1024 * 1024)
                                            {
                                                @((file.FileSizeBytes / (1024.0 * 1024.0)).ToString("F2")) @:MB
                                            }
                                            else
                                            {
                                                @((file.FileSizeBytes / 1024.0).ToString("F1")) @:KB
                                            }
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-xs text-muted">@file.UploadedAt.ToString("MMM dd, yyyy · HH:mm")</span>
                                    </td>
                                    <td>
                                        @if (file.IsDeleted)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-2 py-1 text-xs" title="Soft-deleted on @(file.DeletedAt?.ToString("g") ?? "N/A") by @(file.DeletedByName ?? "Admin")">
                                                <i class="bi bi-trash3 me-1"></i> Soft-Deleted
                                            </span>
                                            @if (!string.IsNullOrEmpty(file.DeletionReason))
                                            {
                                                <div class="text-xs text-danger mt-1 text-truncate" style="max-width: 150px;" title="@file.DeletionReason">
                                                    Reason: @file.DeletionReason
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 text-xs">
                                                <i class="bi bi-check-circle me-1"></i> Active
                                            </span>
                                            @if (file.RestoredAt.HasValue)
                                            {
                                                <div class="text-xs text-info mt-1">
                                                    Restored @file.RestoredAt.Value.ToString("MMM dd")
                                                </div>
                                            }
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex align-items-center gap-1">
                                            <a href="/Admin/Files/Download/@file.Id" class="btn btn-sm btn-outline-primary rounded-pill px-2 py-1 text-xs" title="Download File">
                                                <i class="bi bi-download"></i>
                                            </a>
                                            @if (!file.IsDeleted)
                                            {
                                                <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 text-xs"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteFileModal_@file.Id"
                                                        title="Soft Delete File">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                                <!-- Soft Delete Modal -->
                                                <div class="modal fade text-start" id="deleteFileModal_@file.Id" tabindex="-1" aria-hidden="true">
                                                    <div class="modal-dialog modal-dialog-centered">
                                                        <div class="modal-content rounded-4 border-0 shadow">
                                                            <form asp-controller="Admin" asp-action="SoftDeleteFile" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@file.Id" />
                                                                <div class="modal-header border-bottom">
                                                                    <div class="d-flex align-items-center gap-2 text-danger">
                                                                        <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                                                                        <h6 class="modal-title fw-bold mb-0">Soft Delete Attachment</h6>
                                                                    </div>
                                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                </div>
                                                                <div class="modal-body p-4">
                                                                    <p class="text-dark mb-2">Are you sure you want to soft-delete:</p>
                                                                    <div class="p-3 bg-light rounded-3 border mb-3">
                                                                        <strong class="text-dark">@file.OriginalFileName</strong>
                                                                        <div class="text-xs text-muted mt-1">Uploaded by @file.StudentName on @file.UploadedAt.ToString("MMM dd, yyyy")</div>
                                                                    </div>
                                                                    <div class="mb-3">
                                                                        <label class="form-label small fw-bold text-dark">Reason for Deletion <span class="text-muted fw-normal">(Optional)</span></label>
                                                                        <input type="text" name="reason" class="form-control" placeholder="e.g. Inappropriate content, Student requested removal, etc." maxlength="500" />
                                                                    </div>
                                                                    <div class="alert alert-info small mb-0 d-flex align-items-center gap-2">
                                                                        <i class="bi bi-shield-check fs-5"></i>
                                                                        <div>Physical file will be safely preserved on disk and can be restored at any time.</div>
                                                                    </div>
                                                                </div>
                                                                <div class="modal-footer border-top bg-light">
                                                                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                                                                    <button type="submit" class="btn btn-danger d-inline-flex align-items-center gap-2">
                                                                        <i class="bi bi-trash"></i>
                                                                        <span>Confirm Soft Delete</span>
                                                                    </button>
                                                                </div>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin" asp-action="RestoreFile" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@file.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 text-xs" title="Restore File">
                                                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
